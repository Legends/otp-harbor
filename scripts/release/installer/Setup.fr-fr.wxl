  <String Id="HelpHeader" Value="Commandes d’installation" />
  <String Id="HelpText" Value="/install — installer l’application&#10;/repair — réparer les fichiers&#10;/uninstall — supprimer l’application&#10;/layout — enregistrer un paquet hors ligne&#10;/quiet — exécuter sans dialogues&#10;/norestart — empêcher le redémarrage automatique&#10;/log fichier — choisir le journal" />
