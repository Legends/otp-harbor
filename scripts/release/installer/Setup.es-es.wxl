  <String Id="HelpHeader" Value="Comandos de instalación" />
  <String Id="HelpText" Value="/install — instalar la aplicación&#10;/repair — reparar los archivos&#10;/uninstall — eliminar la aplicación&#10;/layout — guardar un paquete sin conexión&#10;/quiet — ejecutar sin diálogos&#10;/norestart — impedir el reinicio automático&#10;/log archivo — elegir el registro" />
