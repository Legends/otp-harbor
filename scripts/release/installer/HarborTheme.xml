<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <!-- ThmUtil colors use Windows COLORREF (BBGGRR). -->
  <Font Id="0" Height="-15" Foreground="F6EDE8" Background="351E10">Segoe UI</Font>
  <Font Id="1" Height="-30" Weight="600" Foreground="FFF8F5" Background="351E10">Segoe UI</Font>
  <Font Id="2" Height="-14" Foreground="D0B8A8" Background="351E10">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="600" Foreground="F0D739" Background="351E10">Segoe UI</Font>
  <Font Id="4" Height="-15" Weight="600" Foreground="351E10" Background="F0D739">Segoe UI</Font>
  <Font Id="5" Height="-22" Weight="600" Foreground="FFF8F5" Background="351E10">Segoe UI</Font>
  <Window Width="760" Height="520" HexStyle="90080000" FontId="0" Caption="#(loc.Caption)">
    <ImageControl X="32" Y="40" Width="80" Height="80" ImageFile="logo.png" Visible="yes" />
    <Label X="32" Y="142" Width="200" Height="34" FontId="5" Visible="yes">OTP Harbor</Label>
    <Label X="32" Y="186" Width="176" Height="66" FontId="2" Visible="yes" DisablePrefix="yes">#(loc.Tagline)</Label>
    <Label X="32" Y="346" Width="176" Height="70" FontId="3" Visible="yes" DisablePrefix="yes">#(loc.Principles)</Label>
    <Label X="32" Y="468" Width="190" Height="20" FontId="2" Visible="yes">[WixBundleVersion]</Label>
    <Label X="264" Y="40" Width="460" Height="20" FontId="3" Visible="yes">#(loc.Kicker)</Label>
    <Page Name="Loading">
      <Label X="264" Y="94" Width="460" Height="80" FontId="1">#(loc.Loading)</Label>
    </Page>
    <Page Name="Install">
      <Label X="264" Y="94" Width="460" Height="82" FontId="1">#(loc.InstallHeader)</Label>
      <Label X="264" Y="190" Width="456" Height="100" FontId="0" DisablePrefix="yes">#(loc.InstallMessage)</Label>
      <Button X="264" Y="300" Width="220" Height="34" FontId="0" TabStop="yes">
        <Text>#(loc.ReadLicense)</Text><ChangePageAction Page="License" />
      </Button>
      <Checkbox Name="EulaAcceptCheckbox" X="264" Y="356" Width="28" Height="28" FontId="0" TabStop="yes" />
      <Label X="304" Y="354" Width="420" Height="52" FontId="0">#(loc.AcceptLicense)</Label>
      <Button Name="OptionsButton" X="264" Y="456" Width="134" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Options)</Text><ChangePageAction Page="Options" />
      </Button>
      <Button Name="InstallButton" X="412" Y="456" Width="162" Height="36" FontId="4" TabStop="yes">#(loc.Install)</Button>
      <Button X="588" Y="456" Width="136" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Close)</Text><CloseWindowAction />
      </Button>
    </Page>
    <Page Name="License">
      <Label X="264" Y="94" Width="460" Height="70" FontId="1">#(loc.LicenseHeader)</Label>
      <Richedit Name="EulaRichedit" X="264" Y="182" Width="460" Height="246" FontId="0" TabStop="yes" />
      <Button X="558" Y="456" Width="166" Height="36" FontId="4" TabStop="yes">
        <Text>#(loc.Back)</Text><ChangePageAction Page="Install" />
      </Button>
    </Page>
    <Page Name="Options">
      <Label X="264" Y="94" Width="460" Height="80" FontId="1">#(loc.OptionsHeader)</Label>
      <Label X="264" Y="198" Width="460" Height="42" FontId="0">#(loc.Location)</Label>
      <Editbox Name="InstallFolder" X="264" Y="250" Width="460" Height="30" FontId="0" TabStop="yes" FileSystemAutoComplete="yes" />
      <Button X="558" Y="296" Width="166" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Browse)</Text><BrowseDirectoryAction VariableName="InstallFolder" />
      </Button>
      <Button X="558" Y="456" Width="166" Height="36" FontId="4" TabStop="yes">
        <Text>#(loc.Back)</Text><ChangePageAction Page="Install" />
      </Button>
    </Page>
    <Page Name="Progress">
      <Label X="264" Y="94" Width="460" Height="90" FontId="1">#(loc.ProgressHeader)</Label>
      <Label X="264" Y="214" Width="460" Height="64" FontId="0">#(loc.ProgressMessage)</Label>
      <Label Name="OverallProgressPackageText" X="264" Y="314" Width="460" Height="28" FontId="2" />
      <Progressbar Name="OverallCalculatedProgressbar" X="264" Y="354" Width="460" Height="12" />
      <Button Name="ProgressCancelButton" X="558" Y="456" Width="166" Height="36" FontId="0" TabStop="yes">#(loc.Cancel)</Button>
    </Page>
    <Page Name="Modify">
      <Label X="264" Y="94" Width="460" Height="82" FontId="1">#(loc.ModifyHeader)</Label>
      <Label X="264" Y="198" Width="460" Height="110" FontId="0">#(loc.ModifyMessage)</Label>
      <Button Name="RepairButton" X="264" Y="356" Width="220" Height="40" FontId="4" TabStop="yes">#(loc.Repair)</Button>
      <Button Name="UninstallButton" X="504" Y="356" Width="220" Height="40" FontId="0" TabStop="yes">#(loc.Uninstall)</Button>
      <Button X="558" Y="456" Width="166" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Close)</Text><CloseWindowAction />
      </Button>
    </Page>
    <Page Name="Success">
      <Label X="264" Y="94" Width="460" Height="82" FontId="1">#(loc.SuccessHeader)</Label>
      <Label X="264" Y="198" Width="460" Height="95" FontId="0">#(loc.SuccessMessage)</Label>
      <Label X="264" Y="320" Width="460" Height="86" FontId="0" VisibleCondition="WixStdBARestartRequired">#(loc.RestartMessage)</Label>
      <Button Name="LaunchButton" X="264" Y="456" Width="260" Height="36" FontId="4" TabStop="yes" HideWhenDisabled="yes" VisibleCondition="WixBundleAction &gt; 4 AND NOT WixStdBARestartRequired">#(loc.Launch)</Button>
      <Button Name="SuccessRestartButton" X="264" Y="456" Width="260" Height="36" FontId="4" TabStop="yes" HideWhenDisabled="yes">#(loc.Restart)</Button>
      <Button X="558" Y="456" Width="166" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Close)</Text><CloseWindowAction />
      </Button>
    </Page>
    <Page Name="Failure">
      <Label X="264" Y="94" Width="460" Height="82" FontId="1">#(loc.FailureHeader)</Label>
      <Hypertext Name="FailureLogFileLink" X="264" Y="198" Width="460" Height="100" FontId="0" TabStop="yes">#(loc.FailureMessage)</Hypertext>
      <Label X="264" Y="320" Width="460" Height="90" FontId="0" VisibleCondition="WixStdBARestartRequired">#(loc.RestartMessage)</Label>
      <Button Name="FailureRestartButton" X="264" Y="456" Width="260" Height="36" FontId="4" TabStop="yes" HideWhenDisabled="yes">#(loc.Restart)</Button>
      <Button X="558" Y="456" Width="166" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Close)</Text><CloseWindowAction />
      </Button>
    </Page>
    <Page Name="Help">
      <Label X="264" Y="94" Width="460" Height="70" FontId="1">#(loc.HelpHeader)</Label>
      <Label X="264" Y="190" Width="460" Height="240" FontId="0">#(loc.HelpText)</Label>
      <Button X="558" Y="456" Width="166" Height="36" FontId="0" TabStop="yes">
        <Text>#(loc.Close)</Text><CloseWindowAction />
      </Button>
    </Page>
  </Window>
</Theme>
