<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <RootNamespace>TOTP.Avalonia.Android</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The production ID is permanent and reserved for GitHub/Play releases. -->
    <AndroidProductionApplicationId>io.github.legends.otpharbor</AndroidProductionApplicationId>
    <ApplicationId>$(AndroidProductionApplicationId)</ApplicationId>
    <ApplicationId Condition="'$(Configuration)' == 'Debug'">$(AndroidProductionApplicationId).debug</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-dev</ApplicationDisplayVersion>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\TOTP.Core\totp-sign-key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(EnableMarketingCapture)' == 'true'">
    <DefineConstants>$(DefineConstants);OTP_HARBOR_MARKETING_CAPTURE</DefineConstants>
  </PropertyGroup>

  <Target Name="RejectReleaseMarketingCapture" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)' == 'Release' and '$(EnableMarketingCapture)' == 'true'">
    <Error Text="EnableMarketingCapture is restricted to the isolated Debug package." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="..\TOTP.UI.Avalonia.Desktop\Assets\Icons\app-1024.png">
      <Link>Resources\drawable\app_icon.png</Link>
      <LogicalName>drawable\app_icon.png</LogicalName>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TOTP.Infrastructure\TOTP.Infrastructure.csproj" />
    <ProjectReference Include="..\TOTP.Platform.Android\TOTP.Platform.Android.csproj" />
    <ProjectReference Include="..\TOTP.UI.Avalonia.Mobile\TOTP.UI.Avalonia.Mobile.csproj" />
  </ItemGroup>

</Project>
