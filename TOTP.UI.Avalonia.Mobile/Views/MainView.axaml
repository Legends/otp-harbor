<UserControl
    x:Class="TOTP.Avalonia.Mobile.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Shared.Controls"
    xmlns:input="using:Avalonia.Input.GestureRecognizers"
    xmlns:vm="using:TOTP.Avalonia.Mobile.Presentation"
    x:Name="Root"
    x:DataType="vm:MobileShellViewModel"
    Background="{DynamicResource BrushWindowBackground}">
    <UserControl.Styles>
        <Style Selector="Border#MobileAppHeader">
            <Setter Property="Padding" Value="20,14" />
        </Style>
        <Style Selector="Grid#MobileMainContent">
            <Setter Property="Margin" Value="20" />
        </Style>
        <Style Selector="Grid#AccountToolbar">
            <Setter Property="ColumnSpacing" Value="4" />
        </Style>
        <Style Selector="TextBlock.account-toolbar-title">
            <Setter Property="FontSize" Value="26" />
        </Style>
        <ContainerQuery Name="MobileShell" Query="max-width:380">
            <Style Selector="Border#MobileAppHeader">
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style Selector="Grid#MobileMainContent">
                <Setter Property="Margin" Value="12" />
            </Style>
            <Style Selector="Grid#AccountToolbar">
                <Setter Property="ColumnSpacing" Value="2" />
            </Style>
            <Style Selector="TextBlock.account-toolbar-title">
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style Selector="Button.account-toolbar-action">
                <Setter Property="Width" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Padding" Value="6" />
            </Style>
        </ContainerQuery>
        <Style Selector="controls|RevealableSecretInput.unlock-method-attention /template/ TextBox#PART_Input">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Button.settings-category">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.danger">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.danger:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.settings-category">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.settings-category:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
        </Style>
        <Style Selector="StackPanel.settings-root Button.wide.settings-category:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
        </Style>
        <Style Selector="Button.settings-back-to-top">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="Button.settings-back-to-top:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}" />
        </Style>
        <Style Selector="Button.settings-back-to-top:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentPressed}" />
        </Style>
        <Style Selector="Expander.mobile-faq-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.mobile-faq-section /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.mobile-faq-section /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.mobile-faq-section /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.mobile-faq-subsection">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.mobile-faq-subsection /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.mobile-faq-subsection /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.mobile-faq-subsection /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <Grid
        Container.Name="MobileShell"
        Container.Sizing="Width"
        RowDefinitions="Auto,*,Auto">
        <Border
            x:Name="MobileAppHeader"
            Grid.Row="0"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image
                    x:Name="MobileAppLogo"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Source="avares://TOTP.UI.Avalonia.Shared/Assets/Biometric/otp-harbor-mark.png"
                    Stretch="Uniform" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource BrushTextPrimary}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding AppTitle}" />
                <Button
                    Grid.Column="2"
                    automation:AutomationProperties.Name="{Binding LockText}"
                    Classes="icon-action"
                    Command="{Binding LockCommand}"
                    IsVisible="{Binding IsManualLockVisible}"
                    ToolTip.Tip="{Binding LockText}">
                    <controls:SymbolIcon IconSize="24" Kind="Lock" />
                </Button>
            </Grid>
        </Border>

        <Border
            x:Name="MobileLockScreenArtwork"
            Grid.Row="1"
            Background="{DynamicResource BrushBiometricLockScreenArtwork}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsUnlockVisible}" />
        <Border
            Grid.Row="1"
            Background="{DynamicResource BrushBiometricLockScreenOverlay}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsUnlockVisible}" />

        <ScrollViewer
            x:Name="MainScrollViewer"
            Grid.Row="1"
            ScrollChanged="MainScrollViewerChanged"
            Classes.account-list="{Binding IsAccountListVisible}">
            <ScrollViewer.Styles>
                <Style Selector="ScrollViewer.account-list">
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                </Style>
            </ScrollViewer.Styles>
            <Grid
                x:Name="MobileMainContent"
                MaxWidth="720"
                HorizontalAlignment="Stretch">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsStartingVisible}"
                    Spacing="18"
                    VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding StartingText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding InitializeCommand}"
                        Content="{Binding RetryText}"
                        IsVisible="{Binding CanRetry}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsSetupVisible}"
                    Spacing="14">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding SetupTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding SetupDescription}"
                        TextWrapping="Wrap" />
                    <controls:RevealableSecretInput
                        AccessibleName="{Binding MasterPasswordText}"
                        PlaceholderText="{Binding MasterPasswordText}"
                        RevealButtonAccessibleName="{Binding RevealPasswordText}"
                        RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                        Text="{Binding SetupPassword, Mode=TwoWay}" />
                    <controls:RevealableSecretInput
                        AccessibleName="{Binding ConfirmPasswordText}"
                        PlaceholderText="{Binding ConfirmPasswordText}"
                        RevealButtonAccessibleName="{Binding RevealPasswordText}"
                        RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                        Text="{Binding SetupConfirmation, Mode=TwoWay}" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding ConfigureCommand}"
                        Content="{Binding CreateVaultText}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsUnlockVisible}"
                    Spacing="14">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding UnlockTitle}" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding UnlockDescription}"
                        TextWrapping="Wrap" />
                    <controls:RevealableSecretInput
                        AccessibleName="{Binding MasterPasswordText}"
                        PlaceholderText="{Binding MasterPasswordText}"
                        RevealButtonAccessibleName="{Binding RevealPasswordText}"
                        RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                        Text="{Binding UnlockPassword, Mode=TwoWay}" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding UnlockCommand}"
                        Content="{Binding UnlockText}" />
                    <Button
                        Classes="wide secondary"
                        Command="{Binding BiometricUnlockCommand}"
                        MinHeight="68"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding IsDeviceCredentialUnlockVisible}"
                        ToolTip.Tip="{Binding UnlockWithDevicePinText}">
                        <TextBlock
                            Text="{Binding DeviceCredentialUnlockButtonText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>

                <Grid IsVisible="{Binding IsAccountsVisible}">
                    <Grid
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsAccountListVisible}"
                        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                        <Grid
                            x:Name="AccountToolbar"
                            Grid.Row="0"
                            Margin="0,0,0,14"
                            ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="account-toolbar-title"
                                FontWeight="SemiBold"
                                Text="{Binding AccountsTitle}" />
                            <Button
                                Grid.Column="1"
                                automation:AutomationProperties.Name="{Binding ScanQrText}"
                                Classes="icon-action account-toolbar-action"
                                Command="{Binding ScanQrCommand}"
                                ToolTip.Tip="{Binding ScanQrText}">
                                <controls:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,2,0,0"
                                    IconSize="24"
                                    Kind="Camera" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                automation:AutomationProperties.Name="{Binding CreateGroupText}"
                                Classes="icon-action account-toolbar-action"
                                Command="{Binding BeginAddGroupCommand}"
                                ToolTip.Tip="{Binding CreateGroupText}">
                                <controls:SymbolIcon IconSize="24" Kind="FolderAdd" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                automation:AutomationProperties.Name="{Binding AddAccountText}"
                                Classes="icon-action account-toolbar-action"
                                Command="{Binding BeginAddCommand}"
                                ToolTip.Tip="{Binding AddAccountText}">
                                <controls:SymbolIcon IconSize="24" Kind="Add" />
                            </Button>
                            <Button
                                Grid.Column="4"
                                automation:AutomationProperties.Name="{Binding SettingsText}"
                                Classes="icon-action account-toolbar-action"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip.Tip="{Binding SettingsText}">
                                <controls:SymbolIcon IconSize="24" Kind="Settings" />
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto">
                            <TextBox
                                x:Name="AccountSearchBox"
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Padding="12,8,48,8"
                                automation:AutomationProperties.Name="{Binding SearchAccountsText}"
                                PlaceholderText="{Binding SearchAccountsText}"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                MinHeight="44"
                                Margin="0,0,4,0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                automation:AutomationProperties.Name="{Binding ClearSearchText}"
                                Classes="link"
                                Click="RefocusAccountSearchAfterClear"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchText}"
                                ToolTip.Tip="{Binding ClearSearchText}">
                                <controls:SymbolIcon IconSize="18" Kind="Close" />
                            </Button>
                        </Grid>

                        <Grid
                            x:Name="AccountGroupsStrip"
                            Grid.Row="2"
                            MinHeight="64"
                            Margin="0,6,0,6"
                            ColumnDefinitions="*"
                            IsVisible="{Binding HasAccountNavigationCards}"
                            VerticalAlignment="Center">
                            <ScrollViewer
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalAlignment="Center"
                                VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="160"
                                        Height="52"
                                        Margin="2"
                                        Background="{DynamicResource BrushFavoriteFilterBackground}"
                                        Classes="favorite-group-card group-card"
                                        Classes.selected="{Binding IsFavoritesFilterSelected}"
                                        CornerRadius="7"
                                        IsVisible="{Binding HasFavoriteAccounts}">
                                        <ToggleButton
                                            automation:AutomationProperties.Name="{Binding FavoritesText}"
                                            Classes="favorites-filter"
                                            Command="{Binding ToggleFavoritesFilterCommand}"
                                            IsChecked="{Binding IsFavoritesFilterSelected, Mode=OneWay}"
                                            ToolTip.Tip="{Binding FavoritesText}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                                <controls:SymbolIcon
                                                    Grid.Column="0"
                                                    Foreground="{DynamicResource BrushFavoriteFilterIcon}"
                                                    IconSize="20"
                                                    Kind="Favorite" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding FavoritesText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{Binding FavoriteCount}" />
                                            </Grid>
                                        </ToggleButton>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MobileAccountGroupItem">
                                                <Border
                                                    Width="180"
                                                    Height="52"
                                                    Margin="2"
                                                    Background="{Binding Background}"
                                                    Classes="group-card"
                                                    Classes.selected="{Binding IsSelected}"
                                                    CornerRadius="7">
                                                    <Grid ColumnDefinitions="*,40">
                                                        <Button
                                                            Grid.Column="0"
                                                            automation:AutomationProperties.Name="{Binding Name}"
                                                            Classes="account-group group-card-hit-target"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip.Tip="{Binding Name}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                                                <controls:SymbolIcon
                                                                    Grid.Column="0"
                                                                    Foreground="{Binding Foreground}"
                                                                    IconSize="20"
                                                                    Kind="Folder" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    Text="{Binding AccountCount}" />
                                                            </Grid>
                                                        </Button>
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="40"
                                                            MinWidth="40"
                                                            Margin="0"
                                                            Padding="8"
                                                            automation:AutomationProperties.Name="{Binding DataContext.EditGroupText, ElementName=Root}"
                                                            Classes="icon-action"
                                                            Command="{Binding EditCommand}"
                                                            ToolTip.Tip="{Binding DataContext.EditGroupText, ElementName=Root}">
                                                            <controls:SymbolIcon IconSize="16" Kind="Edit" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ContentControl
                            x:Name="NativeAccountGroupsPresenter"
                            Grid.Row="2"
                            MinHeight="64"
                            Margin="0,6,0,6"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsNativeAccountGroupsVisible}" />

                        <Border
                            Grid.Row="3"
                            Margin="0,0,0,14"
                            Background="{DynamicResource BrushSurfaceAlternate}"
                            CornerRadius="8"
                            IsVisible="{Binding IsQrConflictVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding QrConflictTitle}" />
                                <TextBlock
                                    Text="{Binding QrConflictPrompt}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide primary"
                                    Command="{Binding UpdateQrConflictCommand}"
                                    Content="{Binding UpdateExistingText}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding KeepBothQrConflictCommand}"
                                    Content="{Binding KeepBothText}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding CancelQrConflictCommand}"
                                    Content="{Binding CancelText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="FirstAccountOnboardingCard"
                            Grid.Row="4"
                            Padding="18"
                            Background="{DynamicResource BrushSurfaceAlternate}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            IsVisible="{Binding HasNoAccounts}"
                            VerticalAlignment="Center">
                            <StackPanel Spacing="12">
                                <controls:SymbolIcon
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource BrushAccent}"
                                    IconSize="32"
                                    Kind="Add" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SetUpFirstAccountText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding NoAccountsText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="AddFirstAccountButton"
                                    Classes="wide primary"
                                    Command="{Binding BeginAddCommand}"
                                    Content="{Binding AddAccountText}" />
                                <Button
                                    x:Name="ScanFirstAccountButton"
                                    Classes="wide secondary"
                                    Command="{Binding ScanQrCommand}"
                                    Content="{Binding ScanQrText}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource BrushTextSecondary}"
                            IsVisible="{Binding HasNoSearchResults}"
                            Text="{Binding NoSearchResultsText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <ListBox
                            x:Name="AccountList"
                            Grid.Row="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Classes="accounts mobile-accounts"
                            IsHitTestVisible="{Binding !IsDeleteConfirmationVisible}"
                            IsVisible="{Binding HasAccounts}"
                            ItemsSource="{Binding Accounts}"
                            Margin="-14,0"
                            SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.IsScrollChainingEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel CacheLength="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MobileAccountItem">
                                    <Border
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="{DynamicResource RadiusMedium}"
                                        Margin="2,4">
                                        <Grid MinHeight="76">
                                            <Grid
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BrushAccent}"
                                                ColumnDefinitions="*,*">
                                                <Button
                                                    Grid.Column="0"
                                                    automation:AutomationProperties.Name="{Binding DataContext.ShowQrText, ElementName=Root}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="ShowQrForAccount"
                                                    CornerRadius="0"
                                                    ToolTip.Tip="{Binding DataContext.ShowQrText, ElementName=Root}">
                                                    <controls:SymbolIcon
                                                        Foreground="{DynamicResource BrushOnAccent}"
                                                        IconSize="23"
                                                        Kind="QrCode" />
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    automation:AutomationProperties.Name="{Binding DataContext.EditAccountText, ElementName=Root}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="EditAccount"
                                                    CornerRadius="0"
                                                    ToolTip.Tip="{Binding DataContext.EditAccountText, ElementName=Root}">
                                                    <controls:SymbolIcon
                                                        Foreground="{DynamicResource BrushOnAccent}"
                                                        IconSize="23"
                                                        Kind="Edit" />
                                                </Button>
                                            </Grid>
                                            <Border
                                                Width="60"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource BrushDanger}"
                                                IsHitTestVisible="False">
                                                <controls:SymbolIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushOnDanger}"
                                                    IconSize="24"
                                                    Kind="Delete" />
                                            </Border>
                                            <Border
                                                Background="{DynamicResource BrushAccountItemBackground}"
                                                Padding="10,10"
                                                SwipeGesture="TrackAccountSwipe"
                                                SwipeGestureEnded="CompleteAccountSwipe"
                                                Tapped="CopyAccountCode"
                                                ToolTip.Tip="{Binding DataContext.CopyCodeText, ElementName=Root}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform />
                                                </Border.RenderTransform>
                                                <Border.GestureRecognizers>
                                                    <input:SwipeGestureRecognizer
                                                        CanHorizontallySwipe="True"
                                                        IsMouseEnabled="True"
                                                        Threshold="24" />
                                                </Border.GestureRecognizers>
                                                <Grid
                                                    ColumnDefinitions="Auto,Auto,*,Auto"
                                                    RowDefinitions="*,Auto"
                                                    ColumnSpacing="6">
                                                    <controls:BrandTile
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        IsVisible="{Binding ShowIssuerLogo}"
                                                            IconData="{Binding Brand.IconData}"
                                                            IconImage="{Binding Brand.IconImage}"
                                                            IconTransform="{Binding Brand.IconTransform}"
                                                            IsCustomIcon="{Binding Brand.IsCustomIcon}"
                                                        Initials="{Binding Brand.Initials}"
                                                        TileBackground="{Binding Brand.BackgroundBrush}" />
                                                    <Button
                                                        x:Name="AccountFavoriteButton"
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Width="48"
                                                        MinWidth="48"
                                                        MinHeight="48"
                                                        Padding="8"
                                                        VerticalAlignment="Center"
                                                        automation:AutomationProperties.Name="{Binding FavoriteActionText}"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        Click="ToggleAccountFavorite"
                                                        ToolTip.Tip="{Binding FavoriteActionText}">
                                                        <Grid>
                                                            <controls:SymbolIcon
                                                                Foreground="{DynamicResource BrushAccent}"
                                                                IconSize="23"
                                                                IsVisible="{Binding IsFavorite}"
                                                                Kind="Favorite" />
                                                            <controls:SymbolIcon
                                                                Foreground="{DynamicResource BrushTextSecondary}"
                                                                IconSize="23"
                                                                IsVisible="{Binding !IsFavorite}"
                                                                Kind="Favorite"
                                                                Opacity="0.55" />
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="3">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Issuer}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrushAccountName}"
                                                            IsVisible="{Binding HasAccountName}"
                                                            Text="{Binding AccountName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrushTextSecondary}"
                                                            IsVisible="{Binding HasCustomPeriod}"
                                                            Text="{Binding CustomPeriodLabel}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        x:Name="AccountCodeDisplay"
                                                        Grid.Row="0"
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        automation:AutomationProperties.Name="{Binding DataContext.CopyCodeText, ElementName=Root}"
                                                        Spacing="1"
                                                        ToolTip.Tip="{Binding DataContext.CopyCodeText, ElementName=Root}">
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{DynamicResource BrushTextSelection}"
                                                            FontFamily="Consolas"
                                                            FontSize="25"
                                                            FontWeight="Bold"
                                                            Text="{Binding DisplayCode}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{DynamicResource BrushAccent}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            MinHeight="16"
                                                            Text="{Binding CopyConfirmation}"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        Grid.ColumnSpan="2"
                                                        Classes="account-countdown"
                                                        Classes.expiring="{Binding IsExpiring}"
                                                        IsIndeterminate="{Binding IsCodeLoading}"
                                                        Margin="0,7,0,0"
                                                        Maximum="{Binding PeriodSeconds}"
                                                        Value="{Binding RemainingSeconds}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ContentControl
                            x:Name="NativeAccountListPresenter"
                            Grid.Row="4"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsNativeAccountListVisible}" />

                        <Border
                            Grid.Row="5"
                            Margin="0,14,0,0"
                            Classes="card"
                            IsVisible="{Binding HasQrImage}"
                            Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedAccount.DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Background="{DynamicResource BrushQrBackground}"
                                    CornerRadius="8"
                                    IsVisible="{Binding HasQrImage}"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <Image
                                            Width="240"
                                            Height="240"
                                            HorizontalAlignment="Center"
                                            Source="{Binding QrImage}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushQrForeground}"
                                            Text="{Binding QrPrivacyNoticeText}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Classes="wide secondary"
                                            Command="{Binding DismissQrCommand}"
                                            Content="{Binding DismissQrText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        Classes="settings-root"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsSettingsVisible}"
                        Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button
                                Grid.Column="0"
                                automation:AutomationProperties.Name="{Binding BackToSettingsText}"
                                Classes="icon-action"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowSettingsCategoriesCommand}"
                                IsVisible="{Binding IsSettingsCategoryDetailVisible}"
                                ToolTip.Tip="{Binding BackToSettingsText}">
                                <controls:SymbolIcon IconSize="22" Kind="ArrowLeft" />
                            </Button>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding SettingsCategoryTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="2"
                                automation:AutomationProperties.Name="{Binding CloseSettingsText}"
                                Classes="icon-action"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowAccountsCommand}"
                                IsVisible="{Binding IsSettingsCategoryListVisible}"
                                ToolTip.Tip="{Binding CloseSettingsText}">
                                <controls:SymbolIcon IconSize="22" Kind="Close" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                automation:AutomationProperties.Name="{Binding BackToSettingsText}"
                                Classes="icon-action"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowSettingsCategoriesCommand}"
                                IsVisible="{Binding IsSettingsCategoryDetailVisible}"
                                ToolTip.Tip="{Binding BackToSettingsText}">
                                <controls:SymbolIcon IconSize="22" Kind="Close" />
                            </Button>
                        </Grid>
                        <StackPanel
                            IsVisible="{Binding IsSettingsCategoryListVisible}"
                            Spacing="8">
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowAppearanceSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="Settings" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding AppearanceText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding AppearanceSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowBrandIconSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="Folder" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding BrandIconsText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding BrandIconSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowSecuritySettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="Lock" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SecurityText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding SecuritySettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowBackupSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="FolderAdd" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding BackupTitle}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding BackupSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowImportExportSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="QrCode" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ImportExportText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding ImportExportSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowMiscSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="Settings" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding MiscellaneousText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding MiscSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                Classes="wide secondary settings-category"
                                Click="ScrollMainViewToTop"
                                Command="{Binding ShowFaqSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:SymbolIcon Grid.Column="0" VerticalAlignment="Center" IconSize="24" Kind="Information" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding FaqText}" />
                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding FaqSettingsDescriptionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsAppearanceSettingsVisible}"
                            Padding="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{Binding LanguageText}" />
                                    <ComboBox
                                        Width="88"
                                        MinHeight="52"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Center"
                                        automation:AutomationProperties.Name="{Binding LanguageText}"
                                        ItemsSource="{Binding Languages}"
                                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MobileLanguageOption">
                                                <controls:LanguageFlagImage
                                                    Width="40"
                                                    Height="30"
                                                    automation:AutomationProperties.Name="{Binding DisplayName}"
                                                    CultureName="{Binding CultureName}"
                                                    Stretch="Uniform"
                                                    ToolTip.Tip="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate x:DataType="vm:MobileLanguageOption">
                                                <controls:LanguageFlagImage
                                                    Width="40"
                                                    Height="30"
                                                    automation:AutomationProperties.Name="{Binding DisplayName}"
                                                    CultureName="{Binding CultureName}"
                                                    Stretch="Uniform"
                                                    ToolTip.Tip="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{Binding AppearanceText}" />
                                    <StackPanel Spacing="4">
                                        <RadioButton
                                            GroupName="AppearanceTheme"
                                            Command="{Binding SelectSystemThemeCommand}"
                                            Content="{Binding ThemeFollowSystemText}"
                                            IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}" />
                                        <RadioButton
                                            GroupName="AppearanceTheme"
                                            Command="{Binding SelectDarkThemeCommand}"
                                            Content="{Binding ThemeDarkText}"
                                            IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}" />
                                        <RadioButton
                                            GroupName="AppearanceTheme"
                                            Command="{Binding SelectLightThemeCommand}"
                                            Content="{Binding ThemeLightText}"
                                            IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsMiscSettingsVisible}"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding LoggingLevelText}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    ItemsSource="{Binding LogLevels}"
                                    SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsSecuritySettingsVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding SecurityText}" />
                                <Border
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding ChangeMasterPasswordText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding ChangeMasterPasswordDescriptionText}"
                                            TextWrapping="Wrap" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding CurrentPasswordText}"
                                            PlaceholderText="{Binding CurrentPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding CurrentMasterPassword, Mode=TwoWay}" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding NewPasswordText}"
                                            PlaceholderText="{Binding NewPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding NewMasterPassword, Mode=TwoWay}" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding ConfirmPasswordText}"
                                            PlaceholderText="{Binding ConfirmPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding NewMasterPasswordConfirmation, Mode=TwoWay}" />
                                        <Button
                                            Classes="wide primary"
                                            Command="{Binding ChangeMasterPasswordCommand}"
                                            Content="{Binding ChangeMasterPasswordText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding AppLockTitleText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    IsVisible="{Binding IsAppLockEnabled}"
                                    Text="{Binding AppLockEnabledDescriptionText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushWarning}"
                                    IsVisible="{Binding IsAppLockDisabled}"
                                    Text="{Binding AppLockDisabledDescriptionText}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide"
                                    Classes.primary="{Binding IsAppLockDisabled}"
                                    Classes.secondary="{Binding IsAppLockEnabled}"
                                    Command="{Binding ToggleAppLockCommand}"
                                    Content="{Binding AppLockActionText}" />
                                <Border
                                    Background="{DynamicResource BrushSurfaceAlternate}"
                                    CornerRadius="8"
                                    IsVisible="{Binding IsDisableAppLockConfirmationVisible}"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Text="{Binding DisableAppLockWarningText}"
                                            TextWrapping="Wrap" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding MasterPasswordText}"
                                            PlaceholderText="{Binding MasterPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding AppLockRecoveryPassword, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button
                                                Grid.Column="0"
                                                Classes="wide secondary"
                                                Command="{Binding CancelDisableAppLockCommand}"
                                                Content="{Binding CancelText}" />
                                            <Button
                                                Grid.Column="1"
                                                Classes="wide danger"
                                                Command="{Binding ConfirmDisableAppLockCommand}"
                                                Content="{Binding DisableAppLockText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding UnlockMethodTitleText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding UnlockMethodDescriptionText}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    IsEnabled="{Binding IsUnlockMethodSelectionEnabled}"
                                    Spacing="6">
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding BeginBiometricEnrollmentCommand}"
                                        Content="{Binding UnlockWithBiometricsText}"
                                        IsChecked="{Binding IsBiometricUnlockSelected, Mode=OneWay}"
                                        IsEnabled="{Binding IsBiometricUnlockOptionEnabled}" />
                                    <TextBlock
                                        Margin="28,0,0,4"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        IsVisible="{Binding IsBiometricUnavailable}"
                                        Text="{Binding BiometricUnavailableText}"
                                        TextWrapping="Wrap" />
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding BeginDeviceCredentialEnrollmentCommand}"
                                        Content="{Binding UnlockWithDevicePinText}"
                                        IsChecked="{Binding IsDeviceCredentialUnlockSelected, Mode=OneWay}"
                                        IsEnabled="{Binding IsDeviceCredentialUnlockOptionEnabled}" />
                                    <TextBlock
                                        Margin="28,0,0,4"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        IsVisible="{Binding IsDeviceCredentialUnavailable}"
                                        Text="{Binding DevicePinUnavailableText}"
                                        TextWrapping="Wrap" />
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding SelectPasswordUnlockCommand}"
                                        Content="{Binding UnlockWithPasswordText}"
                                        IsChecked="{Binding IsPasswordUnlockSelected, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    IsVisible="{Binding IsBiometricEnrollmentVisible}"
                                    Spacing="10">
                                    <TextBlock
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        Text="{Binding UnlockMethodPasswordPromptText}"
                                        TextWrapping="Wrap" />
                                    <controls:RevealableSecretInput
                                        x:Name="UnlockMethodPasswordBox"
                                        AccessibleName="{Binding MasterPasswordText}"
                                        PlaceholderText="{Binding MasterPasswordText}"
                                        RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                        RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                        Text="{Binding BiometricRecoveryPassword, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Classes="wide secondary"
                                            Command="{Binding CancelBiometricEnrollmentCommand}"
                                            Content="{Binding CancelText}" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="wide primary"
                                            Command="{Binding EnableBiometricCommand}"
                                            Content="{Binding ApplyUnlockMethodText}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsBrandIconSettingsVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding BrandIconsText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding BrandIconsDescriptionText}"
                                    TextWrapping="Wrap" />
                                <HyperlinkButton
                                    HorizontalAlignment="Left"
                                    Content="{Binding IconPackBuilderLinkText}"
                                    NavigateUri="https://github.com/Legends/otp-harbor-icon-pack-builder"
                                    Padding="0,4" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextPrimary}"
                                    FontWeight="SemiBold"
                                    IsVisible="{Binding HasImportedBrandIcons}"
                                    Text="{Binding BrandIconPackStatusText}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding ImportBrandIconsCommand}"
                                    Content="{Binding ImportSimpleIconsPackText}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding ResetBrandIconsCommand}"
                                    Content="{Binding ResetBrandIconsText}"
                                    IsVisible="{Binding HasImportedBrandIcons}" />
                                <CheckBox
                                    Content="{Binding ShowIssuerLogoText}"
                                    IsChecked="{Binding ShowIssuerLogo, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding ShowIssuerLogoDescriptionText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsBackupSettingsVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding BackupDescription}"
                                    TextWrapping="Wrap" />
                                <Border
                                    x:Name="BackupExportPanel"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding BackupSectionText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding ExportBackupDescriptionText}"
                                            TextWrapping="Wrap" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding BackupPasswordText}"
                                            PlaceholderText="{Binding BackupPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding BackupPassword, Mode=TwoWay}" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding ConfirmBackupPasswordText}"
                                            PlaceholderText="{Binding ConfirmBackupPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding BackupPasswordConfirmation, Mode=TwoWay}" />
                                        <Button
                                            Classes="wide secondary"
                                            Command="{Binding ExportBackupCommand}"
                                            Content="{Binding ExportBackupText}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="BackupRestorePanel"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding RestoreSectionText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding ImportBackupDescriptionText}"
                                            TextWrapping="Wrap" />
                                        <controls:RevealableSecretInput
                                            AccessibleName="{Binding BackupPasswordText}"
                                            PlaceholderText="{Binding BackupPasswordText}"
                                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                                            Text="{Binding ImportPassword, Mode=TwoWay}" />
                                        <Button
                                            Classes="wide secondary"
                                            Command="{Binding ImportBackupCommand}"
                                            Content="{Binding ImportBackupText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border
                            Classes="card"
                            IsVisible="{Binding IsImportExportSettingsVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <Border
                                    x:Name="GoogleAuthenticatorImportPanel"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding ImportGoogleQrText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding ImportGoogleQrDescriptionText}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="GoogleAuthenticatorImportButton"
                                            Classes="wide secondary"
                                            Command="{Binding ImportGoogleQrCommand}"
                                            Content="{Binding ImportSectionText}" />
                                        <Border
                                            Background="{DynamicResource BrushSurfaceAlternate}"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsQrConflictVisible}"
                                            Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding QrConflictTitle}" />
                                                <TextBlock Text="{Binding QrConflictPrompt}" TextWrapping="Wrap" />
                                                <Button Classes="wide primary" Command="{Binding UpdateQrConflictCommand}" Content="{Binding UpdateExistingText}" />
                                                <Button Classes="wide secondary" Command="{Binding KeepBothQrConflictCommand}" Content="{Binding KeepBothText}" />
                                                <Button Classes="wide secondary" Command="{Binding CancelQrConflictCommand}" Content="{Binding CancelText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="OtherFormatsImportPanel"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding ImportAccountFileText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding ImportAccountFileDescriptionText}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding ImportFormatAegisText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ImportFormatTwoFasText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ImportFormatOtpAuthText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Classes="link"
                                            Click="ScrollMainViewToTop"
                                            Command="{Binding ShowImportFormatsFaqCommand}"
                                            Content="{Binding ViewImportFormatsFaqText}"
                                            HorizontalAlignment="Left" />
                                        <Button
                                            x:Name="OtherFormatsImportButton"
                                            Classes="wide secondary"
                                            Command="{Binding ImportAccountFileCommand}"
                                            Content="{Binding ImportSectionText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border
                            IsVisible="{Binding IsFaqSettingsVisible}"
                            Padding="0">
                            <StackPanel Spacing="12">
                                <Border
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource BrushFaqHeaderBackground}"
                                    BoxShadow="{DynamicResource ElevationCard}"
                                    CornerRadius="8">
                                    <Expander
                                        x:Name="FaqIconPacksExpander"
                                        Classes="mobile-faq-section"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="14,11" MinHeight="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <controls:SymbolIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderIcon}"
                                                    IconSize="24"
                                                    Kind="Folder" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderForeground}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding FaqImportIconPacksQuestionText}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border
                                            Background="{DynamicResource BrushFaqContentBackground}"
                                            CornerRadius="0,0,8,8"
                                            Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    Foreground="{DynamicResource BrushTextSecondary}"
                                                    Text="{Binding FaqImportIconPacksAnswerText}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding FaqImportIconPacksSourcesText}" TextWrapping="Wrap" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding IconPackBuilderLinkText}"
                                                    NavigateUri="https://github.com/Legends/otp-harbor-icon-pack-builder"
                                                    Padding="0,4" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding FaqSimpleIconsOfficialLinkText}"
                                                    NavigateUri="https://github.com/simple-icons/simple-icons/blob/develop/DISCLAIMER.md"
                                                    Padding="0,4" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding FaqAegisIconPackDocsLinkText}"
                                                    NavigateUri="https://github.com/aegis-icons/aegis-icons#disclaimer"
                                                    Padding="0,4" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding FaqDashboardIconsLegalLinkText}"
                                                    NavigateUri="https://github.com/homarr-labs/dashboard-icons#legal"
                                                    Padding="0,4" />
                                                <TextBlock
                                                    Foreground="{DynamicResource BrushTextSecondary}"
                                                    Text="{Binding FaqImportIconPacksDisclaimerText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                                <Border
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource BrushFaqHeaderBackground}"
                                    BoxShadow="{DynamicResource ElevationCard}"
                                    CornerRadius="8">
                                    <Expander
                                        x:Name="FaqImportFormatsExpander"
                                        Classes="mobile-faq-section"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="14,11" MinHeight="44" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <controls:SymbolIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderIcon}"
                                                    IconSize="24"
                                                    Kind="QrCode" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderForeground}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding FaqImportFormatsQuestionText}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border
                                            Background="{DynamicResource BrushFaqContentBackground}"
                                            CornerRadius="0,0,8,8"
                                            Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding FaqImportFormatsIntroText}" TextWrapping="Wrap" />
                                                <Expander
                                                    x:Name="FaqImportFormatsAegisExpander"
                                                    Classes="mobile-faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding FaqImportFormatsAegisTitleText}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding FaqImportFormatsAegisDescriptionText}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontSize="11" Text="{Binding FaqImportFormatsAegisExampleText}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsTwoFasExpander"
                                                    Classes="mobile-faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding FaqImportFormatsTwoFasTitleText}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding FaqImportFormatsTwoFasDescriptionText}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontSize="11" Text="{Binding FaqImportFormatsTwoFasExampleText}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsOtpAuthExpander"
                                                    Classes="mobile-faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding FaqImportFormatsOtpAuthTitleText}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding FaqImportFormatsOtpAuthDescriptionText}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontSize="11" Text="{Binding FaqImportFormatsOtpAuthExampleText}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsGroupEditorVisible}"
                        Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding GroupEditorTitle}" />
                            <Button
                                Grid.Column="1"
                                Width="48"
                                MinWidth="48"
                                Padding="8"
                                automation:AutomationProperties.Name="{Binding CancelText}"
                                Classes="icon-action"
                                Command="{Binding CancelGroupEditCommand}"
                                Content="×"
                                FontSize="26"
                                ToolTip.Tip="{Binding CancelText}" />
                        </Grid>
                        <TextBox
                            x:Name="GroupNameBox"
                            MaxLength="64"
                            automation:AutomationProperties.Name="{Binding GroupNameText}"
                            PlaceholderText="{Binding GroupNameText}"
                            Text="{Binding GroupEditorName, Mode=TwoWay}" />
                        <TextBlock Classes="field-label" Text="{Binding GroupColorText}" />
                        <ListBox
                            x:Name="GroupColorPicker"
                            Height="62"
                            Padding="4"
                            automation:AutomationProperties.Name="{Binding GroupColorText}"
                            ItemsSource="{Binding GroupColorOptions}"
                            SelectedItem="{Binding SelectedGroupColor, Mode=TwoWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionMode="Single">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MobileGroupColorOption">
                                    <Border
                                        Width="34"
                                        Height="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Brush}"
                                        CornerRadius="17"
                                        ToolTip.Tip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="field-label" Text="{Binding GroupAccountsText}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox
                                x:Name="GroupAccountSearchBox"
                                Grid.ColumnSpan="2"
                                Padding="12,8,48,8"
                                automation:AutomationProperties.Name="{Binding SearchAccountsText}"
                                PlaceholderText="{Binding SearchAccountsText}"
                                Text="{Binding GroupEditorSearchText, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                MinHeight="44"
                                Margin="0,0,4,0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                automation:AutomationProperties.Name="{Binding ClearSearchText}"
                                Classes="link"
                                Click="RefocusGroupAccountSearchAfterClear"
                                Command="{Binding ClearGroupEditorSearchCommand}"
                                IsVisible="{Binding HasGroupEditorSearchText}"
                                ToolTip.Tip="{Binding ClearSearchText}">
                                <controls:SymbolIcon IconSize="18" Kind="Close" />
                            </Button>
                        </Grid>
                        <Border Classes="card" Padding="6">
                            <Grid Height="220">
                                <ListBox
                                    x:Name="GroupAccountPicker"
                                    Classes="accounts group-account-picker"
                                    ItemsSource="{Binding GroupEditorAccounts}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.IsScrollChainingEnabled="False"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel CacheLength="0.5" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MobileGroupAccountSelection">
                                            <CheckBox
                                                MinHeight="54"
                                                Padding="6,3"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <controls:BrandTile
                                                        Grid.Column="0"
                                                        IsVisible="{Binding ShowIssuerLogo}"
                                                            IconData="{Binding Brand.IconData}"
                                                            IconImage="{Binding Brand.IconImage}"
                                                            IconTransform="{Binding Brand.IconTransform}"
                                                            IsCustomIcon="{Binding Brand.IsCustomIcon}"
                                                        Initials="{Binding Brand.Initials}"
                                                        TileBackground="{Binding Brand.BackgroundBrush}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Issuer}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrushTextSecondary}"
                                                            FontSize="12"
                                                            Text="{Binding AccountName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ContentControl
                                    x:Name="NativeGroupAccountPickerPresenter"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding !IsDeleteGroupConfirmationVisible}" />
                            </Grid>
                        </Border>
                        <controls:ValidationMessage Severity="Error" Text="{Binding GroupEditorMessage}" />
                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Classes="danger"
                                Command="{Binding BeginDeleteGroupCommand}"
                                Content="{Binding DeleteGroupText}"
                                IsVisible="{Binding IsEditingGroup}" />
                            <Button
                                Grid.Column="1"
                                Classes="wide secondary"
                                Command="{Binding CancelGroupEditCommand}"
                                Content="{Binding CancelText}" />
                            <Button
                                Grid.Column="2"
                                Classes="wide primary"
                                Command="{Binding SaveGroupCommand}"
                                Content="{Binding SaveText}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsEditorVisible}"
                        Spacing="14">
                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="{Binding EditorTitle}" />
                        <TextBox
                            automation:AutomationProperties.Name="{Binding IssuerText}"
                            PlaceholderText="{Binding IssuerText}"
                            Text="{Binding EditorIssuer, Mode=TwoWay}" />
                        <controls:ValidationMessage Severity="Error" Text="{Binding EditorIssuerMessage}" />
                        <TextBox
                            automation:AutomationProperties.Name="{Binding AccountNameText}"
                            PlaceholderText="{Binding AccountNameText}"
                            Text="{Binding EditorAccountName, Mode=TwoWay}" />
                        <controls:RevealableSecretInput
                            AccessibleName="{Binding EditorSecretPlaceholder}"
                            PlaceholderText="{Binding EditorSecretPlaceholder}"
                            RevealButtonAccessibleName="{Binding RevealPasswordText}"
                            RevealButtonHelpText="{Binding RevealPasswordHelpText}"
                            Text="{Binding EditorSecret, Mode=TwoWay}" />
                        <controls:ValidationMessage Severity="Error" Text="{Binding EditorSecretMessage}" />
                        <Expander
                            x:Name="AccountAdvancedOptions"
                            Header="{Binding AdvancedOptionsText}"
                            IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                            <StackPanel Spacing="8">
                                <CheckBox
                                    automation:AutomationProperties.Name="{Binding FavoriteAccountText}"
                                    Content="{Binding FavoriteAccountText}"
                                    IsChecked="{Binding EditorIsFavorite, Mode=TwoWay}" />
                                <Border
                                    Height="1"
                                    Margin="0,4"
                                    Background="{DynamicResource BrushBorder}" />
                                <TextBlock
                                    Classes="field-label"
                                    Text="{Binding BrandIconText}" />
                                <controls:SearchableComboBox
                                    x:Name="AccountBrandIconComboBox"
                                    HorizontalAlignment="Left"
                                    automation:AutomationProperties.Name="{Binding BrandIconText}"
                                    ClearSearchText="{Binding ClearSearchText}"
                                    IsEnabled="{Binding HasBrandIconChoices}"
                                    ItemsSource="{Binding EditorBrandIconOptions}"
                                    PopupWidth="300"
                                    PreferredWidth="{Binding EditorBrandIconPickerWidth}"
                                    SearchPlaceholder="{Binding SearchBrandIconsText}"
                                    SelectedItem="{Binding SelectedEditorBrandIconOption, Mode=TwoWay}">
                                    <controls:SearchableComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MobileBrandIconOption">
                                            <TextBlock Text="{Binding DisplayNameForDisplay}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </controls:SearchableComboBox.ItemTemplate>
                                </controls:SearchableComboBox>
                                <Border MinHeight="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        IsVisible="{Binding HasSelectedEditorCustomIconFileName}"
                                        Text="{Binding SelectedEditorCustomIconFileName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button
                                    x:Name="CustomSvgIconButton"
                                    Classes="wide secondary"
                                    Command="{Binding ImportCustomIconCommand}"
                                    Content="{Binding ChooseCustomSvgIconText}"
                                    IsVisible="{Binding IsEditingExistingAccount}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding BrandIconHelpText}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Height="1"
                                    Margin="0,4"
                                    Background="{DynamicResource BrushBorder}" />
                                <TextBlock
                                    Classes="field-label"
                                    Text="{Binding TotpPeriodText}" />
                                <NumericUpDown
                                    automation:AutomationProperties.Name="{Binding TotpPeriodText}"
                                    Classes="mobile-period"
                                    Increment="5"
                                    Maximum="3600"
                                    Minimum="5"
                                    Value="{Binding EditorPeriodSeconds, Mode=TwoWay}">
                                    <NumericUpDown.InnerRightContent>
                                        <Button
                                            automation:AutomationProperties.Name="{Binding ClearPeriodText}"
                                            Classes="numeric-clear"
                                            Click="RefocusAccountPeriodAfterClear"
                                            Command="{Binding ClearEditorPeriodCommand}"
                                            Content="×"
                                            IsVisible="{Binding HasEditorPeriodSeconds}"
                                            ToolTip.Tip="{Binding ClearPeriodText}" />
                                    </NumericUpDown.InnerRightContent>
                                </NumericUpDown>
                                <controls:ValidationMessage Severity="Error" Text="{Binding EditorPeriodMessage}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding TotpPeriodHelpText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Classes="wide secondary"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding CancelText}" />
                            <Button
                                Grid.Column="1"
                                Classes="wide primary"
                                Command="{Binding SaveAccountCommand}"
                                Content="{Binding SaveText}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Button
            x:Name="SettingsBackToTopButton"
            Grid.Row="1"
            ZIndex="20"
            Width="48"
            Height="48"
            MinWidth="48"
            MinHeight="48"
            Margin="0,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            automation:AutomationProperties.Name="{Binding BackToTopText}"
            Classes="settings-back-to-top"
            Click="ScrollMainViewToTop"
            IsVisible="False"
            Padding="12"
            ToolTip.Tip="{Binding BackToTopText}">
            <controls:SymbolIcon IconSize="18" Kind="ArrowUp" Opacity="0.65" />
        </Button>

        <!-- Keep the biometric action responsive: its center is exactly in the
             middle of the lower third of the content area. -->
        <Grid
            x:Name="FingerprintUnlockAnchor"
            Grid.Row="1"
            Panel.ZIndex="10"
            IsVisible="{Binding IsFingerprintUnlockVisible}"
            RowDefinitions="5*,0,*">
            <Button
                x:Name="FingerprintUnlockButton"
                Grid.Row="1"
                Width="92"
                Height="92"
                MinHeight="92"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="10"
                automation:AutomationProperties.Name="{Binding BiometricUnlockText}"
                Classes="primary biometric-unlock"
                Command="{Binding BiometricUnlockCommand}"
                ToolTip.Tip="{Binding BiometricUnlockText}">
                <controls:FingerprintIcon IconSize="72" />
            </Button>
        </Grid>

        <!-- Android native controls always render above Avalonia overlays. Keep account-list
             notifications in this fixed, non-native footer so they remain visible without
             changing the list viewport when a transient message appears. -->
        <Grid
            x:Name="AccountListFooter"
            Grid.Row="2"
            Height="40"
            IsVisible="{Binding IsAccountListVisible}">
            <Border
                x:Name="AccountCountFooter"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource BrushTextSecondary}"
                    IsHitTestVisible="False"
                    Text="{Binding SearchResultSummary}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Border>
            <controls:NotificationBanner
                Margin="12,3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                ZIndex="1"
                Severity="{Binding NotificationSeverity}"
                Text="{Binding NotificationText}" />
        </Grid>

        <Grid
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            IsVisible="{Binding !IsAccountListVisible}"
            Panel.ZIndex="50">
            <controls:NotificationBanner
                Margin="20,8,20,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Severity="{Binding NotificationSeverity}"
                Text="{Binding NotificationText}" />
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="90"
            Background="{DynamicResource BrushOverlayLight}"
            IsVisible="{Binding IsImportProgressVisible}">
            <Border
                MaxWidth="360"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding ImportProgressText}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding ImportProgressText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="{DynamicResource BrushOverlayStrong}"
            IsVisible="{Binding IsImportConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding ImportConfirmationTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding ImportConfirmationTitle}" />
                    <TextBlock
                        Text="{Binding ImportConfirmationText}"
                        TextWrapping="Wrap" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding IsImportConfirmationCancelVisible}">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelImportCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide primary"
                            Command="{Binding ConfirmImportCommand}"
                            Content="{Binding ConfirmImportText}" />
                    </Grid>
                    <Button
                        Classes="wide primary"
                        Command="{Binding ConfirmImportCommand}"
                        Content="{Binding ConfirmImportText}"
                        IsVisible="{Binding IsImportConfirmationAcknowledgementOnly}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="{DynamicResource BrushOverlayStrong}"
            IsVisible="{Binding IsBackupConflictResolutionVisible}">
            <Border
                MaxWidth="560"
                MaxHeight="720"
                Margin="18"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding BackupConflictResolutionTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding BackupConflictResolutionTitle}" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="13"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding BackupConflictResolutionText}"
                        TextWrapping="Wrap" />
                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceAlternate}"
                        CornerRadius="8"
                        Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding ApplyToAllText}" />
                            <RadioButton
                                automation:AutomationProperties.Name="{Binding SkipAllText}"
                                Command="{Binding SkipAllBackupConflictsCommand}"
                                Content="{Binding SkipAllText}"
                                FontSize="12"
                                IsChecked="{Binding IsAllBackupConflictsSkipped, Mode=OneWay}" />
                            <RadioButton
                                automation:AutomationProperties.Name="{Binding OverrideAllText}"
                                Command="{Binding ReplaceAllBackupConflictsCommand}"
                                Content="{Binding OverrideAllText}"
                                FontSize="12"
                                IsChecked="{Binding IsAllBackupConflictsReplaced, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Grid
                        Grid.Row="3"
                        ColumnDefinitions="*,84,92"
                        Margin="4,0"
                        ColumnSpacing="2">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding ConflictAccountText}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding SkipText}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding OverrideText}" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="4"
                        MaxHeight="320"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BackupImportConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackupImportConflictItem">
                                    <Border
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="0,0,0,1">
                                        <Grid
                                            MinHeight="88"
                                            ColumnDefinitions="*,84,92"
                                            ColumnSpacing="2">
                                            <StackPanel
                                                Margin="4,9"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    MaxLines="2"
                                                    Text="{Binding CurrentDisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource BrushTextSecondary}"
                                                    MaxLines="2"
                                                    Text="{Binding BackupDisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource BrushAccent}"
                                                    Text="{Binding ChangedFieldsText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.Name="{Binding KeepAutomationName}"
                                                IsChecked="{Binding IsSkipSelected, Mode=TwoWay}" />
                                            <RadioButton
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.Name="{Binding RestoreAutomationName}"
                                                IsChecked="{Binding IsReplaceSelected, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelBackupConflictResolutionCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide primary"
                            Command="{Binding ConfirmBackupConflictResolutionCommand}"
                            Content="{Binding ConfirmImportText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="AccountEditorExitModalOverlay"
            Grid.RowSpan="3"
            Panel.ZIndex="103"
            Background="{DynamicResource BrushOverlayStrong}"
            IsVisible="{Binding IsAccountEditorExitConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding UnsavedAccountChangesTitleText}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding UnsavedAccountChangesTitleText}" />
                    <TextBlock
                        Text="{Binding UnsavedAccountChangesPromptText}"
                        TextWrapping="Wrap" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding SaveAccountAndNavigateBackCommand}"
                        Content="{Binding SaveText}" />
                    <Button
                        Classes="wide secondary"
                        Command="{Binding DiscardAccountChangesCommand}"
                        Content="{Binding DiscardChangesText}" />
                    <Button
                        Classes="wide secondary"
                        Command="{Binding CancelAccountNavigationCommand}"
                        Content="{Binding CancelText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="GroupDeleteModalOverlay"
            Grid.RowSpan="3"
            Panel.ZIndex="102"
            Background="{DynamicResource BrushOverlayStrong}"
            IsVisible="{Binding IsDeleteGroupConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding DeleteGroupText}"
                Background="{DynamicResource BrushSurface}"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding DeleteGroupText}" />
                    <TextBlock Text="{Binding GroupDeletePrompt}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelDeleteGroupCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide danger"
                            Command="{Binding ConfirmDeleteGroupCommand}"
                            Content="{Binding DeleteText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="101"
            Background="{DynamicResource BrushOverlayStrong}"
            IsVisible="{Binding IsDeleteConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding DeleteConfirmTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding DeleteConfirmTitle}" />
                    <TextBlock
                        Text="{Binding DeletePrompt}"
                        TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelDeleteCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide danger"
                            Command="{Binding ConfirmDeleteCommand}"
                            Content="{Binding DeleteText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
