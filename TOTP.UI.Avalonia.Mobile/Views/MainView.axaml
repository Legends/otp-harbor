<UserControl
    x:Class="TOTP.Avalonia.Mobile.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Shared.Controls"
    xmlns:input="using:Avalonia.Input.GestureRecognizers"
    xmlns:vm="using:TOTP.Avalonia.Mobile.Presentation"
    x:Name="Root"
    x:DataType="vm:MobileShellViewModel"
    Background="{DynamicResource BrushWindowBackground}">
    <UserControl.Styles>
        <Style Selector="TextBox.unlock-method-attention">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:SymbolIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource BrushAccent}"
                    IconSize="32"
                    Kind="Lock" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource BrushTextPrimary}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding AppTitle}" />
                <Button
                    Grid.Column="2"
                    automation:AutomationProperties.Name="{Binding LockText}"
                    Classes="icon-action"
                    Command="{Binding LockCommand}"
                    IsVisible="{Binding IsManualLockVisible}"
                    ToolTip.Tip="{Binding LockText}">
                    <controls:SymbolIcon IconSize="24" Kind="Lock" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Classes.account-list="{Binding IsAccountListVisible}">
            <ScrollViewer.Styles>
                <Style Selector="ScrollViewer.account-list">
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                </Style>
            </ScrollViewer.Styles>
            <Grid
                MaxWidth="720"
                Margin="20"
                HorizontalAlignment="Stretch">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsStartingVisible}"
                    Spacing="18"
                    VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding StartingText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding InitializeCommand}"
                        Content="{Binding RetryText}"
                        IsVisible="{Binding CanRetry}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsSetupVisible}"
                    Spacing="14">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding SetupTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding SetupDescription}"
                        TextWrapping="Wrap" />
                    <TextBox
                        automation:AutomationProperties.Name="{Binding MasterPasswordText}"
                        PasswordChar="●"
                        PlaceholderText="{Binding MasterPasswordText}"
                        Text="{Binding SetupPassword, Mode=TwoWay}" />
                    <TextBox
                        automation:AutomationProperties.Name="{Binding ConfirmPasswordText}"
                        PasswordChar="●"
                        PlaceholderText="{Binding ConfirmPasswordText}"
                        Text="{Binding SetupConfirmation, Mode=TwoWay}" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding ConfigureCommand}"
                        Content="{Binding CreateVaultText}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsUnlockVisible}"
                    Spacing="14">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding UnlockTitle}" />
                    <TextBlock
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding UnlockDescription}"
                        TextWrapping="Wrap" />
                    <TextBox
                        automation:AutomationProperties.Name="{Binding MasterPasswordText}"
                        PasswordChar="●"
                        PlaceholderText="{Binding MasterPasswordText}"
                        Text="{Binding UnlockPassword, Mode=TwoWay}" />
                    <Button
                        Classes="wide primary"
                        Command="{Binding UnlockCommand}"
                        Content="{Binding UnlockText}" />
                    <Button
                        Classes="wide secondary"
                        Command="{Binding BiometricUnlockCommand}"
                        Content="{Binding BiometricUnlockText}"
                        IsVisible="{Binding IsBiometricUnlockVisible}" />
                </StackPanel>

                <Grid IsVisible="{Binding IsAccountsVisible}">
                    <Grid
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsAccountListVisible}"
                        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,14"
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding AccountsTitle}" />
                            <Button
                                Grid.Column="1"
                                automation:AutomationProperties.Name="{Binding ScanQrText}"
                                Classes="icon-action"
                                Command="{Binding ScanQrCommand}"
                                ToolTip.Tip="{Binding ScanQrText}">
                                <controls:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IconSize="24"
                                    Kind="Camera" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                automation:AutomationProperties.Name="{Binding AddAccountText}"
                                Classes="icon-action"
                                Command="{Binding BeginAddCommand}"
                                ToolTip.Tip="{Binding AddAccountText}">
                                <controls:SymbolIcon IconSize="24" Kind="Add" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                automation:AutomationProperties.Name="{Binding SettingsText}"
                                Classes="icon-action"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip.Tip="{Binding SettingsText}">
                                <controls:SymbolIcon IconSize="24" Kind="Settings" />
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,14"
                            ColumnDefinitions="*,Auto">
                            <TextBox
                                Grid.ColumnSpan="2"
                                Padding="12,8,48,8"
                                automation:AutomationProperties.Name="{Binding SearchAccountsText}"
                                PlaceholderText="{Binding SearchAccountsText}"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                MinHeight="44"
                                Margin="0,0,4,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{Binding ClearSearchText}"
                                Classes="link"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                FontSize="26"
                                IsVisible="{Binding HasSearchText}"
                                ToolTip.Tip="{Binding ClearSearchText}" />
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Margin="0,0,0,14"
                            Background="{DynamicResource BrushSurfaceAlternate}"
                            CornerRadius="8"
                            IsVisible="{Binding IsQrConflictVisible}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding QrConflictTitle}" />
                                <TextBlock
                                    Text="{Binding QrConflictPrompt}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide primary"
                                    Command="{Binding UpdateQrConflictCommand}"
                                    Content="{Binding UpdateExistingText}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding KeepBothQrConflictCommand}"
                                    Content="{Binding KeepBothText}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding CancelQrConflictCommand}"
                                    Content="{Binding CancelText}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Grid.Row="3"
                            Foreground="{DynamicResource BrushTextSecondary}"
                            IsVisible="{Binding HasNoAccounts}"
                            Text="{Binding NoAccountsText}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="3"
                            Foreground="{DynamicResource BrushTextSecondary}"
                            IsVisible="{Binding HasNoSearchResults}"
                            Text="{Binding NoSearchResultsText}"
                            TextWrapping="Wrap" />

                        <ListBox
                            Grid.Row="3"
                            Background="Transparent"
                            BorderThickness="0"
                            Classes="accounts"
                            IsHitTestVisible="{Binding !IsDeleteConfirmationVisible}"
                            IsVisible="{Binding HasAccounts}"
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MobileAccountItem">
                                    <Border
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="0,0,0,1"
                                        ClipToBounds="True"
                                        CornerRadius="0">
                                        <Grid MinHeight="76">
                                            <Grid
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource BrushAccent}"
                                                ColumnDefinitions="*,*">
                                                <Button
                                                    Grid.Column="0"
                                                    automation:AutomationProperties.Name="{Binding DataContext.ShowQrText, ElementName=Root}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="ShowQrForAccount"
                                                    CornerRadius="0"
                                                    ToolTip.Tip="{Binding DataContext.ShowQrText, ElementName=Root}">
                                                    <controls:SymbolIcon
                                                        Foreground="White"
                                                        IconSize="23"
                                                        Kind="QrCode" />
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    automation:AutomationProperties.Name="{Binding DataContext.EditAccountText, ElementName=Root}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="EditAccount"
                                                    CornerRadius="0"
                                                    ToolTip.Tip="{Binding DataContext.EditAccountText, ElementName=Root}">
                                                    <controls:SymbolIcon
                                                        Foreground="White"
                                                        IconSize="23"
                                                        Kind="Edit" />
                                                </Button>
                                            </Grid>
                                            <Border
                                                Width="60"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource BrushDanger}"
                                                IsHitTestVisible="False">
                                                <controls:SymbolIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    IconSize="24"
                                                    Kind="Delete" />
                                            </Border>
                                            <Border
                                                Background="{DynamicResource BrushSurface}"
                                                Padding="16,10"
                                                Tapped="CopyAccountCode"
                                                ToolTip.Tip="{Binding DataContext.CopyCodeText, ElementName=Root}"
                                                SwipeGesture="TrackAccountSwipe"
                                                SwipeGestureEnded="CompleteAccountSwipe">
                                                <Border.RenderTransform>
                                                    <TranslateTransform />
                                                </Border.RenderTransform>
                                                <Border.GestureRecognizers>
                                                    <input:SwipeGestureRecognizer
                                                        CanHorizontallySwipe="True"
                                                        IsMouseEnabled="True"
                                                        Threshold="24" />
                                                </Border.GestureRecognizers>
                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    RowDefinitions="*,Auto"
                                                    ColumnSpacing="12">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Issuer}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrushTextSecondary}"
                                                            IsVisible="{Binding HasAccountName}"
                                                            Text="{Binding AccountName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource BrushTextSecondary}"
                                                            IsVisible="{Binding HasCustomPeriod}"
                                                            Text="{Binding CustomPeriodLabel}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource BrushTextSelection}"
                                                        FontFamily="Consolas"
                                                        FontSize="25"
                                                        FontWeight="Bold"
                                                        Text="{Binding DisplayCode}" />
                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Height="3"
                                                        Margin="0,7,0,0"
                                                        Maximum="{Binding PeriodSeconds}"
                                                        Value="{Binding RemainingSeconds}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource BrushTextSecondary}"
                            IsVisible="{Binding HasAccounts}"
                            Text="{Binding AccountSwipeHintText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Border
                            Grid.Row="5"
                            Margin="0,14,0,0"
                            Classes="card"
                            IsVisible="{Binding HasQrImage}"
                            Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedAccount.DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Background="White"
                                    CornerRadius="8"
                                    IsVisible="{Binding HasQrImage}"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <Image
                                            Width="240"
                                            Height="240"
                                            HorizontalAlignment="Center"
                                            Source="{Binding QrImage}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Foreground="#1A2E4E"
                                            Text="{Binding QrPrivacyNoticeText}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Classes="wide secondary"
                                            Command="{Binding DismissQrCommand}"
                                            Content="{Binding DismissQrText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsSettingsVisible}"
                        Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding SettingsText}" />
                            <Button
                                Grid.Column="1"
                                automation:AutomationProperties.Name="{Binding CodesText}"
                                Classes="icon-action"
                                Command="{Binding ShowAccountsCommand}"
                                ToolTip.Tip="{Binding CodesText}">
                                <controls:SymbolIcon IconSize="24" Kind="Codes" />
                            </Button>
                        </Grid>
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding LanguageText}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <Button
                                        Grid.Column="0"
                                        Classes="wide language-option"
                                        Classes.selected="{Binding IsEnglishLanguageSelected}"
                                        Command="{Binding SelectEnglishLanguageCommand}"
                                        Content="{Binding EnglishLanguageText}" />
                                    <Button
                                        Grid.Column="1"
                                        Classes="wide language-option"
                                        Classes.selected="{Binding IsGermanLanguageSelected}"
                                        Command="{Binding SelectGermanLanguageCommand}"
                                        Content="{Binding GermanLanguageText}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Classes="wide language-option"
                                        Classes.selected="{Binding IsFrenchLanguageSelected}"
                                        Command="{Binding SelectFrenchLanguageCommand}"
                                        Content="{Binding FrenchLanguageText}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Classes="wide language-option"
                                        Classes.selected="{Binding IsSpanishLanguageSelected}"
                                        Command="{Binding SelectSpanishLanguageCommand}"
                                        Content="{Binding SpanishLanguageText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding SecurityText}" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding AppLockTitleText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    IsVisible="{Binding IsAppLockEnabled}"
                                    Text="{Binding AppLockEnabledDescriptionText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushWarning}"
                                    IsVisible="{Binding IsAppLockDisabled}"
                                    Text="{Binding AppLockDisabledDescriptionText}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide"
                                    Classes.primary="{Binding IsAppLockDisabled}"
                                    Classes.secondary="{Binding IsAppLockEnabled}"
                                    Command="{Binding ToggleAppLockCommand}"
                                    Content="{Binding AppLockActionText}" />
                                <Border
                                    Background="{DynamicResource BrushSurfaceAlternate}"
                                    CornerRadius="8"
                                    IsVisible="{Binding IsDisableAppLockConfirmationVisible}"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Text="{Binding DisableAppLockWarningText}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            automation:AutomationProperties.Name="{Binding MasterPasswordText}"
                                            PasswordChar="●"
                                            PlaceholderText="{Binding MasterPasswordText}"
                                            Text="{Binding AppLockRecoveryPassword, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button
                                                Grid.Column="0"
                                                Classes="wide secondary"
                                                Command="{Binding CancelDisableAppLockCommand}"
                                                Content="{Binding CancelText}" />
                                            <Button
                                                Grid.Column="1"
                                                Classes="wide danger"
                                                Command="{Binding ConfirmDisableAppLockCommand}"
                                                Content="{Binding DisableAppLockText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding UnlockMethodTitleText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding UnlockMethodDescriptionText}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    IsEnabled="{Binding IsUnlockMethodSelectionEnabled}"
                                    Spacing="6">
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding BeginBiometricEnrollmentCommand}"
                                        Content="{Binding UnlockWithBiometricsText}"
                                        IsChecked="{Binding IsBiometricUnlockSelected, Mode=OneWay}"
                                        IsEnabled="{Binding IsBiometricUnlockOptionEnabled}" />
                                    <TextBlock
                                        Margin="28,0,0,4"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        IsVisible="{Binding IsBiometricUnavailable}"
                                        Text="{Binding BiometricUnavailableText}"
                                        TextWrapping="Wrap" />
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding BeginDeviceCredentialEnrollmentCommand}"
                                        Content="{Binding UnlockWithDevicePinText}"
                                        IsChecked="{Binding IsDeviceCredentialUnlockSelected, Mode=OneWay}"
                                        IsEnabled="{Binding IsDeviceCredentialUnlockOptionEnabled}" />
                                    <TextBlock
                                        Margin="28,0,0,4"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        IsVisible="{Binding IsDeviceCredentialUnavailable}"
                                        Text="{Binding DevicePinUnavailableText}"
                                        TextWrapping="Wrap" />
                                    <RadioButton
                                        GroupName="UnlockMethod"
                                        Click="HighlightUnlockMethodConfirmation"
                                        Command="{Binding SelectPasswordUnlockCommand}"
                                        Content="{Binding UnlockWithPasswordText}"
                                        IsChecked="{Binding IsPasswordUnlockSelected, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    IsVisible="{Binding IsBiometricEnrollmentVisible}"
                                    Spacing="10">
                                    <TextBlock
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        Text="{Binding UnlockMethodPasswordPromptText}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="UnlockMethodPasswordBox"
                                        automation:AutomationProperties.Name="{Binding MasterPasswordText}"
                                        PasswordChar="●"
                                        PlaceholderText="{Binding MasterPasswordText}"
                                        Text="{Binding BiometricRecoveryPassword, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Classes="wide secondary"
                                            Command="{Binding CancelBiometricEnrollmentCommand}"
                                            Content="{Binding CancelText}" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="wide primary"
                                            Command="{Binding EnableBiometricCommand}"
                                            Content="{Binding ApplyUnlockMethodText}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding ImportSectionText}" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding ImportGoogleQrText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding ImportGoogleQrDescriptionText}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="wide primary"
                                    Command="{Binding ImportGoogleQrCommand}"
                                    Content="{Binding ImportGoogleQrText}" />
                                <Border
                                    Background="{DynamicResource BrushSurfaceAlternate}"
                                    CornerRadius="8"
                                    IsVisible="{Binding IsQrConflictVisible}"
                                    Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding QrConflictTitle}" />
                                        <TextBlock Text="{Binding QrConflictPrompt}" TextWrapping="Wrap" />
                                        <Button Classes="wide primary" Command="{Binding UpdateQrConflictCommand}" Content="{Binding UpdateExistingText}" />
                                        <Button Classes="wide secondary" Command="{Binding KeepBothQrConflictCommand}" Content="{Binding KeepBothText}" />
                                        <Button Classes="wide secondary" Command="{Binding CancelQrConflictCommand}" Content="{Binding CancelText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding ImportBackupText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding ImportBackupDescriptionText}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    automation:AutomationProperties.Name="{Binding BackupPasswordText}"
                                    PasswordChar="●"
                                    PlaceholderText="{Binding BackupPasswordText}"
                                    Text="{Binding ImportPassword, Mode=TwoWay}" />
                                <Button
                                    Classes="wide secondary"
                                    Command="{Binding ImportBackupCommand}"
                                    Content="{Binding ImportBackupText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding ExportSectionText}" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding ExportBackupText}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding ExportBackupDescriptionText}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    automation:AutomationProperties.Name="{Binding BackupPasswordText}"
                                    PasswordChar="●"
                                    PlaceholderText="{Binding BackupPasswordText}"
                                    Text="{Binding BackupPassword, Mode=TwoWay}" />
                                <TextBox
                                    automation:AutomationProperties.Name="{Binding ConfirmBackupPasswordText}"
                                    PasswordChar="●"
                                    PlaceholderText="{Binding ConfirmBackupPasswordText}"
                                    Text="{Binding BackupPasswordConfirmation, Mode=TwoWay}" />
                                <Button
                                    Classes="wide primary"
                                    Command="{Binding ExportBackupCommand}"
                                    Content="{Binding ExportBackupText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsEditorVisible}"
                        Spacing="14">
                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="{Binding EditorTitle}" />
                        <TextBox
                            automation:AutomationProperties.Name="{Binding IssuerText}"
                            PlaceholderText="{Binding IssuerText}"
                            Text="{Binding EditorIssuer, Mode=TwoWay}" />
                        <controls:ValidationMessage Severity="Error" Text="{Binding EditorIssuerMessage}" />
                        <TextBox
                            automation:AutomationProperties.Name="{Binding AccountNameText}"
                            PlaceholderText="{Binding AccountNameText}"
                            Text="{Binding EditorAccountName, Mode=TwoWay}" />
                        <TextBox
                            automation:AutomationProperties.Name="{Binding EditorSecretPlaceholder}"
                            PasswordChar="●"
                            PlaceholderText="{Binding EditorSecretPlaceholder}"
                            Text="{Binding EditorSecret, Mode=TwoWay}" />
                        <controls:ValidationMessage Severity="Error" Text="{Binding EditorSecretMessage}" />
                        <Expander
                            Header="{Binding AdvancedOptionsText}"
                            IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Classes="field-label"
                                    Text="{Binding TotpPeriodText}" />
                                <NumericUpDown
                                    automation:AutomationProperties.Name="{Binding TotpPeriodText}"
                                    Increment="1"
                                    Maximum="3600"
                                    Minimum="5"
                                    Value="{Binding EditorPeriodSeconds, Mode=TwoWay}" />
                                <controls:ValidationMessage Severity="Error" Text="{Binding EditorPeriodMessage}" />
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Text="{Binding TotpPeriodHelpText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Classes="wide secondary"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding CancelText}" />
                            <Button
                                Grid.Column="1"
                                Classes="wide primary"
                                Command="{Binding SaveAccountCommand}"
                                Content="{Binding SaveText}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <controls:NotificationBanner
            Grid.RowSpan="3"
            Margin="20,8,20,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            ZIndex="50"
            Severity="{Binding NotificationSeverity}"
            Text="{Binding NotificationText}" />

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="#99000000"
            IsVisible="{Binding IsImportConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding ImportConfirmationTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding ImportConfirmationTitle}" />
                    <TextBlock
                        Text="{Binding ImportConfirmationText}"
                        TextWrapping="Wrap" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding IsImportConfirmationCancelVisible}">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelImportCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide primary"
                            Command="{Binding ConfirmImportCommand}"
                            Content="{Binding ConfirmImportText}" />
                    </Grid>
                    <Button
                        Classes="wide primary"
                        Command="{Binding ConfirmImportCommand}"
                        Content="{Binding ConfirmImportText}"
                        IsVisible="{Binding IsImportConfirmationAcknowledgementOnly}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="#99000000"
            IsVisible="{Binding IsBackupConflictResolutionVisible}">
            <Border
                MaxWidth="560"
                MaxHeight="720"
                Margin="18"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding BackupConflictResolutionTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding BackupConflictResolutionTitle}" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="13"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Text="{Binding BackupConflictResolutionText}"
                        TextWrapping="Wrap" />
                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceAlternate}"
                        CornerRadius="8"
                        Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding ApplyToAllText}" />
                            <RadioButton
                                automation:AutomationProperties.Name="{Binding SkipAllText}"
                                Command="{Binding SkipAllBackupConflictsCommand}"
                                Content="{Binding SkipAllText}"
                                FontSize="12"
                                IsChecked="{Binding IsAllBackupConflictsSkipped, Mode=OneWay}" />
                            <RadioButton
                                automation:AutomationProperties.Name="{Binding OverrideAllText}"
                                Command="{Binding ReplaceAllBackupConflictsCommand}"
                                Content="{Binding OverrideAllText}"
                                FontSize="12"
                                IsChecked="{Binding IsAllBackupConflictsReplaced, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Grid
                        Grid.Row="3"
                        ColumnDefinitions="*,84,92"
                        Margin="4,0"
                        ColumnSpacing="2">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding ConflictAccountText}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding SkipText}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding OverrideText}" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="4"
                        MaxHeight="320"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BackupImportConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackupImportConflictItem">
                                    <Border
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="0,0,0,1">
                                        <Grid
                                            MinHeight="88"
                                            ColumnDefinitions="*,84,92"
                                            ColumnSpacing="2">
                                            <StackPanel
                                                Margin="4,9"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    MaxLines="2"
                                                    Text="{Binding CurrentDisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource BrushTextSecondary}"
                                                    MaxLines="2"
                                                    Text="{Binding BackupDisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource BrushAccent}"
                                                    Text="{Binding ChangedFieldsText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.Name="{Binding KeepAutomationName}"
                                                IsChecked="{Binding IsSkipSelected, Mode=TwoWay}" />
                                            <RadioButton
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.Name="{Binding RestoreAutomationName}"
                                                IsChecked="{Binding IsReplaceSelected, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelBackupConflictResolutionCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide primary"
                            Command="{Binding ConfirmBackupConflictResolutionCommand}"
                            Content="{Binding ConfirmImportText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="101"
            Background="#99000000"
            IsVisible="{Binding IsDeleteConfirmationVisible}">
            <Border
                MaxWidth="420"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{Binding DeleteConfirmTitle}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding DeleteConfirmTitle}" />
                    <TextBlock
                        Text="{Binding DeletePrompt}"
                        TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Classes="wide secondary"
                            Command="{Binding CancelDeleteCommand}"
                            Content="{Binding CancelText}" />
                        <Button
                            Grid.Column="1"
                            Classes="wide danger"
                            Command="{Binding ConfirmDeleteCommand}"
                            Content="{Binding DeleteText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
