<Application
    x:Class="TOTP.Avalonia.Mobile.MobileApp"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushFavoriteFilterBackground" Color="#FFF4C2" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterBackgroundActive" Color="#FFE89A" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterBorder" Color="#D4B95D" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterForeground" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterIcon" Color="#FABD62" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#0C1C33" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#10213F" />
                    <SolidColorBrush x:Key="BrushAccountItemBackground" Color="#10213F" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#1A2E4E" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#243C63" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#152744" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#CBDAF3" />
                    <SolidColorBrush x:Key="BrushTextBrand" Color="#AA3ADA" />
                    <SolidColorBrush x:Key="BrushTextSelection" Color="#97B0DF" />
                    <SolidColorBrush x:Key="BrushTextHighlight" Color="#87CE3E" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#1D3366" />
                    <SolidColorBrush x:Key="BrushControlBorder" Color="#2F5E9E" />
                    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#4C78B8" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#7D7FF4" />
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#9193FF" />
                    <SolidColorBrush x:Key="BrushAccentPressed" Color="#6A6CDF" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#EF5350" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#FFD166" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#87CE3E" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#9899FF" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDialogSurface" Color="#192B52" />
                    <SolidColorBrush x:Key="BrushRecentAccountHighlight" Color="#66FFD54F" />
                    <SolidColorBrush x:Key="BrushCountdownIndicator" Color="#0078D4" />
                    <SolidColorBrush x:Key="BrushCountdownTrack" Color="#45546A" />
                    <SolidColorBrush x:Key="BrushCountdownExpiring" Color="#F44336" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterBackground" Color="#40361F" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterBackgroundActive" Color="#514526" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterBorder" Color="#8A7139" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterForeground" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="BrushFavoriteFilterIcon" Color="#FFD58A" />
                    <BoxShadows x:Key="ElevationCard">0 2 8 0 #40000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TOTP.UI.Avalonia.Shared/Styles/SharedStyles.axaml" />
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.icon-action">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Width" Value="52" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon-action:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
        </Style>
        <Style Selector="Button.icon-action:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ToggleButton.favorites-filter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFavoriteFilterForeground}" />
        </Style>
        <Style Selector="ToggleButton.favorites-filter:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.favorites-filter:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.favorites-filter:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.favorites-filter:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.favorite-group-card">
            <Setter Property="Background" Value="{DynamicResource BrushFavoriteFilterBackground}" />
        </Style>
        <Style Selector="Border.favorite-group-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushFavoriteFilterBackgroundActive}" />
        </Style>
        <Style Selector="Border.favorite-group-card.selected">
            <Setter Property="Background" Value="{DynamicResource BrushFavoriteFilterBackgroundActive}" />
        </Style>
        <Style Selector="Border.group-card">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.group-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.account-group.selected">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.numeric-clear">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="NumericUpDown.mobile-period">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown.mobile-period /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
        <Style Selector="Button.language-option.selected">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
        </Style>
        <Style Selector="Button.language-option.selected:disabled">
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
