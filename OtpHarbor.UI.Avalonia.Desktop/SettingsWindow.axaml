<Window
    x:Class="TOTP.Avalonia.Desktop.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    xmlns:storage="using:TOTP.Avalonia.Shared.Storage"
    xmlns:about="using:TOTP.Avalonia.Shared.About"
    x:Name="SettingsRoot"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource Settings}"
    Width="900"
    Height="720"
    MinWidth="520"
    MinHeight="480"
    CanResize="True"
    Background="Transparent"
    BorderThickness="0"
    CornerRadius="18"
    TransparencyLevelHint="Transparent"
    Win32Properties.WindowCornerPreference="DoNotRound"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    WindowStartupLocation="Manual">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseSettingsCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ControlTheme x:Key="SecurityUnlockChoiceTheme" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" BorderBrush="{DynamicResource BrushControlBorderHover}" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="ChoiceCheck" Width="10" Height="10" Fill="{DynamicResource BrushAccent}" IsVisible="False" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Border#ChoiceSurface">
                    <Setter Property="Background" Value="{DynamicResource BrushAccountItemSelectedBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                </Style>
                <Style Selector="^:checked /template/ Ellipse#ChoiceCheck"><Setter Property="IsVisible" Value="True" /></Style>
                <Style Selector="^:pointerover /template/ Border#ChoiceSurface"><Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" /></Style>
                <Style Selector="^:focus-visible /template/ Border#ChoiceSurface"><Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" /></Style>
                <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.6" /></Style>
            </ControlTheme>
            <ControlTheme x:Key="QrScaleSpinner" TargetType="ButtonSpinner">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource BrushSurface}" ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <RepeatButton x:Name="PART_DecreaseButton" Width="44" MinWidth="44" MinHeight="44" Padding="8"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              automation:AutomationProperties.Name="{DynamicResource DecreaseQrScale}">
                                    <PathIcon Width="16" Height="16" Data="M1,7 H15 V9 H1 Z" />
                                </RepeatButton>
                                <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                <RepeatButton x:Name="PART_IncreaseButton" Grid.Column="2" Width="44" MinWidth="44" MinHeight="44" Padding="8"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              automation:AutomationProperties.Name="{DynamicResource IncreaseQrScale}">
                                    <shared:SymbolIcon Kind="Add" IconSize="16" />
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
            <ControlTheme x:Key="SettingsNavigationItem" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border x:Name="NavigationPill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
            <ControlTheme x:Key="SettingsNavigation" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="SettingsNavigationRail" BorderBrush="{DynamicResource BrushControlBorder}"
                                    BorderThickness="0,0,1,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                            <Panel Grid.Column="1" Margin="20,0,0,0" ClipToBounds="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost2" IsVisible="False"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                            </Panel>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
            <!-- The popup uses a separate visual root; its surfaces belong in the control template. -->
            <ControlTheme x:Key="SettingsChoiceTheme" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,32">
            <Border x:Name="Background"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{DynamicResource ComboBoxThemeMinWidth}" />
            <Border x:Name="HighlightBackground"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource ComboBoxBackgroundUnfocused}"
                    BorderBrush="{DynamicResource ComboBoxBackgroundBorderBrushUnfocused}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False" />
            <TextBlock x:Name="PlaceholderTextBlock"
                       Grid.Column="0"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Opacity="{DynamicResource TextControlPlaceholderOpacity}"
                       Margin="{TemplateBinding Padding}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <ContentControl x:Name="ContentPresenter"
                            Content="{TemplateBinding SelectionBoxItem}"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}">
            </ContentControl>

            <TextBox Name="PART_EditableTextBox"
                     Grid.Column="0"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="Transparent"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     BorderThickness="0"
                     IsVisible="{TemplateBinding IsEditable}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>

            <Border x:Name="DropDownOverlay"
                    Grid.Column="1"
                    Background="Transparent"
                    Margin="0,1,1,1"
                    Width="30"
                    IsVisible="False"
                    HorizontalAlignment="Right" />

            <PathIcon x:Name="DropDownGlyph"
                      Grid.Column="1"
                      UseLayoutRounding="False"
                      IsHitTestVisible="False"
                      Height="12"
                      Width="12"
                      Margin="0,0,10,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}"
                      Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />

            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border x:Name="PopupBorder"
                      Background="{DynamicResource BrushSurface}"
                      BorderBrush="{DynamicResource BrushControlBorder}"
                      BorderThickness="1"
                      Padding="4"
                      HorizontalAlignment="Stretch"
                      CornerRadius="{DynamicResource RadiusSmall}">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              IsScrollChainingEnabled="False"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Margin="{DynamicResource ComboBoxDropdownContentMargin}"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
            </ControlTheme>
            <ControlTheme x:Key="SettingsChoiceItemTheme" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
                <Setter Property="Padding" Value="10,7" />
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                </Style>
                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource BrushAccountItemSelectedBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                </Style>
                <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter, ^:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                </Style>
            </ControlTheme>
            <DataTemplate x:Key="DiagnosticSummaryItemTemplate" x:DataType="presentation:DiagnosticSummaryItem">
                <Grid ColumnSpacing="10" Margin="0,4" MinHeight="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiagnosticLabels" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <shared:SymbolIcon Kind="{Binding Icon}" IconSize="17" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" Classes="diagnostic-label" MaxWidth="110"
                               Text="{Binding Label}" TextWrapping="Wrap" />
                    <SelectableTextBlock Grid.Column="2" Classes="diagnostic-value"
                                         Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="BrushFaqHeaderBackground" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Expander.backup-health">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowDefinitions="Auto,Auto">
                            <ToggleButton x:Name="BackupHealthHeader" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                          Padding="16,12" MinHeight="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                          Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" CornerRadius="9">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Border x:Name="BackupHealthHeaderBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter x:Name="BackupHealthHeaderContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                                    <Path x:Name="BackupHealthChevron" Grid.Column="1" Width="12" Height="7" Data="M1,1 L6,6 L11,1" Stretch="Uniform" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="ExpanderContent" Grid.Row="1" IsVisible="{TemplateBinding IsExpanded}" Padding="16,0,16,16">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                                    <Border Height="1" Background="{DynamicResource BrushControlBorder}" />
                                    <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Expander.backup-health[IsExpanded=true] /template/ Path#BackupHealthChevron">
            <Setter Property="RenderTransform"><RotateTransform Angle="180" /></Setter>
        </Style>
        <Style Selector="Expander.backup-health /template/ ToggleButton#BackupHealthHeader:checked /template/ Border#BackupHealthHeaderBackground">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Expander.backup-health /template/ ToggleButton#BackupHealthHeader:pointerover /template/ Border#BackupHealthHeaderBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
        </Style>
        <Style Selector="Expander.backup-health /template/ ToggleButton#BackupHealthHeader:pressed /template/ Border#BackupHealthHeaderBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>
        <Style Selector="Expander.backup-health /template/ ToggleButton#BackupHealthHeader:focus-visible /template/ Border#BackupHealthHeaderBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Border.backup-health-badge"><Setter Property="Background" Value="{DynamicResource BrushTextSecondary}" /></Style>
        <Style Selector="Border.backup-health-badge.healthy"><Setter Property="Background" Value="{DynamicResource BrushSuccess}" /></Style>
        <Style Selector="Border.backup-health-badge.failed"><Setter Property="Background" Value="{DynamicResource BrushDanger}" /></Style>
        <Style Selector="Ellipse.backup-access"><Setter Property="Fill" Value="{DynamicResource BrushTextSecondary}" /></Style>
        <Style Selector="Ellipse.backup-access.available"><Setter Property="Fill" Value="{DynamicResource BrushSuccess}" /></Style>
        <Style Selector="Ellipse.backup-access.unavailable"><Setter Property="Fill" Value="{DynamicResource BrushDanger}" /></Style>
        <Style Selector="Grid#AutomaticBackupHealthValues TextBlock"><Setter Property="FontSize" Value="14" /></Style>
        <Style Selector="Grid#AutomaticBackupHealthValues"><Setter Property="MaxWidth" Value="520" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <Style Selector="Button#AutomaticBackupNowButton">
            <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.RowSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <ContainerQuery Name="backup-health" Query="max-width:560">
            <Style Selector="Grid#AutomaticBackupHealthValues"><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
            <Style Selector="TextBlock#AutomaticBackupHealthFailure"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="Button#AutomaticBackupNowButton"><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Grid.RowSpan" Value="1" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        </ContainerQuery>
        <Style Selector="StackPanel#AutomaticBackupLocationSection:disabled"><Setter Property="Opacity" Value="0.6" /></Style>
        <Style Selector="ItemsControl#AboutSecondaryDetails"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="Border#AboutRowDivider"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Button#AboutViewCreditsButton"><Setter Property="Grid.Column" Value="2" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
        <Style Selector="Grid#AboutUpdateStatus"><Setter Property="Grid.Column" Value="2" /></Style>
        <ContainerQuery Name="about-content" Query="max-width:600">
            <Style Selector="Grid#AboutUpdateContent"><Setter Property="RowSpacing" Value="12" /></Style>
            <Style Selector="Grid#AboutCreditsContent"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="Border#AboutUpdateDivider"><Setter Property="IsVisible" Value="False" /></Style>
            <Style Selector="Grid#AboutUpdateStatus"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Button#AboutViewCreditsButton"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        </ContainerQuery>
        <ContainerQuery Name="about-diagnostics-summary" Query="max-width:600">
            <Style Selector="ItemsControl#AboutPrimaryDetails"><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="ItemsControl#AboutSecondaryDetails"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Border#AboutColumnDivider"><Setter Property="IsVisible" Value="False" /></Style>
            <Style Selector="Border#AboutRowDivider"><Setter Property="IsVisible" Value="True" /></Style>
        </ContainerQuery>

        <Style Selector="StackPanel#SupportSettingsPanel Border.settings-card"><Setter Property="Padding" Value="16,14" /></Style>
        <Style Selector="Border.support-icon-badge">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBox#MinimumLoggingLevelPicker"><Setter Property="Grid.Column" Value="1" /></Style>
        <Style Selector="WrapPanel#DiagnosticLogActions"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="Button#ReportOnGitHubButton"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.RowSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
        <ContainerQuery Name="support-content" Query="max-width:760">
            <Style Selector="Grid#SupportLogControls"><Setter Property="RowSpacing" Value="12" /></Style>
            <Style Selector="Grid#SupportLogLevelRow"><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Border#DiagnosticLogActionDivider"><Setter Property="IsVisible" Value="False" /></Style>
            <Style Selector="WrapPanel#DiagnosticLogActions"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Grid#SupportReportHeading, Border#SupportReportWarning"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="Button#ReportOnGitHubButton"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.RowSpan" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        </ContainerQuery>
        <ContainerQuery Name="support-content" Query="max-width:520">
            <Style Selector="Grid#SupportLogLevelRow"><Setter Property="RowSpacing" Value="8" /></Style>
            <Style Selector="TextBlock#SupportLogLevelLabel"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="ComboBox#MinimumLoggingLevelPicker"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="WrapPanel#DiagnosticLogActions Button"><Setter Property="Margin" Value="0,0,8,8" /></Style>
        </ContainerQuery>
        <Style Selector="Button#EncryptedBackupExportButton"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="CheckBox#OpenExportAfterCheckBox"><Setter Property="Grid.Column" Value="3" /><Setter Property="MaxWidth" Value="160" /></Style>
        <Style Selector="StackPanel#AutomaticBackupToggleRow"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="RadioButton#LocalBackupLocationChoice"><Setter Property="Grid.Column" Value="1" /></Style>
        <Style Selector="RadioButton#NetworkBackupLocationChoice"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="Button#ChangeAutomaticBackupFolderButton"><Setter Property="Grid.Column" Value="1" /></Style>
        <ContainerQuery Name="data-backup-content" Query="max-width:760">
            <Style Selector="Grid#ManualBackupRow"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="CheckBox#OpenExportAfterCheckBox"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="MaxWidth" Value="Infinity" /></Style>
        </ContainerQuery>
        <ContainerQuery Name="data-backup-content" Query="max-width:560">
            <Style Selector="Button#EncryptedBackupExportButton"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /></Style>
            <Style Selector="CheckBox#OpenExportAfterCheckBox"><Setter Property="Grid.Row" Value="2" /></Style>
            <Style Selector="Grid#AutomaticBackupSummaryRow, Grid#AutomaticBackupLocationKindRow, Grid#AutomaticBackupPathRow"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="StackPanel#AutomaticBackupToggleRow"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /></Style>
            <Style Selector="RadioButton#LocalBackupLocationChoice"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="RadioButton#NetworkBackupLocationChoice"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Grid#AutomaticBackupLocationKindRow > TextBlock"><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
            <Style Selector="Grid#AutomaticBackupPathRow > Border"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="Button#ChangeAutomaticBackupFolderButton"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /></Style>
        </ContainerQuery>
        <Style Selector="Button#MasterPasswordChangeButton"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
        <Style Selector="Grid#UnlockMethodChoices, Grid.security-password-field"><Setter Property="RowSpacing" Value="0" /></Style>
        <Style Selector=":is(Control).security-row-input"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector=":is(Control).security-password-input"><Setter Property="Grid.Column" Value="1" /></Style>
        <Style Selector="RadioButton#PasswordUnlockChoice"><Setter Property="Grid.Column" Value="1" /></Style>

        <Style Selector="Grid.settings-page shared|SymbolIconLabel">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <shared:SymbolIcon Kind="{TemplateBinding Kind}" IconSize="{TemplateBinding IconSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown#AppearanceQrScalePicker /template/ ButtonSpinner">
            <Setter Property="Theme" Value="{StaticResource QrScaleSpinner}" />
        </Style>
        <Style Selector="NumericUpDown#AppearanceQrScalePicker /template/ TextBox#PART_TextBox:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="NumericUpDown#AppearanceQrScalePicker /template/ TextBox#PART_TextBox:pointerover:not(:focus) /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TabControl#SettingsCategories /template/ Border#SettingsNavigationRail">
            <Setter Property="Width" Value="172" />
            <Setter Property="Padding" Value="0,8,12,0" />
        </Style>
        <Style Selector="Button#BrandIconsResetButton"><Setter Property="Grid.Column" Value="1" /></Style>
        <Style Selector="Grid#BrandIconActions"><Setter Property="RowSpacing" Value="0" /></Style>
        <Style Selector="Grid#BrandIconActions Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Button#BrandIconsImportButton"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
        <Style Selector="Grid#BrandIconActions.installed Button#BrandIconsImportButton"><Setter Property="Grid.ColumnSpan" Value="1" /></Style>
        <Style Selector=":is(Control).settings-row-input"><Setter Property="Grid.Column" Value="2" /></Style>
        <Style Selector="TabControl#SettingsCategories TabItem">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TabControl#SettingsCategories TabItem TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        </Style>
        <Style Selector="TabControl#SettingsCategories TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
        </Style>
        <Style Selector="TabControl#SettingsCategories TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
        </Style>
        <Style Selector="TabControl#SettingsCategories TabItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        </Style>
        <Style Selector="TabControl#SettingsCategories TabItem:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Grid.settings-page Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Grid.settings-page Border.settings-card-header">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="11,11,0,0" />
            <Setter Property="Padding" Value="18,12" />
        </Style>
        <Style Selector="Grid.settings-page TextBlock.settings-card-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel#AppearanceSettingsPanel TextBlock.settings-card-title, StackPanel#BrandIconsPanel TextBlock.settings-card-title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        </Style>
        <Style Selector="StackPanel#AppearanceSettingsPanel TextBlock.settings-page-title, StackPanel#BrandIconsPanel TextBlock.settings-page-title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        </Style>
        <Style Selector="Grid.settings-page TextBlock.settings-row-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Grid.settings-page TextBlock.settings-help">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Grid.settings-row">
            <Setter Property="Margin" Value="18,12" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="RowSpacing" Value="0" />
        </Style>
        <Style Selector="Grid.settings-page ComboBox.settings-choice">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Grid.settings-page ToggleSwitch.settings-switch">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
        </Style>
        <Style Selector="ToggleSwitch.settings-switch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="ToggleSwitch.settings-switch /template/ Grid > Grid"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="ToggleSwitch.settings-switch:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        </Style>
        <Style Selector="ToggleSwitch.settings-switch:pressed /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
        </Style>
        <ContainerQuery Name="settings-shell" Query="max-width:720">
            <Style Selector="TabControl#SettingsCategories /template/ Border#SettingsNavigationRail">
                <Setter Property="Width" Value="144" />
                <Setter Property="Padding" Value="0,8,8,0" />
            </Style>
            <Style Selector="TabControl#SettingsCategories TabItem">
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style Selector="TabControl#SettingsCategories TabItem TextBlock:not(.settings-page-title)">
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="security-content" Query="max-width:520">
            <Style Selector="Grid.security-choice-row, Grid#UnlockMethodChoices"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="Grid.security-password-field"><Setter Property="RowSpacing" Value="6" /></Style>
            <Style Selector="Button#MasterPasswordChangeButton"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
            <Style Selector="Grid.security-choice-row StackPanel.security-row-text"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="Grid.security-choice-row :is(Control).security-row-input">
                <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector=":is(Control).security-password-input"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="TextBlock.security-password-label"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="RadioButton#PasswordUnlockChoice"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
            <Style Selector="RadioButton#BiometricUnlockChoice"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
        </ContainerQuery>
        <ContainerQuery Name="appearance-content" Query="max-width:520">
            <Style Selector="Grid.settings-choice-row"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="Grid.settings-choice-row StackPanel.settings-row-text">
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="Grid.settings-choice-row :is(Control).settings-row-input">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="icon-pack-content" Query="max-width:560">
            <Style Selector="Grid#BrandIconActions.installed"><Setter Property="RowSpacing" Value="10" /></Style>
            <Style Selector="Grid#BrandIconActions.installed Button#BrandIconsImportButton, Grid#BrandIconActions Button#BrandIconsImportButton, Grid#BrandIconActions Button#BrandIconsResetButton">
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="Button#BrandIconsResetButton">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="1" />
            </Style>
        </ContainerQuery>
        <Style Selector="Border#InstalledIconPackCard">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#InstalledIconPackCard.installed">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:0.22" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Expander.settings-disclosure">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Expander.settings-disclosure /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
        </Style>
        <Style Selector="Expander.settings-disclosure /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
        </Style>
        <Style Selector="Expander.settings-disclosure /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>
        <Style Selector="Expander.settings-disclosure /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>
        <Style Selector="TextBox#DiagnosticsDetailsText /template/ Border#PART_BorderElement, TextBox#DiagnosticsDetailsText:pointerover /template/ Border#PART_BorderElement, TextBox#DiagnosticsDetailsText:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.settings-choice, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource">
            <Setter Property="Theme" Value="{StaticResource SettingsChoiceTheme}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsChoiceItemTheme}" />
        </Style>
        <Style Selector="ComboBox.settings-choice:pointerover /template/ Border#Background, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
        </Style>
        <Style Selector="ComboBox.settings-choice:pressed /template/ Border#Background, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>
        <Style Selector="ComboBox.settings-choice /template/ Border#HighlightBackground, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="ComboBox.settings-choice /template/ ContentControl#ContentPresenter, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="ComboBox.settings-choice /template/ PathIcon#DropDownGlyph, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="ComboBox.settings-choice /template/ TextBlock#PlaceholderTextBlock, ContentControl#ImportExportSettingsHost ComboBox#ExportHelpSource /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="ContentControl#ImportExportSettingsHost Button.wide">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.diagnostic-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="SelectableTextBlock.diagnostic-value">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ItemsControl#DiagnosticsSecondaryDetails">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Border#DiagnosticsRowDivider">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <ContainerQuery Name="diagnostics-summary" Query="max-width:600">
            <Style Selector="ItemsControl#DiagnosticsPrimaryDetails">
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector="ItemsControl#DiagnosticsSecondaryDetails">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="2" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector="Border#DiagnosticsColumnDivider">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Border#DiagnosticsRowDivider">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ContainerQuery>
        <Style Selector="Button.settings-action">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="Button.settings-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Button.settings-action:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Button.settings-action.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
        </Style>
        <Style Selector="Button.settings-action.secondary:pointerover"><Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" /></Style>
        <Style Selector="Button.settings-action.secondary:pressed"><Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" /></Style>
        <Style Selector="Expander.faq-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.faq-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.faq-card.expanded">
            <Setter Property="Background" Value="{DynamicResource BrushFaqContentBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="Border.faq-icon-badge, Border.faq-page-icon-badge">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.faq-page-icon-badge"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /></Style>
        <Style Selector="TextBlock.faq-question">
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.faq-answer TextBlock.secondary">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" /><Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="Expander.faq-section /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Expander.faq-subsection">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border#MasterPasswordSettingsPanel.editing">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
        </Style>
    </Window.Styles>

    <Border x:Name="SettingsWindowFrame" CornerRadius="{Binding CornerRadius, ElementName=SettingsRoot}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" Background="{DynamicResource BrushWindowBackground}">
    <Grid
        x:Name="SettingsWindowSurface"
        Background="{DynamicResource BrushWindowBackground}"
        Container.Name="settings-shell" Container.Sizing="Width"
        PointerPressed="MoveWindow">
        <Grid
            Margin="18"
            Classes="settings-page"
            RowDefinitions="Auto,*">
            <Grid MinHeight="40" ColumnDefinitions="*,Auto">
                <Border
                    Grid.Column="0"
                    Background="Transparent">
                    <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Text="{DynamicResource Settings}" />
                </Border>
                <Button
                    Grid.Column="1"
                    automation:AutomationProperties.Name="{DynamicResource CloseSettings}"
                    Classes="icon"
                    Command="{Binding CloseSettingsCommand}"
                    ToolTip.Tip="{DynamicResource CloseSettings}">
                    <shared:SymbolIcon IconSize="18" Kind="Close" />
                </Button>
            </Grid>
            <TabControl
                Grid.Row="1"
                Margin="0,8,0,0"
                x:Name="SettingsCategories" Classes="settings-tabs"
                Theme="{StaticResource SettingsNavigation}"
                ItemContainerTheme="{StaticResource SettingsNavigationItem}"
                TabStripPlacement="Left"
                SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="Palette" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Appearance}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ContentControl x:Name="AppearanceSettingsHost" Content="{Binding SettingsPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                <ScrollViewer x:Name="AppearanceSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="AppearanceSettingsPanel" Container.Name="appearance-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                            <shared:SymbolIcon Kind="Palette" IconSize="32" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Classes="settings-page-title" FontWeight="Bold" Text="{DynamicResource Appearance}" TextWrapping="Wrap" />
                                                <TextBlock Classes="settings-help" Text="{DynamicResource AppearanceDescription}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="AppearancePersonalizationCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Sliders" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource AppearancePersonalization}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="AppearanceLanguagePanel" Classes="settings-row settings-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="Globe" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource Language}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource AppearanceLanguageHelp}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="AppearanceLanguagePicker" Classes="settings-choice settings-row-input" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource Language}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="localization:LanguageOption">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Image Width="24" Height="18" Source="{Binding Icon}" Stretch="Uniform" />
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <Border Height="1" Margin="18,0" Background="{DynamicResource BrushControlBorder}" />
                                                <Grid x:Name="AppearanceThemePanel" Classes="settings-row settings-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="Monitor" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource Theme}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource AppearanceThemeHelp}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="AppearanceThemePicker" Classes="settings-choice settings-row-input" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource Theme}" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="presentation:SettingsPageViewModel+ThemeOption">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                    <shared:SymbolIcon Kind="{Binding Icon}" IconSize="20" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AppearanceAccountDisplayCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Codes" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource AppearanceAccountDisplay}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="AppearanceNextTokenPanel" Classes="settings-row" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="Timer" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource ShowNextToken}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource ShowNextTokenHelp}" />
                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="AppearanceNextTokenSwitch" Grid.Column="2" Classes="settings-switch" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource ShowNextToken}" IsChecked="{Binding ShowNextToken, Mode=TwoWay}" />
                                                </Grid>
                                                <Border Height="1" Margin="18,0" Background="{DynamicResource BrushControlBorder}" />
                                                <Grid x:Name="AppearanceIssuerLogoPanel" Classes="settings-row" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="ImageStack" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource ShowIssuerLogo}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource ShowIssuerLogoHelp}" />
                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="AppearanceIssuerLogoSwitch" Grid.Column="2" Classes="settings-switch" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource ShowIssuerLogo}" IsChecked="{Binding ShowIssuerLogo, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AppearanceQrPreviewCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="QrCode" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource AppearanceQrDisplay}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="AppearanceQrPreviewPanel" Classes="settings-row settings-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="ZoomIn" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource QrPreviewScale}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource QrPreviewScaleHelp}" />
                                                    </StackPanel>
                                                    <StackPanel Classes="settings-row-input" VerticalAlignment="Center" Spacing="5">
                                                        <NumericUpDown x:Name="AppearanceQrScalePicker" Increment="0.5" Maximum="6" Minimum="1" FormatString="0.0×" FontSize="{DynamicResource FontSizeTitle}" Padding="8,4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center" automation:AutomationProperties.Name="{DynamicResource QrPreviewScale}" Value="{Binding QrPreviewScaleFactor, Mode=TwoWay}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource QrPreviewScaleRange}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AppearanceInterfaceScaleCard" Classes="settings-card" IsVisible="{Binding IsInterfaceScaleAvailable}">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Monitor" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource InterfaceScale}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="AppearanceInterfaceScalePanel" Classes="settings-row settings-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="Monitor" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource InterfaceScale}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource InterfaceScaleHelp}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="AppearanceInterfaceScalePicker" Classes="settings-choice settings-row-input" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource InterfaceScale}" ItemsSource="{Binding InterfaceScales}" SelectedItem="{Binding SelectedInterfaceScale, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="presentation:SettingsPageViewModel+InterfaceScaleOption">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="ImageStack" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource IconPacks}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ContentControl x:Name="BrandIconSettingsHost" Content="{Binding SettingsPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="BrandIconsPanel" Container.Name="icon-pack-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                            <shared:SymbolIcon Kind="ImageStack" IconSize="32" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Classes="settings-page-title" FontWeight="Bold" Text="{DynamicResource IconPacks}" TextWrapping="Wrap" />
                                                <TextBlock Classes="settings-help" Text="{DynamicResource IconPackDescription}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="InstalledIconPackCard" Classes="settings-card" Classes.installed="{Binding DataContext.NativeFilePicker.HasImportedBrandIcons, ElementName=SettingsRoot}">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Layers" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource InstalledIconPack}" />
                                                    </Grid>
                                                </Border>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" Margin="18,16">
                                                    <Border Width="64" Height="56" CornerRadius="10" Background="{DynamicResource BrushSurfaceAlternate}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1">
                                                        <shared:SymbolIcon Kind="Layers" IconSize="32" Foreground="{DynamicResource BrushAccent}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                                        <TextBlock Classes="settings-row-label" Text="{Binding DataContext.NativeFilePicker.BrandIconPackStatusText, ElementName=SettingsRoot}" />
                                                        <shared:SymbolIconLabel Kind="Check" HorizontalAlignment="Left" Foreground="{DynamicResource BrushSuccess}" Text="{DynamicResource IconPackUsedLocally}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ManageIconPackCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Import" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource ManageIconPack}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="BrandIconActions" Classes.installed="{Binding DataContext.NativeFilePicker.HasImportedBrandIcons, ElementName=SettingsRoot}" Margin="18,16" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                    <Button x:Name="BrandIconsImportButton" Classes="settings-action" HorizontalAlignment="Stretch" Command="{Binding DataContext.NativeFilePicker.ImportBrandIconsCommand, ElementName=SettingsRoot}">
                                                        <shared:SymbolIconLabel Kind="Import" Text="{DynamicResource ImportIconPackAction}" />
                                                    </Button>
                                                    <Button x:Name="BrandIconsResetButton" Classes="secondary settings-action" HorizontalAlignment="Stretch" Command="{Binding DataContext.NativeFilePicker.ResetBrandIconsCommand, ElementName=SettingsRoot}" IsVisible="{Binding DataContext.NativeFilePicker.HasImportedBrandIcons, ElementName=SettingsRoot}">
                                                        <shared:SymbolIconLabel Kind="Delete" Text="{DynamicResource RemoveIconPackAction}" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="IconPackDisplayCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Sliders" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource IconPackDisplay}" />
                                                    </Grid>
                                                </Border>
                                                <Grid x:Name="IconPackIssuerLogoPanel" Classes="settings-row" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="ImageStack" IconSize="23" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="settings-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource ShowIssuerLogo}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource ShowIssuerLogoHelp}" />
                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="IconPackIssuerLogoSwitch" Grid.Column="2" Classes="settings-switch" VerticalAlignment="Center" automation:AutomationProperties.Name="{DynamicResource ShowIssuerLogo}" IsChecked="{Binding ShowIssuerLogo, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="IconPackAboutCard" Classes="settings-card">
                                            <StackPanel>
                                                <Border Classes="settings-card-header">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="Information" IconSize="22" />
                                                        <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource AboutIconPacks}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="18,14" Spacing="12">
                                                    <TextBlock Classes="settings-help" Text="{DynamicResource IconPackLocalHelp}" />
                                                    <HyperlinkButton HorizontalAlignment="Left" NavigateUri="https://github.com/Legends/otp-harbor-icon-pack-builder" Padding="0,3">
                                                        <shared:SymbolIconLabel Kind="ExternalLink" Text="{DynamicResource IconPackBuilderLink}" />
                                                    </HyperlinkButton>
                                                    <Expander Classes="settings-disclosure" Header="{DynamicResource IconPackRights}">
                                                        <StackPanel Spacing="12">
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource BrandIconsHelp}" />
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource IconPackResponsibility}" />
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource BrandIconsFormatHelp}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="ShieldCheck" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Security}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer x:Name="SecuritySettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="SecuritySettingsPanel" Container.Name="security-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                <shared:SymbolIcon Kind="ShieldCheck" IconSize="32" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Text="{DynamicResource Security}" TextWrapping="Wrap" />
                                    <TextBlock Classes="settings-help" Text="{DynamicResource SecurityDescription}" />
                                </StackPanel>
                            </Grid>
                            <ContentControl x:Name="AuthorizationSettingsHost" Content="{Binding AuthorizationSettings}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:AuthorizationSettingsViewModel">
                                        <StackPanel Spacing="12">
                                            <Border x:Name="AppLockSettingsPanel" Classes="settings-card">
                                                <StackPanel>
                                                    <Grid x:Name="AppLockSummaryRow" Classes="settings-row " ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                        <shared:SymbolIcon Kind="Lock" IconSize="26" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Classes="security-row-text" VerticalAlignment="Center" Spacing="4">
                                                            <TextBlock Classes="settings-row-label" Text="{DynamicResource AppLockTitle}" />
                                                            <TextBlock Classes="settings-help" Text="{Binding AppLockDescription}" />
                                                        </StackPanel>
                                                        <controls:CommandToggleSwitch x:Name="AppLockToggleButton" Grid.Column="2" Classes="settings-switch" VerticalAlignment="Center" automation:AutomationProperties.Name="{Binding AppLockActionText}" IsChecked="{Binding IsAppLockEnabled, Mode=OneWay}" Command="{Binding ToggleAppLockCommand}" />
                                                    </Grid>
                                                    <Border Margin="18,0,18,12" Padding="12" CornerRadius="8" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Classes="settings-row-label" Text="{DynamicResource SecurityUnlockMethod}" />
                                                            <Grid x:Name="UnlockMethodChoices" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" IsEnabled="{Binding IsAppLockEnabled}">
                                                                <controls:CommandRadioButton x:Name="BiometricUnlockChoice" VerticalAlignment="Stretch" Theme="{StaticResource SecurityUnlockChoiceTheme}" GroupName="StartupUnlockMethod" automation:AutomationProperties.Name="{DynamicResource SecurityQuickUnlockTitle}" Command="{Binding EnableQuickUnlockCommand}" IsChecked="{Binding IsQuickUnlockEnabled, Mode=OneWay}">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                        <shared:FingerprintIcon IconSize="28" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                                            <TextBlock Classes="settings-row-label" Text="{DynamicResource SecurityQuickUnlockTitle}" />
                                                                            <TextBlock Classes="settings-help" Text="{Binding QuickUnlockOptionHelp}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </controls:CommandRadioButton>
                                                                <controls:CommandRadioButton x:Name="PasswordUnlockChoice" VerticalAlignment="Stretch" Theme="{StaticResource SecurityUnlockChoiceTheme}" GroupName="StartupUnlockMethod" automation:AutomationProperties.Name="{DynamicResource SecurityPasswordOnly}" Command="{Binding UsePasswordCommand}" IsChecked="{Binding !IsQuickUnlockEnabled, Mode=OneWay}">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                        <shared:SymbolIcon Kind="Password" IconSize="28" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                                            <TextBlock Classes="settings-row-label" Text="{DynamicResource SecurityPasswordOnly}" />
                                                                            <TextBlock Classes="settings-help" Text="{DynamicResource SecurityPasswordOnlyHelp}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </controls:CommandRadioButton>
                                                            </Grid>
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource QuickUnlockUnavailable}" IsVisible="{Binding !IsQuickUnlockAvailable}" />
                                                            <Button Classes="settings-action" Command="{Binding RefreshCommand}" IsVisible="{Binding ShowQuickUnlockRetry}">
                                                                <shared:SymbolIconLabel Kind="Refresh" Text="{DynamicResource Retry}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid Margin="18,0,18,14" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <shared:SymbolIcon Kind="Information" IconSize="18" VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="1" Classes="settings-help" Text="{DynamicResource QuickUnlockRecoveryNotice}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MasterPasswordSettingsPanel" Classes="settings-card" Classes.editing="{Binding IsPasswordEditorOpen}">
                                                <controls:CollapsingContentControl ClipToBounds="True" x:Name="PasswordPanelTransition" Content="{Binding PasswordPresentation}" TransitionCompleted="PasswordPanelTransitionCompleted">
                                                    <controls:CollapsingContentControl.PageTransition>
                                                        <controls:CollapseThenFadeTransition />
                                                    </controls:CollapsingContentControl.PageTransition>
                                                    <controls:CollapsingContentControl.DataTemplates>
                                                        <DataTemplate DataType="{x:Type presentation:AuthorizationSettingsViewModel+PasswordSummaryPresentation}" x:DataType="presentation:AuthorizationSettingsViewModel+PasswordSummaryPresentation">
                                                            <ContentControl Content="{Binding Owner}">
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate x:DataType="presentation:AuthorizationSettingsViewModel">
                                                                        <Grid x:Name="MasterPasswordSummaryRow" Classes="settings-row security-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                                            <shared:SymbolIcon Kind="Password" IconSize="26" VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Column="1" Classes="security-row-text" VerticalAlignment="Center" Spacing="4">
                                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource MasterPassword}" />
                                                                                <TextBlock Classes="settings-help" Text="{DynamicResource SecurityMasterPasswordHelp}" />
                                                                            </StackPanel>
                                                                            <Button x:Name="MasterPasswordChangeButton" automation:AutomationProperties.Name="{DynamicResource ChangeMasterPassword}" Classes="settings-action security-row-input" Command="{Binding BeginPasswordChangeCommand}" Content="{DynamicResource SecurityChangePasswordAction}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                        <DataTemplate DataType="{x:Type presentation:AuthorizationSettingsViewModel+PasswordEditorPresentation}" x:DataType="presentation:AuthorizationSettingsViewModel+PasswordEditorPresentation">
                                                            <ContentControl Content="{Binding Owner}">
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate x:DataType="presentation:AuthorizationSettingsViewModel">
                                                                        <StackPanel x:Name="MasterPasswordEditor" IsEnabled="{Binding IsPasswordEditorEnabled}" Spacing="12">
                                                                            <Grid Margin="18,14,18,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                                <shared:SymbolIcon Kind="Password" IconSize="26" />
                                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                                    <TextBlock Classes="settings-card-title" Text="{DynamicResource ChangeMasterPassword}" />
                                                                                    <TextBlock Classes="settings-help" Text="{DynamicResource SecurityMasterPasswordHelp}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                            <StackPanel Margin="18,0,18,14" Spacing="12">
                                                                                <Grid Classes="security-password-field" ColumnDefinitions="3*,5*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                                                    <TextBlock Classes="settings-row-label security-password-label" VerticalAlignment="Center" Text="{DynamicResource SecurityCurrentMasterPassword}" />
                                                                                    <StackPanel Classes="security-password-input" Spacing="6">
                                                                                        <shared:RevealableSecretInput x:Name="CurrentMasterPasswordInput" AccessibleName="{DynamicResource SecurityCurrentMasterPassword}" PlaceholderText="{DynamicResource SecurityCurrentMasterPassword}" Text="{Binding CurrentPassword, Mode=TwoWay}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <Grid Classes="security-password-field" ColumnDefinitions="3*,5*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                                                    <TextBlock Classes="settings-row-label security-password-label" VerticalAlignment="Center" Text="{DynamicResource SecurityNewMasterPassword}" />
                                                                                    <StackPanel Classes="security-password-input" Spacing="6">
                                                                                        <shared:RevealableSecretInput x:Name="NewMasterPasswordInput" AccessibleName="{DynamicResource SecurityNewMasterPassword}" PlaceholderText="{DynamicResource SecurityNewMasterPassword}" Text="{Binding NewPassword, Mode=TwoWay}" />
                                                                                        <ProgressBar x:Name="PasswordLengthIndicator" Minimum="0" Maximum="{Binding PasswordMinimumLength}" Value="{Binding PasswordLengthProgress}" Height="5" Foreground="{DynamicResource BrushAccent}" automation:AutomationProperties.Name="{DynamicResource SecurityPasswordLengthRequirement}" />
                                                                                        <TextBlock x:Name="PasswordMinimumLengthHelp" Classes="settings-help" Text="{Binding PasswordMinimumLengthHelp}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <Grid Classes="security-password-field" ColumnDefinitions="3*,5*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                                                    <TextBlock Classes="settings-row-label security-password-label" VerticalAlignment="Center" Text="{DynamicResource SecurityConfirmMasterPassword}" />
                                                                                    <StackPanel Classes="security-password-input" Spacing="6">
                                                                                        <shared:RevealableSecretInput x:Name="ConfirmMasterPasswordInput" AccessibleName="{DynamicResource SecurityConfirmMasterPassword}" PlaceholderText="{DynamicResource SecurityConfirmMasterPassword}" Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                    <shared:SymbolIcon Kind="Information" IconSize="18" VerticalAlignment="Top" />
                                                                                    <TextBlock Grid.Column="1" Classes="settings-help" Text="{DynamicResource SecurityPasswordRotationNotice}" />
                                                                                </Grid>
                                                                                <Border Height="1" Background="{DynamicResource BrushControlBorder}" />
                                                                                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                                                    <Button x:Name="SaveMasterPasswordButton" Classes="settings-action" Margin="0,0,8,8" MinHeight="40" Command="{Binding ChangePasswordCommand}" Content="{DynamicResource SecuritySavePasswordAction}" />
                                                                                    <Button x:Name="CancelMasterPasswordButton" Classes="secondary settings-action" Margin="0,0,0,8" MinHeight="40" Command="{Binding CancelPasswordChangeCommand}" Content="{DynamicResource Cancel}" />
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </controls:CollapsingContentControl.DataTemplates>
                                                </controls:CollapsingContentControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="SecurityBehaviorSettingsHost" Content="{Binding SettingsPage}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                        <StackPanel Spacing="12">
                                            <Border x:Name="SecurityBehaviorSettings" Classes="settings-card" IsEnabled="{Binding DataContext.AuthorizationSettings.IsAppLockEnabled, ElementName=SettingsRoot}">
                                                <StackPanel>
                                                    <Grid x:Name="AutoLockSettingsRow" Classes="settings-row security-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                        <shared:SymbolIcon Kind="Timer" IconSize="26" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Classes="security-row-text" VerticalAlignment="Center" Spacing="4">
                                                            <WrapPanel>
                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource SecurityAutoLockTitle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AutoLockRequiresAppLockNotice" Text="{DynamicResource SecurityAutoLockRequiresAppLock}" Foreground="{DynamicResource BrushWarning}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding !IsEnabled, ElementName=SecurityBehaviorSettings}" />
                                                            </WrapPanel>
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource SecurityAutoLockHelp}" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="AutoLockSelector" Classes="settings-choice security-row-input" VerticalAlignment="Center" ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding SelectedAutoLock, Mode=TwoWay}" automation:AutomationProperties.Name="{DynamicResource SecurityAutoLockTitle}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="presentation:SettingsPageViewModel+AutoLockOption">
                                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <StackPanel Margin="56,0,18,14" Spacing="6">
                                                        <CheckBox IsChecked="{Binding LockOnMinimize, Mode=TwoWay}"><TextBlock Text="{DynamicResource LockWhenMinimized}" TextWrapping="Wrap" /></CheckBox>
                                                        <CheckBox IsChecked="{Binding LockOnSessionLock, Mode=TwoWay}"><TextBlock Text="{DynamicResource LockOnSessionLock}" TextWrapping="Wrap" /></CheckBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ClipboardBehaviorSettings" Classes="settings-card">
                                                <Grid x:Name="ClipboardSettingsRow" Classes="settings-row security-choice-row" ColumnDefinitions="Auto,3*,2*" RowDefinitions="Auto,Auto">
                                                    <shared:SymbolIcon Kind="Clipboard" IconSize="26" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="security-row-text" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="settings-row-label" Text="{DynamicResource SecurityClipboardTitle}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource SecurityClipboardHelp}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="ClipboardLifetimeSelector" Classes="settings-choice security-row-input" VerticalAlignment="Center" ItemsSource="{Binding ClipboardLifetimeOptions}" SelectedItem="{Binding SelectedClipboardLifetime, Mode=TwoWay}" automation:AutomationProperties.Name="{DynamicResource ClipboardClearSeconds}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="presentation:SettingsPageViewModel+ClipboardLifetimeOption">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="BackupRestore" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource MigrationDataAndBackup}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ContentControl
                        x:Name="ImportExportSettingsHost"
                        Content="{Binding NativeFilePicker}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                                <ScrollViewer x:Name="DataBackupSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="DataBackupSettingsPanel" Container.Name="data-backup-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                            <shared:SymbolIcon Kind="BackupRestore" IconSize="32" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Text="{DynamicResource MigrationDataAndBackup}" TextWrapping="Wrap" />
                                                <TextBlock Classes="settings-help" Text="{DynamicResource DataBackupDescription}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="ImportAccountsCard" Classes="settings-card" Padding="18,14">
                                            <controls:SettingsImportPanel DataContext="{Binding MigrationImport}" />
                                        </Border>
                                        <Border x:Name="BackupsSettingsCard" Classes="settings-card" Padding="14">
                                            <StackPanel Spacing="12">
                                                <StackPanel Margin="4,0" Spacing="6">
                                                    <TextBlock Classes="settings-card-title" Text="{DynamicResource DataBackupBackupsTitle}" />
                                                    <TextBlock Classes="settings-help" Text="{DynamicResource DataBackupHelp}" />
                                                </StackPanel>
                                                <Border x:Name="EncryptedBackupExportPanel" Classes="settings-card" Padding="14,12">
                                                    <StackPanel Spacing="10">
                                                        <Grid x:Name="ManualBackupRow" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                                                            <shared:SymbolIcon Kind="Export" IconSize="26" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource DataBackupManualTitle}" />
                                                                <TextBlock Classes="settings-help" Text="{DynamicResource DataBackupManualHelp}" />
                                                            </StackPanel>
                                                            <Button x:Name="EncryptedBackupExportButton" Classes="primary settings-action" HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="40" Command="{Binding ExportCommand}">
                                                                <shared:SymbolIconLabel Kind="Export" Text="{DynamicResource ExportBackupAction}" />
                                                            </Button>
                                                            <CheckBox x:Name="OpenExportAfterCheckBox" VerticalAlignment="Center"
                                                                IsChecked="{Binding DataContext.SettingsPage.OpenExportFileAfterExport, ElementName=SettingsRoot, Mode=TwoWay}">
                                                                <TextBlock Text="{DynamicResource OpenExportAfter}" TextWrapping="Wrap" />
                                                            </CheckBox>
                                                        </Grid>
                                                        <StackPanel IsVisible="{Binding HasLastBackupFolder}" Spacing="6">
                                                            <TextBlock Classes="settings-help" Text="{Binding BackupLocationText}" />
                                                            <Button x:Name="OpenLastBackupFolderButton" Classes="secondary settings-action" HorizontalAlignment="Left" MinHeight="40" Command="{Binding OpenLastBackupFolderCommand}">
                                                                <shared:SymbolIconLabel Kind="Folder" Text="{DynamicResource OpenLastBackupFolder}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="AutomaticBackupPanel" Classes="settings-card" Padding="14,12">
                                                    <StackPanel Spacing="12">
                                                        <Grid x:Name="AutomaticBackupSummaryRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                                                            <shared:SymbolIcon Kind="Calendar" IconSize="26" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource AutomaticBackups}" />
                                                                <TextBlock Classes="settings-help" Text="{DynamicResource DataBackupAutomaticHelp}" />
                                                            </StackPanel>
                                                            <StackPanel x:Name="AutomaticBackupToggleRow" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <controls:CommandToggleSwitch x:Name="AutomaticBackupToggle" Classes="settings-switch" IsChecked="{Binding IsAutomaticBackupConfigured, Mode=OneWay}" Command="{Binding ToggleAutomaticBackupCommand}" automation:AutomationProperties.Name="{DynamicResource AutomaticBackups}" />
                                                                <TextBlock Text="{Binding AutomaticBackupEnabledText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel x:Name="AutomaticBackupLocationSection" IsEnabled="{Binding IsAutomaticBackupConfigured}" Spacing="12">
                                                            <Border Height="1" Background="{DynamicResource BrushControlBorder}" />
                                                            <Grid x:Name="AutomaticBackupLocationKindRow" ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18">
                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource DataBackupLocation}" VerticalAlignment="Center" />
                                                                <RadioButton x:Name="LocalBackupLocationChoice" GroupName="BackupFolderMode" IsChecked="{Binding !UseNetworkBackupFolder, Mode=TwoWay}" MinHeight="40" automation:AutomationProperties.Name="{DynamicResource DataBackupLocalFolder}">
                                                                    <shared:SymbolIconLabel Kind="Folder" Text="{DynamicResource DataBackupLocalFolder}" />
                                                                </RadioButton>
                                                                <RadioButton x:Name="NetworkBackupLocationChoice" GroupName="BackupFolderMode" IsChecked="{Binding UseNetworkBackupFolder, Mode=TwoWay}" MinHeight="40" automation:AutomationProperties.Name="{DynamicResource DataBackupNetworkFolder}" ToolTip.Tip="{DynamicResource DataBackupNetworkHelp}">
                                                                    <shared:SymbolIconLabel Kind="Network" Text="{DynamicResource DataBackupNetworkFolder}" />
                                                                </RadioButton>
                                                            </Grid>
                                                            <TextBlock IsVisible="{Binding UseNetworkBackupFolder}" Classes="settings-help" Text="{DynamicResource DataBackupNetworkHelp}" />
                                                            <Grid x:Name="AutomaticBackupPathRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                                <Border Background="{DynamicResource BrushSurfaceAlternate}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                        <shared:SymbolIcon Kind="Folder" IconSize="20" VerticalAlignment="Center" />
                                                                        <SelectableTextBlock x:Name="AutomaticBackupFolderPath" Grid.Column="1" Text="{Binding AutomaticBackupFolderPath}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                                <Button x:Name="ChangeAutomaticBackupFolderButton" Classes="secondary settings-action" HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="40" Command="{Binding ConfigureAutomaticBackupCommand}">
                                                                    <shared:SymbolIconLabel Kind="Folder" Text="{DynamicResource DataBackupChange}" />
                                                                </Button>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <shared:SymbolIcon Kind="Information" IconSize="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                                <TextBlock Grid.Column="1" Classes="settings-help" Text="{DynamicResource DataBackupPasswordNotice}" />
                                                            </Grid>
                                                            <Expander x:Name="AutomaticBackupHealthDetails" Classes="backup-health" IsExpanded="{Binding HasAutomaticBackupFailure, Mode=OneWay}" Container.Name="backup-health" Container.Sizing="Width"
                                                                      automation:AutomationProperties.Name="{Binding AutomaticBackupHealthTitle}">
                                                                <Expander.Header>
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                                            <Border Classes="backup-health-badge" Classes.healthy="{Binding IsAutomaticBackupHealthy}" Classes.failed="{Binding HasAutomaticBackupFailure}" CornerRadius="16" Opacity="0.16" />
                                                                            <shared:SymbolIcon Kind="Check" IconSize="20" Foreground="{DynamicResource BrushSuccess}" IsVisible="{Binding IsAutomaticBackupHealthy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <shared:SymbolIcon Kind="Warning" IconSize="20" Foreground="{DynamicResource BrushDanger}" IsVisible="{Binding HasAutomaticBackupFailure}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <shared:SymbolIcon Kind="Information" IconSize="20" Foreground="{DynamicResource BrushTextSecondary}" IsVisible="{Binding IsAutomaticBackupHealthPending}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <TextBlock x:Name="AutomaticBackupHealthStatus" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Text="{Binding AutomaticBackupHealthTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Expander.Header>
                                                                <Grid x:Name="AutomaticBackupHealthBody" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                                                                    <Grid x:Name="AutomaticBackupHealthValues" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                                                                        <TextBlock Text="{DynamicResource AutomaticBackupLastSuccessLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <TextBlock x:Name="AutomaticBackupLastSuccessValue" Grid.Column="1" Text="{Binding AutomaticBackupLastSuccessValue}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Row="1" Text="{DynamicResource AutomaticBackupFolderAccessLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                            <Ellipse x:Name="AutomaticBackupAccessIndicator" Classes="backup-access" Classes.available="{Binding IsAutomaticBackupDestinationAvailable}" Classes.unavailable="{Binding IsAutomaticBackupDestinationUnavailable}" Width="10" Height="10" VerticalAlignment="Center" />
                                                                            <TextBlock x:Name="AutomaticBackupAccessValue" Grid.Column="1" Text="{Binding AutomaticBackupDestinationAccessValue}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Grid>
                                                                    <TextBlock x:Name="AutomaticBackupHealthFailure" Grid.Row="1" IsVisible="{Binding HasAutomaticBackupFailure}" Text="{Binding AutomaticBackupLastFailureText}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap" />
                                                                    <Button x:Name="AutomaticBackupNowButton" Classes="secondary settings-action" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="44" Command="{Binding AutomaticBackupNowCommand}">
                                                                        <shared:SymbolIconLabel Kind="BackupRestore" Text="{Binding AutomaticBackupActionText}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Expander>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="Diagnostics" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Miscellaneous}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer x:Name="SupportSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="SupportSettingsPanel" Container.Name="support-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                <Border Classes="support-icon-badge" Width="44" Height="44">
                                    <shared:SymbolIcon Kind="Diagnostics" IconSize="26" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Text="{DynamicResource Miscellaneous}" TextWrapping="Wrap" />
                                    <TextBlock Classes="settings-help" Text="{DynamicResource SupportDescription}" />
                                </StackPanel>
                            </Grid>
                            <ContentControl x:Name="MiscSettingsHost" Content="{Binding SettingsPage}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                        <StackPanel Spacing="12">
                                            <Border x:Name="MiscSettingsPanel" Classes="settings-card">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <Border Classes="support-icon-badge"><shared:SymbolIcon Kind="Mail" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                            <TextBlock Classes="settings-card-title" Text="{DynamicResource SupportLogsTitle}" />
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource SupportLogsHelp}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid x:Name="SupportLogControls" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                                        <Grid x:Name="SupportLogLevelRow" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                            <TextBlock x:Name="SupportLogLevelLabel" Classes="settings-row-label" Text="{DynamicResource LoggingLevel}" VerticalAlignment="Center" />
                                                            <ComboBox x:Name="MinimumLoggingLevelPicker" Classes="settings-choice" MinWidth="132" MaxWidth="180" MinHeight="40" HorizontalAlignment="Left"
                                                                      ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                                                                      automation:AutomationProperties.Name="{DynamicResource LoggingLevel}">
                                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="presentation:SettingsPageViewModel+LogLevelOption"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                        <Border x:Name="DiagnosticLogActionDivider" Grid.Column="1" Width="1" Background="{DynamicResource BrushControlBorder}" />
                                                        <WrapPanel x:Name="DiagnosticLogActions" Orientation="Horizontal" HorizontalAlignment="Left">
                                                            <Button x:Name="EmailDiagnosticLogButton" Classes="primary settings-action" MinHeight="40" HorizontalAlignment="Left" Margin="0,0,12,0" Command="{Binding EmailDiagnosticLogCommand}">
                                                                <shared:SymbolIconLabel Kind="Mail" Text="{DynamicResource EmailDiagnosticLog}" />
                                                            </Button>
                                                            <Button x:Name="OpenLogFolderButton" Classes="secondary settings-action" MinHeight="40" HorizontalAlignment="Left" Command="{Binding OpenLogFolderCommand}">
                                                                <shared:SymbolIconLabel Kind="Folder" Text="{DynamicResource OpenLogFolder}" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <shared:SymbolIcon Kind="Information" IconSize="18" VerticalAlignment="Top" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        <TextBlock Grid.Column="1" Classes="settings-help" Text="{DynamicResource SupportLogsNotice}" ToolTip.Tip="{DynamicResource DiagnosticLogSharingNotice}" />
                                                    </Grid>
                                                    <shared:NotificationBanner x:Name="SupportLogActionStatus" Text="{Binding LogFolderNotification.Text}" Severity="{Binding LogFolderNotification.Severity}" IsVisible="{Binding LogFolderNotification.HasMessage}" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ProblemReportSettingsPanel" Classes="settings-card">
                                                <Grid x:Name="SupportReportLayout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="10">
                                                    <Grid x:Name="SupportReportHeading" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <Border Classes="support-icon-badge"><shared:SymbolIcon Kind="ExternalLink" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Classes="settings-card-title" Text="{DynamicResource SupportReportTitle}" />
                                                            <TextBlock Classes="settings-help" Text="{DynamicResource SupportReportPublicHelp}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border x:Name="SupportReportWarning" Grid.Row="1" Background="{DynamicResource BrushAccountItemSelectedBackground}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <shared:SymbolIcon Kind="Warning" IconSize="20" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" />
                                                            <TextBlock Grid.Column="1" Classes="settings-help" Text="{DynamicResource SupportReportWarning}" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        </Grid>
                                                    </Border>
                                                    <Button x:Name="ReportOnGitHubButton" Classes="primary settings-action" MinHeight="40" VerticalAlignment="Center" Command="{Binding ReportOnGitHubCommand}">
                                                        <shared:SymbolIconLabel Kind="ExternalLink" Text="{DynamicResource ReportOnGitHub}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="SupportDiagnosticsHost" Content="{Binding Diagnostics}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:DiagnosticsViewModel">
                                        <Border x:Name="SupportDiagnosticsPanel" Classes="settings-card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Classes="support-icon-badge">
                                                        <shared:SymbolIcon Kind="Layers" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Classes="settings-card-title" Text="{DynamicResource SupportDiagnostics}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource DiagnosticDescription}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" x:Name="RefreshDiagnosticsButton" Classes="icon secondary settings-action" Width="40" Height="40" Padding="0"
                                                            VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                                                            ToolTip.Tip="{DynamicResource RefreshSupportInformation}"
                                                            automation:AutomationProperties.Name="{DynamicResource RefreshSupportInformation}">
                                                        <shared:SymbolIcon Kind="Refresh" IconSize="16" />
                                                    </Button>
                                                </Grid>
                                                <Border x:Name="DiagnosticsSummaryBorder" Container.Name="diagnostics-summary" Container.Sizing="Width"
                                                        Background="{DynamicResource BrushSurfaceAlternate}"
                                                        BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="12">
                                                    <Grid x:Name="DiagnosticsSummaryColumns" ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto"
                                                          Grid.IsSharedSizeScope="True">
                                                        <ItemsControl x:Name="DiagnosticsPrimaryDetails" ItemsSource="{Binding PrimaryDetails}"
                                                                      ItemTemplate="{StaticResource DiagnosticSummaryItemTemplate}" />
                                                        <Border x:Name="DiagnosticsColumnDivider" Grid.Column="1" Width="1" Margin="14,0"
                                                                Background="{DynamicResource BrushControlBorder}" />
                                                        <Border x:Name="DiagnosticsRowDivider" Grid.Row="1" Grid.ColumnSpan="3"
                                                                Height="1" Margin="0,8" Background="{DynamicResource BrushControlBorder}" />
                                                        <ItemsControl x:Name="DiagnosticsSecondaryDetails" ItemsSource="{Binding SecondaryDetails}"
                                                                      ItemTemplate="{StaticResource DiagnosticSummaryItemTemplate}" />
                                                    </Grid>
                                                </Border>
                                                <Expander x:Name="DiagnosticsDetailsExpander" Classes="settings-disclosure">
                                                    <Expander.Header><TextBlock Text="{DynamicResource DiagnosticDetails}" TextWrapping="Wrap" /></Expander.Header>
                                                    <TextBox x:Name="DiagnosticsDetailsText" AcceptsReturn="True" IsReadOnly="True" MinHeight="100"
                                                             HorizontalAlignment="Stretch" Background="{DynamicResource BrushSurfaceAlternate}"
                                                             Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                             automation:AutomationProperties.Name="{DynamicResource DiagnosticDetails}"
                                                             Text="{Binding SupportInformation}" TextWrapping="Wrap" />
                                                </Expander>
                                                <shared:NotificationBanner x:Name="SupportDiagnosticsStatus" Text="{Binding Notification.Text}" Severity="{Binding Notification.Severity}" IsVisible="{Binding Notification.HasMessage}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="StorageLocationsHost" Content="{Binding SettingsPage.StorageLocations}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="storage:StorageLocationsViewModel">
                                        <Border x:Name="ApplicationDataSettingsPanel" Classes="settings-card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                    <Border Classes="support-icon-badge"><shared:SymbolIcon Kind="Folder" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                    <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource SupportApplicationDataTitle}" VerticalAlignment="Center" />
                                                </Grid>
                                                <controls:SettingsStorageLocationsPanel />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="Help" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Faq}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer x:Name="FaqSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="FaqSettingsPanel" Margin="4,8,4,4" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                                <Border Classes="faq-page-icon-badge"><shared:SymbolIcon Kind="Help" IconSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Text="{DynamicResource Faq}" TextWrapping="Wrap" />
                                    <TextBlock Classes="settings-help" Text="{DynamicResource FaqDescription}" />
                                </StackPanel>
                            </Grid>
                                <Border x:Name="FaqMasterPasswordRecoveryCard" Classes="faq-card" Classes.expanded="{Binding #FaqMasterPasswordRecoveryExpander.IsExpanded}">
                                    <Expander x:Name="FaqMasterPasswordRecoveryExpander" Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged" IsExpanded="True"
                                              Expanded="FaqSectionExpanded" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="Key" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqMasterPasswordRecoveryQuestion}" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                            <TextBlock Classes="secondary" Text="{DynamicResource FaqMasterPasswordRecoveryAnswer}" TextWrapping="Wrap" />
                                        </Border>
                                    </Expander>
                                </Border>
                                <Border x:Name="FaqOlderVaultsCard" Classes="faq-card" Classes.expanded="{Binding #FaqOlderVaultsExpander.IsExpanded}">
                                    <Expander x:Name="FaqOlderVaultsExpander" Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged"
                                              Expanded="FaqSectionExpanded" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="BackupRestore" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqOlderVaultsQuestion}" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                            <TextBlock Classes="secondary" Text="{DynamicResource FaqOlderVaultsAnswer}" TextWrapping="Wrap" />
                                        </Border>
                                    </Expander>
                                </Border>
                                <Border x:Name="FaqIconPacksCard" Classes="faq-card" Classes.expanded="{Binding #FaqIconPacksExpander.IsExpanded}">
                                    <Expander
                                        x:Name="FaqIconPacksExpander"
                                        Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="Folder" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqImportIconPacksQuestion}" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                            <StackPanel x:Name="IconPackFaqContent" Container.Name="icon-faq" Container.Sizing="Width" Spacing="14">
                                                <StackPanel.Styles>
                                                    <Style Selector="Border.icon-faq-step"><Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" /><Setter Property="Padding" Value="0,12,0,0" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
                                                    <Style Selector="Border.icon-faq-number"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="{DynamicResource BrushAccent}" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
                                                    <Style Selector="TextBlock.icon-faq-number-text"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                                    <Style Selector="HyperlinkButton.icon-faq-action"><Setter Property="Grid.Column" Value="2" /><Setter Property="MinHeight" Value="44" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
                                                    <Style Selector="HyperlinkButton.icon-faq-action"><Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
                                                    <Style Selector="HyperlinkButton.icon-faq-legal-link"><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
                                                    <Style Selector="HyperlinkButton.icon-faq-legal-second"><Setter Property="Grid.Column" Value="1" /></Style>
                                                    <Style Selector="HyperlinkButton.icon-faq-legal-third"><Setter Property="Grid.Column" Value="2" /></Style>
                                                    <ContainerQuery Name="icon-faq" Query="max-width:700">
                                                        <Style Selector="HyperlinkButton.icon-faq-action"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
                                                        <Style Selector="StackPanel.icon-faq-art"><Setter Property="IsVisible" Value="False" /></Style>
                                                    </ContainerQuery>
                                                    <ContainerQuery Name="icon-faq" Query="max-width:1000">
                                                        <Style Selector="HyperlinkButton.icon-faq-legal-link"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
                                                        <Style Selector="HyperlinkButton.icon-faq-legal-second"><Setter Property="Grid.Row" Value="1" /></Style>
                                                        <Style Selector="HyperlinkButton.icon-faq-legal-third"><Setter Property="Grid.Row" Value="2" /></Style>
                                                    </ContainerQuery>
                                                </StackPanel.Styles>
                                                <TextBlock Text="{DynamicResource FaqImportIconPacksIntro}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="{DynamicResource FaqImportIconPacksStepsTitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                        <Border Classes="icon-faq-step" BorderThickness="0" Padding="0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                                        <Border Classes="icon-faq-number" Grid.RowSpan="2"><TextBlock Classes="icon-faq-number-text" Text="1" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksDownloadTitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksStepDownload}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        </StackPanel>
                                        <HyperlinkButton x:Name="IconPackBuilderDownloadLink" Classes="icon-faq-action" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,6" NavigateUri="https://github.com/Legends/otp-harbor-icon-pack-builder/releases/latest">
                                                        <shared:SymbolIconLabel Kind="ExternalLink" Text="{DynamicResource FaqImportIconPacksDownloadLink}" />
                                                    </HyperlinkButton></Grid></Border>
                                        <Border Classes="icon-faq-step" >
                                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                                        <Border Classes="icon-faq-number" Grid.RowSpan="2"><TextBlock Classes="icon-faq-number-text" Text="2" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksBuildTitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksStepBuild}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="icon-faq-art" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <shared:SymbolIcon Kind="Vault" IconSize="36" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource FaqIconPackFileExtension}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    </StackPanel></Grid></Border>
                                        <Border Classes="icon-faq-step" >
                                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                                        <Border Classes="icon-faq-number" Grid.RowSpan="2"><TextBlock Classes="icon-faq-number-text" Text="3" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksImportTitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{DynamicResource FaqImportIconPacksStepImport}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="icon-faq-art" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                        <shared:SymbolIcon Kind="Settings" IconSize="28" Foreground="{DynamicResource BrushAccent}" />
                                                        <shared:SymbolIcon Kind="Import" IconSize="24" Foreground="{DynamicResource BrushAccent}" />
                                                        <shared:SymbolIcon Kind="ImageStack" IconSize="28" Foreground="{DynamicResource BrushAccent}" />
                                                    </StackPanel></Grid></Border>
                                        <Border x:Name="IconPackCustomIconTip" Background="{DynamicResource BrushSurfaceAlternate}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <shared:SymbolIcon Kind="Information" IconSize="24" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{DynamicResource FaqImportIconPacksCustomTitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource FaqImportIconPacksCustomIconTip}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="IconPackFaqLegalSection" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <shared:SymbolIcon Kind="License" IconSize="24" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource FaqImportIconPacksSources}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" Grid.Column="1" FontSize="14" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <Grid Classes="icon-faq-legal-links" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                        <HyperlinkButton Classes="icon-faq-legal-link icon-faq-legal-first" Padding="0,4" NavigateUri="https://github.com/simple-icons/simple-icons/blob/develop/DISCLAIMER.md">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <shared:SymbolIcon Kind="ExternalLink" IconSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource FaqSimpleIconsOfficialLink}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </HyperlinkButton><HyperlinkButton Classes="icon-faq-legal-link icon-faq-legal-second" Padding="0,4" NavigateUri="https://github.com/aegis-icons/aegis-icons#disclaimer">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <shared:SymbolIcon Kind="ExternalLink" IconSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource FaqAegisIconPackDocsLink}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </HyperlinkButton><HyperlinkButton Classes="icon-faq-legal-link icon-faq-legal-third" Padding="0,4" NavigateUri="https://github.com/homarr-labs/dashboard-icons#legal">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <shared:SymbolIcon Kind="ExternalLink" IconSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource FaqDashboardIconsLegalLink}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </HyperlinkButton></Grid>
                                                    <TextBlock Text="{DynamicResource FaqImportIconPacksDisclaimer}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" />
                                                </StackPanel>
                                            </Border>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                                <Border x:Name="FaqImportFormatsCard" Classes="faq-card" Classes.expanded="{Binding #FaqImportFormatsExpander.IsExpanded}">
                                    <Expander
                                        x:Name="FaqImportFormatsExpander"
                                        Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="QrCode" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                                <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqImportFormatsQuestion}" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsIntro}" TextWrapping="Wrap" />
                                                <Expander
                                                    x:Name="FaqImportFormatsAegisExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsAegisTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsAegisDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsAegisExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsTwoFasExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsTwoFasTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsTwoFasDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsTwoFasExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsOtpAuthExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsOtpAuthTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsOtpAuthDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsOtpAuthExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                            <Border x:Name="FaqCreateBackupCard" Classes="faq-card" Classes.expanded="{Binding #FaqCreateBackupExpander.IsExpanded}">
                                <Expander x:Name="FaqCreateBackupExpander" Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged" Expanded="FaqSectionExpanded" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="Export" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                            <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqCreateBackupQuestion}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqCreateBackupAnswer}" TextWrapping="Wrap" />
                                    </Border>
                                </Expander>
                            </Border>
                            <Border x:Name="FaqBackupLocationsCard" Classes="faq-card" Classes.expanded="{Binding #FaqBackupLocationsExpander.IsExpanded}">
                                <Expander x:Name="FaqBackupLocationsExpander" Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged" Expanded="FaqSectionExpanded" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="Vault" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                            <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqBackupLocationsQuestion}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqBackupLocationsAnswer}" TextWrapping="Wrap" />
                                    </Border>
                                </Expander>
                            </Border>
                            <Border x:Name="FaqForgottenPasswordCard" Classes="faq-card" Classes.expanded="{Binding #FaqForgottenPasswordExpander.IsExpanded}">
                                <Expander x:Name="FaqForgottenPasswordExpander" Classes="faq-section" PropertyChanged="FaqSectionPropertyChanged" Expanded="FaqSectionExpanded" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Margin="16,10" MinHeight="40" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border Classes="faq-icon-badge"><shared:SymbolIcon Kind="Lock" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" /></Border>
                                            <TextBlock Grid.Column="1" Classes="faq-question" Text="{DynamicResource FaqForgottenPasswordQuestion}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Border Classes="faq-answer" Background="Transparent" Padding="18,4,18,18">
                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqForgottenPasswordAnswer}" TextWrapping="Wrap" />
                                    </Border>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <shared:SymbolIcon IconSize="20" Kind="Information" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource About}" TextWrapping="Wrap" TextAlignment="Left" />
                        </Grid>
                    </TabItem.Header>
                    <ScrollViewer x:Name="AboutSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="AboutSettingsPanel" Container.Name="about-content" Container.Sizing="Width" Margin="4,8,4,4" Spacing="12">
                            <Border x:Name="AppInformationPanel" Classes="settings-card" Padding="18">
                                <controls:SettingsAboutIdentityPanel x:Name="AboutIdentityPanel" DataContext="{Binding SettingsPage.About}" />
                            </Border>
                            <ContentControl x:Name="SoftwareUpdatesHost" Content="{Binding UpdateCheck}" IsVisible="{Binding UpdateCheck.IsSoftwareUpdatesVisible}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:UpdateCheckViewModel">
                                        <Border x:Name="AboutSoftwareUpdatesCard" Classes="settings-card" Padding="16" IsVisible="{Binding IsSoftwareUpdatesVisible}">
                                            <StackPanel Spacing="14">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                    <shared:SymbolIcon Kind="Refresh" IconSize="28" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Classes="settings-card-title" Text="{DynamicResource SoftwareUpdates}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource AboutUpdatesHelp}" />
                                                    </StackPanel>
                                                </Grid>
                                                <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" IsVisible="{Binding IsDownloadInProgress}" Maximum="100" Value="{Binding ProgressPercentage}" />
                                                <Grid x:Name="AboutUpdateContent" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                                    <WrapPanel x:Name="AboutUpdateActions" Orientation="Horizontal">
                                                        <Button x:Name="AboutCheckUpdatesButton" Classes="primary settings-action" HorizontalAlignment="Left" MinHeight="40" Command="{Binding CheckCommand}" IsVisible="{Binding ShowCheckAction}" automation:AutomationProperties.Name="{DynamicResource VerifyAppcast}">
                                                            <shared:SymbolIconLabel Kind="Check" Text="{DynamicResource VerifyAppcast}" />
                                                        </Button>
                                                        <Button x:Name="AboutDownloadUpdateButton" Classes="primary settings-action" HorizontalAlignment="Left" MinHeight="40" Command="{Binding DownloadCommand}" IsVisible="{Binding ShowDownloadAction}" automation:AutomationProperties.Name="{DynamicResource DownloadUpdate}">
                                                            <shared:SymbolIconLabel Kind="Download" Text="{DynamicResource DownloadUpdate}" />
                                                        </Button>
                                                        <Button x:Name="AboutInstallUpdateButton" Classes="primary settings-action" HorizontalAlignment="Left" MinHeight="40" Command="{Binding InstallCommand}" IsVisible="{Binding ShowInstallAction}" automation:AutomationProperties.Name="{DynamicResource InstallUpdate}">
                                                            <shared:SymbolIconLabel Kind="Check" Text="{DynamicResource InstallUpdate}" />
                                                        </Button>
                                                        <Button x:Name="AboutCancelUpdateButton" Classes="secondary settings-action" HorizontalAlignment="Left" MinHeight="40" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancelAction}" automation:AutomationProperties.Name="{DynamicResource Cancel}">
                                                            <shared:SymbolIconLabel Kind="Close" Text="{DynamicResource Cancel}" />
                                                        </Button>
                                                    </WrapPanel>
                                                    <Border x:Name="AboutUpdateDivider" Grid.Column="1" Width="1" Background="{DynamicResource BrushControlBorder}" />
                                                    <Grid x:Name="AboutUpdateStatus" VerticalAlignment="Center">
                                                        <Grid x:Name="AboutUpToDateStatus" IsVisible="{Binding IsUpToDate}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushSuccess}" VerticalAlignment="Center">
                                                                <shared:SymbolIcon Kind="Check" IconSize="18" Foreground="{DynamicResource BrushOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Classes="settings-row-label" Text="{DynamicResource AboutUpdatesCurrentTitle}" />
                                                                <TextBlock x:Name="AboutCurrentVersionStatus" Classes="settings-help" Text="{Binding CurrentVersionStatus}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border IsVisible="{Binding !IsUpToDate}"><shared:NotificationBanner Text="{Binding Message}" Severity="{Binding MessageSeverity}" /></Border>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock IsVisible="{Binding HasReleaseNotes}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="AboutDiagnosticsHost" Content="{Binding Diagnostics}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:DiagnosticsViewModel">
                                        <Border x:Name="AboutAppDetailsCard" Classes="settings-card" Padding="16">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <shared:SymbolIcon Kind="Information" IconSize="24" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="settings-card-title" Text="{DynamicResource AboutDetailsTitle}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border x:Name="AboutDiagnosticsSummary" Container.Name="about-diagnostics-summary" Container.Sizing="Width" Background="{DynamicResource BrushSurfaceAlternate}" BorderBrush="{DynamicResource BrushControlBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto" Grid.IsSharedSizeScope="True">
                                                        <ItemsControl x:Name="AboutPrimaryDetails" ItemsSource="{Binding PrimaryDetails}" ItemTemplate="{StaticResource DiagnosticSummaryItemTemplate}" />
                                                        <Border x:Name="AboutColumnDivider" Grid.Column="1" Width="1" Margin="14,0" Background="{DynamicResource BrushControlBorder}" />
                                                        <Border x:Name="AboutRowDivider" Grid.Row="1" Grid.ColumnSpan="3" Height="1" Margin="0,8" Background="{DynamicResource BrushControlBorder}" />
                                                        <ItemsControl x:Name="AboutSecondaryDetails" ItemsSource="{Binding SecondaryDetails}" ItemTemplate="{StaticResource DiagnosticSummaryItemTemplate}" />
                                                    </Grid>
                                                </Border>
                                                <shared:NotificationBanner Text="{Binding Notification.Text}" Severity="{Binding Notification.Severity}" IsVisible="{Binding Notification.HasMessage}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="AboutCreditsHost" Content="{Binding SettingsPage.About}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="about:AboutViewModel">
                                        <Border x:Name="AboutCreditsCard" Classes="settings-card" Padding="16">
                                            <StackPanel Spacing="10">
                                                <Grid x:Name="AboutCreditsContent" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                                                    <shared:SymbolIcon Kind="People" IconSize="28" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Classes="settings-card-title" Text="{DynamicResource AboutCreditsTitle}" />
                                                        <TextBlock Classes="settings-help" Text="{DynamicResource AboutCreditsHelp}" />
                                                    </StackPanel>
                                                    <Button x:Name="AboutViewCreditsButton" Classes="secondary settings-action" MinHeight="40" VerticalAlignment="Center" Command="{Binding CreditsCommand}" automation:AutomationProperties.Name="{DynamicResource AboutViewCredits}">
                                                        <shared:SymbolIconLabel Kind="ExternalLink" Text="{DynamicResource AboutViewCredits}" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <shared:NotificationBanner
            x:Name="SettingsNotificationToast"
            ZIndex="50"
            Margin="16,16,16,18"
            Classes="toast"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Severity="{Binding SettingsNotification.Severity}"
            Text="{Binding SettingsNotification.Text}" />
        <Border
            x:Name="SettingsImportProgressOverlay"
            ZIndex="100"
            Background="{DynamicResource BrushOverlayLight}"
            IsVisible="{Binding NativeFilePicker.IsImportProgressVisible}">
            <Border
                Width="300"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BrushSurface}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <ProgressBar IsIndeterminate="{Binding NativeFilePicker.IsImportProgressVisible}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding NativeFilePicker.ImportProgressText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>
