<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.ChoiceDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    x:DataType="dialogs:ChoiceDialogViewModel"
    Background="{DynamicResource BrushDialogSurface}"
    Classes="dialog"
    Width="520"
    WindowDecorations="None"
    Title="{Binding Title}">
    <StackPanel Classes="dialog-content" Spacing="20">
        <TextBlock Classes="heading" Text="{Binding Title}" TextWrapping="Wrap" />
        <Border Classes="dialog-message-card">
            <TextBlock Text="{Binding Message}" />
        </Border>
        <Grid
            Classes="dialog-choice-actions"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
            <Button
                Grid.Column="0"
                Classes="secondary"
                Command="{Binding CancelCommand}"
                IsCancel="True">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding CancelText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button
                Grid.Column="1"
                Command="{Binding SecondaryCommand}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding SecondaryText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button
                Grid.Column="2"
                Classes="primary"
                Command="{Binding PrimaryCommand}"
                IsDefault="True">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding PrimaryText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
        </Grid>
    </StackPanel>
</Window>
