<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.ConfirmationDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    x:DataType="dialogs:ConfirmationDialogViewModel"
    Background="{DynamicResource BrushDialogSurface}"
    CanResize="False"
    Classes="dialog"
    Classes.destructive="{Binding IsDestructive}"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="520"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource AppTitle}">
    <Grid Classes="dialog-content" Margin="22" RowDefinitions="Auto,Auto" RowSpacing="16">
        <ScrollViewer x:Name="DialogContentScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock
                    Classes="heading"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <Border
                    x:Name="DialogMessageCard"
                    Classes="dialog-message-card">
                    <TextBlock Text="{Binding Message}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Classes="dialog-actions">
            <Button
                Classes="secondary"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}"
                IsCancel="True"
                IsVisible="{Binding ShowCancel}" />
            <Button
                Classes.danger="{Binding IsDestructive}"
                Classes.primary="{Binding !IsDestructive}"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
