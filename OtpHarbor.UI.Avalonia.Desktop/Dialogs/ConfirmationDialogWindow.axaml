<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.ConfirmationDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    x:DataType="dialogs:ConfirmationDialogViewModel"
    Background="{DynamicResource BrushDialogSurface}"
    CanResize="False"
    Classes="dialog"
    Classes.destructive="{Binding IsDestructive}"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="520"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource AppTitle}">
    <Window.Styles>
        <Style Selector="StackPanel.dialog-actions.stacked">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="StackPanel.dialog-actions.stacked Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="Infinity" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    <Grid Classes="dialog-content" Margin="22" RowDefinitions="Auto,Auto" RowSpacing="16">
        <ScrollViewer x:Name="DialogContentScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock
                    Classes="heading"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <Border
                    x:Name="DialogMessageCard"
                    Classes="dialog-message-card">
                    <TextBlock Text="{Binding Message}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Classes.stacked="{Binding StackActions}"
            Classes="dialog-actions">
            <Button
                Classes="secondary"
                automation:AutomationProperties.Name="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                IsCancel="True"
                IsVisible="{Binding ShowCancel}">
                <TextBlock Text="{Binding CancelText}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button
                automation:AutomationProperties.Name="{Binding ConfirmText}"
                Classes.danger="{Binding IsDestructive}"
                Classes.primary="{Binding !IsDestructive}"
                Command="{Binding ConfirmCommand}"
                IsDefault="True">
                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
