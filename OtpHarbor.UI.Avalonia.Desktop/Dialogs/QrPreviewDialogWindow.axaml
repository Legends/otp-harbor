<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.QrPreviewDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:QrPreviewDialogViewModel"
    MinWidth="320"
    MinHeight="390"
    CanResize="True"
    ShowInTaskbar="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*">
        <controls:ProductTitleBar
            ShowIcon="False"
            TitlePadding="8,0,0,0"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Grid Grid.Row="1" Margin="12" RowDefinitions="*,Auto">
            <Border
            Background="{DynamicResource BrushQrBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
            <Image
                automation:AutomationProperties.Name="{DynamicResource GeneratedQr}"
                Source="{Binding Image}"
                Stretch="Uniform" />
        </Border>
            <shared:ValidationMessage
                Grid.Row="1"
                Margin="0,8,0,0"
                Severity="Warning"
                Text="{DynamicResource QrPrivacyNotice}"
                TextAlignment="Center" />
        </Grid>
    </Grid>
</Window>
