<Project>
  <PropertyGroup>
    <Product>OTP Harbor</Product>
    <Company>OTP Harbor contributors</Company>
    <Authors>OTP Harbor contributors</Authors>
    <Description>GPLv3-licensed, open-source, local-first TOTP and 2FA authenticator.</Description>
    <Copyright>Copyright © OTP Harbor contributors</Copyright>
    <RepositoryUrl>https://github.com/Legends/otp-harbor</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
