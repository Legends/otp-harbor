<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TOTP.Tests.Unix</AssemblyName>
    <RootNamespace>TOTP.Tests.Unix</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\OtpHarbor.Core\totp-sign-key.snk</AssemblyOriginatorKeyFile>
    <PublicSign>true</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtpHarbor.Camera.OpenCv\OtpHarbor.Camera.OpenCv.csproj" />
    <ProjectReference Include="..\OtpHarbor.Infrastructure\OtpHarbor.Infrastructure.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.Linux\OtpHarbor.Platform.Linux.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.MacOS\OtpHarbor.Platform.MacOS.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.Unix\OtpHarbor.Platform.Unix.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
