<UserControl x:Class="TOTP.Avalonia.Shared.Controls.ImportReviewAccountCard"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:review="using:TOTP.Avalonia.Shared.Import"
    x:DataType="review:ImportReviewViewModel+ReviewRow">
    <UserControl.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" /></Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.choice"><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="8,2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" /></Style>
        <Style Selector="Border.choice.selected"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /><Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" /></Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8">
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
            <Expander.Header>
                <StackPanel Spacing="4">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding IssueText}" />
                    <TextBlock FontSize="13" Text="{Binding Identity}" />
                    <TextBlock Classes="secondary" FontSize="12" Text="{Binding Parameters}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource BrushAccent}" Text="{Binding ActionSummary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="10" Margin="4,8">
                <TextBlock Classes="secondary" FontSize="13" Text="{Binding IssueDescription}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource BrushAccent}" Text="{Binding ChangedFieldsText}" IsVisible="{Binding IsConflict}" />
                <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="5" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ExistingText}" /><TextBlock FontSize="12" Text="{Binding ExistingParameters}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding IncomingText}" /><TextBlock FontSize="12" Text="{Binding IncomingParameters}" />
                    </StackPanel>
                </Border>
                <StackPanel IsVisible="{Binding IsConflict}" Spacing="6">
                    <Border Classes="choice" Classes.selected="{Binding IsReplace}"><RadioButton MinHeight="44" GroupName="{Binding GroupName}" Content="{Binding ReplaceText}" IsChecked="{Binding IsReplace, Mode=TwoWay}" /></Border>
                    <Border Classes="choice" Classes.selected="{Binding IsKeepBoth}"><RadioButton MinHeight="44" GroupName="{Binding GroupName}" Content="{Binding KeepBothText}" IsChecked="{Binding IsKeepBoth, Mode=TwoWay}" /></Border>
                    <Border Classes="choice" Classes.selected="{Binding IsSkip}"><RadioButton MinHeight="44" GroupName="{Binding GroupName}" Content="{Binding SkipText}" IsChecked="{Binding IsSkip, Mode=TwoWay}" /></Border>
                </StackPanel>
                <TextBlock Classes="secondary" FontSize="12" Text="{Binding ChoicesHelp}" IsVisible="{Binding IsConflict}" />
                <TextBlock Text="{Binding ActionSummary}" IsVisible="{Binding !IsConflict}" />
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
