<UserControl x:Class="TOTP.Avalonia.Shared.Controls.ImportFileSummaryPanel"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation" xmlns:import="using:TOTP.Avalonia.Shared.Import"
    xmlns:controls="using:TOTP.Avalonia.Shared.Controls" x:DataType="import:AuthenticatorImportViewModel"
    automation:AutomationProperties.Name="{Binding Title}">
    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <ScrollViewer x:Name="SummaryContentScroll" MaxHeight="360" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:SymbolIcon Kind="Information" IconSize="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedFileName}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedFileName}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding DetectedFormatText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" Width="44" Height="44" Padding="0" IsCancel="True"
                            Command="{Binding ClearFileCommand}" ToolTip.Tip="{Binding ClearFileText}" automation:AutomationProperties.Name="{Binding ClearFileText}">
                        <controls:SymbolIcon Kind="Close" IconSize="16" />
                    </Button>
                </Grid>
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <TextBlock Text="{Binding TotalEntriesText}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalEntries}" />
                    <TextBlock Grid.Row="1" Text="{Binding ValidEntriesText}" TextWrapping="Wrap" /><TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding ValidEntries}" />
                    <TextBlock Grid.Row="2" Text="{Binding AttentionEntriesText}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding AttentionEntries}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Classes="primary" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ReviewFileCommand}" IsDefault="True"
                automation:AutomationProperties.Name="{Binding ReviewEntriesText}">
            <TextBlock Text="{Binding ReviewEntriesText}" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
