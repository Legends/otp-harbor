<UserControl x:Class="TOTP.Avalonia.Shared.Controls.ImportReviewMobilePage"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:review="using:TOTP.Avalonia.Shared.Import" xmlns:controls="using:TOTP.Avalonia.Shared.Controls"
    xmlns:automation="using:Avalonia.Automation" x:DataType="review:ImportReviewViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="TextBlock.review-secondary"><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" /></Style>
        <Style Selector="TextBlock.review-description"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Border.review-card"><Setter Property="Background" Value="{DynamicResource BrushSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="12" /></Style>
        <Style Selector="TextBlock.review-count"><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
        <Style Selector="TextBlock.review-metric"><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /></Style>
        <Style Selector="UniformGrid.review-metrics"><Setter Property="Columns" Value="3" /></Style>
        <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="14" /></Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type review:ImportReviewViewModel}" x:DataType="review:ImportReviewViewModel">
            <StackPanel Margin="16,16,16,8" Spacing="12">
        <StackPanel Spacing="6">
            <TextBlock Classes="review-secondary review-breadcrumb" FontSize="12" Text="{Binding Breadcrumb}" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="review-secondary review-description" Text="{Binding Description}" />
            <Grid Classes="review-stepper" ColumnDefinitions="*,*,*,*" RowDefinitions="28,Auto" RowSpacing="5" Margin="0,6,0,0">
                <Border Grid.ColumnSpan="4" Height="2" Margin="24,0" VerticalAlignment="Center" Background="{DynamicResource BrushBorder}" />
                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushAccent}"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushOnAccent}" /></Border>
                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushAccent}"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushOnAccent}" /></Border>
                <Border Grid.Column="2" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushAccent}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushOnAccent}" /></Border>
                <Border Grid.Column="3" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushSurfaceAlternate}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" /></Border>
                <TextBlock Grid.Row="1" FontSize="12" TextAlignment="Center" Text="{Binding StepSourceText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" TextAlignment="Center" Text="{Binding StepExportText}" />
                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="12" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" Text="{Binding StepReviewText}" />
                <TextBlock Grid.Row="1" Grid.Column="3" FontSize="12" TextAlignment="Center" Text="{Binding StepImportText}" />
            </Grid>
        </StackPanel>
        <Border Classes="review-card">
            <StackPanel Spacing="10">
                <Grid Classes="review-source" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <controls:SymbolIcon Kind="Import" IconSize="26" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SummaryTitle}" />
                        <TextBlock Classes="review-secondary" FontSize="12" Text="{Binding SourceAndFile}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                    </StackPanel>
                </Grid>
                <UniformGrid Classes="review-metrics">
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Text="{Binding TotalCount}" /><TextBlock Classes="review-metric" Text="{Binding TotalText}" /></StackPanel>
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Foreground="{DynamicResource BrushSuccess}" Text="{Binding ReadyCount}" /><TextBlock Classes="review-metric" Text="{Binding ReadyText}" /></StackPanel>
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Foreground="{DynamicResource BrushWarning}" Text="{Binding ConflictCount}" /><TextBlock Classes="review-metric" Text="{Binding ConflictsText}" /></StackPanel>
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Foreground="{DynamicResource BrushAccent}" Text="{Binding DuplicateCount}" /><TextBlock Classes="review-metric" Text="{Binding DuplicatesText}" /></StackPanel>
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Text="{Binding UnsupportedCount}" /><TextBlock Classes="review-metric" Text="{Binding UnsupportedText}" /></StackPanel>
                    <StackPanel Margin="3"><TextBlock Classes="review-count" Foreground="{DynamicResource BrushDanger}" Text="{Binding InvalidCount}" /><TextBlock Classes="review-metric" Text="{Binding InvalidText}" /></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <StackPanel Spacing="6">
            <TextBlock Classes="review-secondary review-description" FontSize="12" Text="{Binding LocalText}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource BrushWarning}" IsVisible="{Binding HasExcluded}" Text="{Binding ExcludedText}" />
        </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox PlaceholderText="{Binding SearchText}" Text="{Binding Search, Mode=TwoWay}" MinHeight="44" automation:AutomationProperties.Name="{Binding SearchText}" />
                    <ComboBox Grid.Column="1" Classes="review-mobile-filter" MaxWidth="150" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" automation:AutomationProperties.Name="{Binding FilterText}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="review:ImportReviewViewModel+CategoryOption"><TextBlock FontSize="12" Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding AllVisibleSelected, Mode=TwoWay}" Content="{Binding SelectionText}" />
                    <ComboBox Grid.Column="1" IsEnabled="{Binding HasSelection}" ItemsSource="{Binding Actions}" SelectedItem="{Binding BulkAction, Mode=TwoWay}" PlaceholderText="{Binding ApplyText}" automation:AutomationProperties.Name="{Binding ApplyText}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="review:ImportReviewViewModel+ActionOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Classes="review-secondary" Text="{Binding NoResultsText}" IsVisible="{Binding HasNoResults}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type review:ImportReviewViewModel+ReviewRow}" x:DataType="review:ImportReviewViewModel+ReviewRow">
            <controls:ImportReviewAccountCard Margin="16,0,16,8" />
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="ReviewPageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                      IsScrollChainingEnabled="False">
            <ItemsControl x:Name="ReviewItems" ItemsSource="{Binding MobileItems}">
                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        <ContentControl x:Name="NativeReviewPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsVisible="False" />
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,8,16,12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Grid.ColumnSpan="2" Classes="review-secondary" FontSize="12" Text="{Binding ReviewStatus}" />
                <Button Grid.Row="1" Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding BackCommand}" Content="{Binding BackText}" />
                <Button Grid.Row="1" Grid.Column="1" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ImportCommand}" automation:AutomationProperties.Name="{Binding ImportText}"><TextBlock Text="{Binding ImportText}" TextAlignment="Center" /></Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
