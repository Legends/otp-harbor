<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TOTP.Tests</AssemblyName>
    <RootNamespace>TOTP.Tests</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SignAssembly>True</SignAssembly>
    <DelaySign>False</DelaySign>
    <AssemblyOriginatorKeyFile>..\OtpHarbor.Core\totp-sign-key.snk</AssemblyOriginatorKeyFile>
    <PublicSign>true</PublicSign>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <UserSecretsId>eae90785-030b-456f-b23c-5ab39239447f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtpHarbor.Camera.OpenCv\OtpHarbor.Camera.OpenCv.csproj" />
    <ProjectReference Include="..\OtpHarbor.Core\OtpHarbor.Core.csproj" />
    <ProjectReference Include="..\OtpHarbor.Infrastructure\OtpHarbor.Infrastructure.csproj" />
    <ProjectReference Include="..\OtpHarbor.Installer\OtpHarbor.Installer.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.Linux\OtpHarbor.Platform.Linux.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.MacOS\OtpHarbor.Platform.MacOS.csproj" />
    <ProjectReference Include="..\OtpHarbor.Platform.Windows\OtpHarbor.Platform.Windows.csproj" />
    <ProjectReference Include="..\OtpHarbor.UI.Avalonia.Desktop\OtpHarbor.UI.Avalonia.Desktop.csproj" />
    <ProjectReference Include="..\OtpHarbor.UI.Avalonia.Mobile\OtpHarbor.UI.Avalonia.Mobile.csproj" />
    <ProjectReference Include="..\OtpHarbor.Updater\OtpHarbor.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\OtpHarbor.UI.Avalonia.Android\NativeTextSizing.cs"
             Link="Fixtures\Android\NativeTextSizing.cs" />
  </ItemGroup>

