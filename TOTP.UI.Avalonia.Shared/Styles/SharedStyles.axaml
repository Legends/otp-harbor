<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Shared.Controls"
    xmlns:styles="using:TOTP.Avalonia.Shared.Styles">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
                    <SolidColorBrush x:Key="BrushTextBrand" Color="#7A248E" />
                    <SolidColorBrush x:Key="BrushTextSelection" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushTextHighlight" Color="#137333" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushControlBorder" Color="#94A3B8" />
                    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#64748B" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#3568CF" />
                    <SolidColorBrush x:Key="BrushAccentPressed" Color="#21499B" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#B42318" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#8A4B00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#137333" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#005FCC" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDialogSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushRecentAccountHighlight" Color="#66FFD54F" />
                    <BoxShadows x:Key="ElevationCard">0 2 8 0 #1A000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
                    <SolidColorBrush x:Key="BrushTextBrand" Color="#7A248E" />
                    <SolidColorBrush x:Key="BrushTextSelection" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushTextHighlight" Color="#137333" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="BrushControlBorder" Color="#94A3B8" />
                    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#64748B" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#2856B6" />
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#3568CF" />
                    <SolidColorBrush x:Key="BrushAccentPressed" Color="#21499B" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#B42318" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#8A4B00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#137333" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#005FCC" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDialogSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushRecentAccountHighlight" Color="#66FFD54F" />
                    <BoxShadows x:Key="ElevationCard">0 2 8 0 #1A000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#0C1C33" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#10213F" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#1A2E4E" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#243C63" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#152744" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#CBDAF3" />
                    <SolidColorBrush x:Key="BrushTextBrand" Color="#AA3ADA" />
                    <SolidColorBrush x:Key="BrushTextSelection" Color="#97B0DF" />
                    <SolidColorBrush x:Key="BrushTextHighlight" Color="#87CE3E" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#1D3366" />
                    <SolidColorBrush x:Key="BrushControlBorder" Color="#2F5E9E" />
                    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#4C78B8" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#7D7FF4" />
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#9193FF" />
                    <SolidColorBrush x:Key="BrushAccentPressed" Color="#6A6CDF" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#EF5350" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#FFD166" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#87CE3E" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#9899FF" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDialogSurface" Color="#192B52" />
                    <SolidColorBrush x:Key="BrushRecentAccountHighlight" Color="#66FFD54F" />
                    <BoxShadows x:Key="ElevationCard">0 2 8 0 #40000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AvaloniaThemeVariants.HighContrast}">
                    <SolidColorBrush x:Key="BrushWindowBackground" Color="#000000" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#000000" />
                    <SolidColorBrush x:Key="BrushSurfaceAlternate" Color="#000000" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#000000" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextBrand" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushTextSelection" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushTextHighlight" Color="#00FF00" />
                    <SolidColorBrush x:Key="BrushBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushControlBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushControlBorderHover" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushAccentPressed" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushOnAccent" Color="#000000" />
                    <SolidColorBrush x:Key="BrushDanger" Color="#FF8080" />
                    <SolidColorBrush x:Key="BrushOnDanger" Color="#000000" />
                    <SolidColorBrush x:Key="BrushWarning" Color="#FFFF00" />
                    <SolidColorBrush x:Key="BrushSuccess" Color="#00FF00" />
                    <SolidColorBrush x:Key="BrushFocus" Color="#00FFFF" />
                    <SolidColorBrush x:Key="BrushQrBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushDialogSurface" Color="#000000" />
                    <SolidColorBrush x:Key="BrushRecentAccountHighlight" Color="#66FFD54F" />
                    <BoxShadows x:Key="ElevationCard">0 0 0 0 #00000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BrushProgressIndicator" Color="#0078D4" />

            <x:Double x:Key="Space1">4</x:Double>
            <x:Double x:Key="Space2">8</x:Double>
            <x:Double x:Key="Space3">12</x:Double>
            <x:Double x:Key="Space4">16</x:Double>
            <x:Double x:Key="Space6">24</x:Double>
            <x:Double x:Key="Space8">32</x:Double>
            <x:Double x:Key="FontSizeBody">12</x:Double>
            <x:Double x:Key="FontSizeHeading">16</x:Double>
            <x:Double x:Key="FontSizeTitle">19</x:Double>
            <x:Double x:Key="ControlMinimumHeight">30</x:Double>
            <x:Double x:Key="MotionFastMilliseconds">120</x:Double>
            <x:Double x:Key="MotionStandardMilliseconds">200</x:Double>
            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
            <Thickness x:Key="PagePadding">10</Thickness>
            <Thickness x:Key="ControlPadding">10,5</Thickness>
            <Thickness x:Key="CardPadding">10</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushWindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ElevationCard}" />
    </Style>
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="5,4" />
    </Style>
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.unlock-card">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BoxShadow" Value="{DynamicResource ElevationCard}" />
    </Style>
    <Style Selector="Border.flyout">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.flyout.open">
        <Style.Animations>
            <Animation
                Duration="0:0:0.18"
                FillMode="Forward"
                PlaybackBehavior="OnlyIfVisible">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="380" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.app-title">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.inline-message">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.countdown">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorderHover}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
    </Style>
    <Style Selector="Button.wide">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlternate}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    </Style>
    <Style Selector="Button.titlebar-control">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="33" />
        <Setter Property="MinHeight" Value="33" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.titlebar-minimize:pointerover">
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.titlebar-minimize:pressed">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.titlebar-close:pressed">
        <Setter Property="Background" Value="#CCB42318" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.row-code">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSelection}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.link">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.danger-link">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnDanger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=true]">
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="ListBox.accounts">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.accounts ListBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.accounts ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextHighlight}" />
    </Style>
    <Style Selector="ListBox.accounts ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextHighlight}" />
    </Style>
    <Style Selector="Border.account-row-container">
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.account-row-container.recently-added">
        <Style.Animations>
            <Animation
                Duration="0:0:1.4"
                Easing="CubicEaseOut"
                FillMode="Forward"
                PlaybackBehavior="OnlyIfVisible">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource BrushRecentAccountHighlight}" />
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ContextMenu.account-context-menu">
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    </Style>
    <Style Selector="ContextMenu.account-context-menu MenuItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="ContextMenu.account-context-menu MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
    </Style>
    <Style Selector="ContextMenu.account-context-menu MenuItem:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
    </Style>
    <Style Selector="ContextMenu.account-context-menu MenuItem.danger-context-item">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrushProgressIndicator}" />
    </Style>
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="NumericUpDown:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="controls|BusyOverlay">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ContentPresenter
                        Name="PART_Content"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Border
                        automation:AutomationProperties.LiveSetting="Polite"
                        automation:AutomationProperties.Name="{TemplateBinding BusyMessage}"
                        Background="{DynamicResource BrushSurface}"
                        IsVisible="{TemplateBinding IsBusy}"
                        Opacity="0.96">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressBar
                                Width="180"
                                IsIndeterminate="True" />
                            <TextBlock
                                Classes="secondary"
                                Text="{TemplateBinding BusyMessage}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:busy /template/ ContentPresenter#PART_Content">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Style>
    <Style Selector="controls|ValidationMessage">
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock
                    Name="PART_Message"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    Text="{TemplateBinding Text}"
                    TextAlignment="{TemplateBinding TextAlignment}"
                    TextWrapping="Wrap" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|ValidationMessage:information /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="controls|ValidationMessage:warning /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
    </Style>
    <Style Selector="controls|ValidationMessage:error /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="controls|RevealableSecretInput">
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinimumHeight}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox
                        Name="PART_Input"
                        automation:AutomationProperties.HelpText="{TemplateBinding HelpText}"
                        automation:AutomationProperties.IsRequiredForForm="{TemplateBinding IsRequired}"
                        automation:AutomationProperties.Name="{TemplateBinding AccessibleName}"
                        Grid.Column="0"
                        PasswordChar="●"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <Button
                        Name="PART_RevealButton"
                        automation:AutomationProperties.HelpText="{DynamicResource RevealSecretHelp}"
                        automation:AutomationProperties.Name="{DynamicResource RevealSecretAutomation}"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{DynamicResource RevealSecret}"
                        ToolTip.Tip="{DynamicResource RevealSecretAutomation}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|RevealableSecretInput:revealed /template/ Button#PART_RevealButton">
        <Setter Property="Content" Value="{DynamicResource ConcealSecret}" />
    </Style>
    <Style Selector="controls|AccountRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock
                    automation:AutomationProperties.Name="{TemplateBinding AccessibleName}"
                    MinHeight="{DynamicResource ControlMinimumHeight}"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{TemplateBinding DisplayText}"
                    TextTrimming="CharacterEllipsis" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|NotificationBanner">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Banner"
                    automation:AutomationProperties.LiveSetting="{TemplateBinding LiveSetting}"
                    automation:AutomationProperties.Name="{TemplateBinding Text}"
                    Background="{DynamicResource BrushSurfaceAlternate}"
                    BorderThickness="4,0,0,0"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="12,8">
                    <TextBlock
                        Text="{TemplateBinding Text}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|NotificationBanner:information /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="controls|NotificationBanner:success /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
    </Style>
    <Style Selector="controls|NotificationBanner:warning /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
    </Style>
    <Style Selector="controls|NotificationBanner:error /template/ Border#PART_Banner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="controls|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox
                    Width="{TemplateBinding IconSize}"
                    Height="{TemplateBinding IconSize}"
                    Stretch="Uniform">
                    <Path
                        Width="24"
                        Height="24"
                        Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}}"
                        Fill="{TemplateBinding Foreground}"
                        Stretch="Uniform" />
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Window.dialog">
        <Setter Property="Width" Value="460" />
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="WindowStartupLocation" Value="CenterOwner" />
        <Setter Property="Background" Value="{DynamicResource BrushDialogSurface}" />
        <Setter Property="WindowDecorations" Value="None" />
    </Style>
    <Style Selector="StackPanel.dialog-content">
        <Setter Property="Margin" Value="24" />
        <Setter Property="Spacing" Value="16" />
    </Style>
    <Style Selector="StackPanel.dialog-actions">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Grid.settings-page TextBlock.page-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.settings-page TextBlock.section-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Grid.settings-page TextBlock.settings-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.settings-page TextBlock.settings-group-label">
        <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector="Grid.settings-page TextBlock.secondary">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Grid.settings-page TabControl.settings-tabs TabItem">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="7,6" />
    </Style>
    <Style Selector="Grid.settings-page TabControl.settings-tabs TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrand}" />
    </Style>
</Styles>
