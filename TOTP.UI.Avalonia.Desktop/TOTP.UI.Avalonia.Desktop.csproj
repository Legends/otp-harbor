<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TOTP.Avalonia.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\TOTP.Core\totp-sign-key.snk</AssemblyOriginatorKeyFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);TOTP_PLATFORM_WINDOWS</DefineConstants>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);TOTP_PLATFORM_MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);TOTP_PLATFORM_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Icons\app.ico" />
    <AvaloniaResource Include="Assets\flags\en.png" />
    <AvaloniaResource Include="Assets\flags\de.png" />
    <AvaloniaResource Include="Assets\flags\fr.png" />
    <AvaloniaResource Include="Assets\flags\es.png" />
    <Content Include="Assets\Icons\app-128.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\app-1024.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TOTP.Camera.OpenCv\TOTP.Camera.OpenCv.csproj" />
    <ProjectReference Include="..\TOTP.Core\TOTP.Core.csproj" />
    <ProjectReference Include="..\TOTP.DAL\TOTP.DAL.csproj" />
    <ProjectReference Include="..\TOTP.Infrastructure\TOTP.Infrastructure.csproj" />
    <ProjectReference Include="..\TOTP.UI.Avalonia.Shared\TOTP.UI.Avalonia.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <ProjectReference Include="..\TOTP.Platform.Windows\TOTP.Platform.Windows.csproj" />
    <ProjectReference Include="..\TOTP.Updater\TOTP.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" />
    <ProjectReference Include="..\TOTP.Platform.MacOS\TOTP.Platform.MacOS.csproj" />
    <ProjectReference Include="..\TOTP.Platform.Unix\TOTP.Platform.Unix.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <ProjectReference Include="..\TOTP.Platform.Linux\TOTP.Platform.Linux.csproj" />
    <ProjectReference Include="..\TOTP.Platform.Unix\TOTP.Platform.Unix.csproj" />
  </ItemGroup>

  <Target Name="DeriveLocalVersionFromLatestReleaseTag"
          BeforeTargets="GetAssemblyVersion;AddSourceRevisionToInformationalVersion;GenerateAssemblyInfo"
          Condition="'$(Version)' == '1.0.0' AND Exists('$(MSBuildProjectDirectory)\..\.git')">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\.."
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_LocalVersionTagOutput" />
    </Exec>
    <PropertyGroup>
      <_LocalVersionTag>@(_LocalVersionTagOutput->'%(Identity)')</_LocalVersionTag>
      <_HasLocalVersionTag>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_LocalVersionTag)', '^v\d+\.\d+\.\d+(?:-rc\d+)?$'))</_HasLocalVersionTag>
      <_LocalProductVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(_LocalVersionTag)', '^v', ''))</_LocalProductVersion>
      <_LocalNumericVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match('$(_LocalProductVersion)', '^\d+\.\d+\.\d+').Value).0</_LocalNumericVersion>
      <_LocalFileRevision Condition="'$(_HasLocalVersionTag)' == 'True' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(_LocalProductVersion)', '-rc\d+$'))">$([System.Text.RegularExpressions.Regex]::Match('$(_LocalProductVersion)', '-rc(?&lt;revision&gt;\d+)$').Groups['revision'].Value)</_LocalFileRevision>
      <_LocalFileRevision Condition="'$(_HasLocalVersionTag)' == 'True' AND '$(_LocalFileRevision)' == ''">65535</_LocalFileRevision>
      <_LocalFileVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match('$(_LocalProductVersion)', '^\d+\.\d+\.\d+').Value).$(_LocalFileRevision)</_LocalFileVersion>
      <Version Condition="'$(_HasLocalVersionTag)' == 'True'">$(_LocalProductVersion)</Version>
      <AssemblyVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$(_LocalNumericVersion)</AssemblyVersion>
      <FileVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$(_LocalFileVersion)</FileVersion>
      <InformationalVersion Condition="'$(_HasLocalVersionTag)' == 'True'">$(_LocalProductVersion)+local</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion Condition="'$(_HasLocalVersionTag)' == 'True'">false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
  </Target>

  <Target Name="CopyWindowsUpdaterBundleToOutput"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="..\TOTP.Updater\TOTP.Updater.csproj"
             Targets="Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed"
             Properties="Configuration=$(Configuration);Version=$(Version);InformationalVersion=$(InformationalVersion);IncludeSourceRevisionInInformationalVersion=$(IncludeSourceRevisionInInformationalVersion);FileVersion=$(FileVersion);AssemblyVersion=$(AssemblyVersion)" />
    <ItemGroup>
      <WindowsUpdaterBundleOutput Include="..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*"
                                  Exclude="..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\ref\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\publish\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsUpdaterBundleOutput)"
          DestinationFiles="@(WindowsUpdaterBundleOutput->'$(OutDir)TOTP.Updater\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWindowsUpdaterBundleToPublish"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="..\TOTP.Updater\TOTP.Updater.csproj"
             Targets="Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed"
             Properties="Configuration=$(Configuration);Version=$(Version);InformationalVersion=$(InformationalVersion);IncludeSourceRevisionInInformationalVersion=$(IncludeSourceRevisionInInformationalVersion);FileVersion=$(FileVersion);AssemblyVersion=$(AssemblyVersion)" />
    <ItemGroup>
      <WindowsUpdaterBundlePublish Include="..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*"
                                   Exclude="..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\ref\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\publish\**\*;..\TOTP.Updater\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsUpdaterBundlePublish)"
          DestinationFiles="@(WindowsUpdaterBundlePublish->'$(PublishDir)TOTP.Updater\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
