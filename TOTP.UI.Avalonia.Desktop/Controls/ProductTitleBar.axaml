<UserControl
    x:Class="TOTP.Avalonia.Desktop.Controls.ProductTitleBar"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    Height="34">
    <Border
        Background="{DynamicResource BrushAccent}"
        BorderBrush="{DynamicResource BrushFocus}"
        BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,34">
            <Image
                Width="18"
                Height="18"
                Margin="8,0,7,0"
                IsVisible="{Binding ShowIcon, ElementName=Root}"
                Source="/Assets/Icons/app.ico" />
            <Border
                Grid.Column="1"
                Background="Transparent"
                Padding="{Binding TitlePadding, ElementName=Root}"
                PointerPressed="MoveWindow">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource BrushOnAccent}"
                    Text="{Binding Title, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <Button
                Grid.Column="2"
                automation:AutomationProperties.Name="{DynamicResource Minimize}"
                Classes="titlebar-control titlebar-minimize"
                Click="MinimizeWindow"
                IsVisible="{Binding ShowMinimizeButton, ElementName=Root}">
                <Path
                    Width="12"
                    Height="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 1,10.5 L 11,10.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="2"
                    Stretch="None" />
            </Button>
            <Button
                Grid.Column="3"
                automation:AutomationProperties.Name="{DynamicResource Close}"
                Classes="titlebar-control titlebar-close"
                Click="CloseWindow">
                <Path
                    Width="12"
                    Height="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 1,1.5 L 11,11.5 M 11,1.5 L 1,11.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="2"
                    Stretch="None" />
            </Button>
        </Grid>
    </Border>
</UserControl>
