<Window
    x:Class="TOTP.Avalonia.Desktop.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:Name="SettingsRoot"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource Settings}"
    Width="520"
    Height="620"
    MinWidth="520"
    MinHeight="480"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseSettingsCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.settings-action">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        </Style>
        <Style Selector="Button.settings-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Button.settings-action:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}" />
        </Style>
        <Style Selector="Expander.faq-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-section /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushFaqHeaderBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-subsection">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFaqHeaderForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.faq-subsection /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid
        x:Name="SettingsWindowSurface"
        Background="Transparent"
        PointerPressed="MoveWindow">
        <Grid
            Margin="16"
            Classes="settings-page"
            RowDefinitions="Auto,*">
            <Grid MinHeight="48" ColumnDefinitions="*,Auto">
                <Border
                    Grid.Column="0"
                    Background="Transparent">
                    <TextBlock Classes="page-title" Text="{DynamicResource Settings}" />
                </Border>
                <Button
                    Grid.Column="1"
                    automation:AutomationProperties.Name="{DynamicResource CloseSettings}"
                    Classes="icon"
                    Command="{Binding CloseSettingsCommand}"
                    Content="✕"
                    ToolTip.Tip="{DynamicResource CloseSettings}" />
            </Grid>
            <TabControl
                Grid.Row="1"
                Margin="0,8,0,0"
                Classes="settings-tabs"
                SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabItem Header="{DynamicResource Security}">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer
                            x:Name="SecuritySettingsScroll"
                            Grid.Row="0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,8,4,4" Spacing="12">
                            <ContentControl x:Name="AuthorizationSettingsHost" Content="{Binding AuthorizationSettings}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:AuthorizationSettingsViewModel">
                                    <StackPanel Spacing="12">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource QuickUnlock}" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource QuickUnlockRecoveryNotice}" TextWrapping="Wrap" />
                                                <StackPanel Spacing="6">
                                                    <RadioButton
                                                        Command="{Binding EnableQuickUnlockCommand}"
                                                        Content="{DynamicResource QuickUnlockAtStartup}"
                                                        GroupName="StartupUnlockMethod"
                                                        IsChecked="{Binding IsQuickUnlockEnabled, Mode=OneWay}" />
                                                    <RadioButton
                                                        Command="{Binding UsePasswordCommand}"
                                                        Content="{DynamicResource UsePasswordAtStartup}"
                                                        GroupName="StartupUnlockMethod"
                                                        IsChecked="{Binding !IsQuickUnlockEnabled, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Classes="settings-action"
                                                    Command="{Binding RefreshCommand}"
                                                    Content="{DynamicResource Retry}"
                                                    IsVisible="{Binding ShowQuickUnlockRetry}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ChangeMasterPassword}" />
                                                <shared:RevealableSecretInput AccessibleName="{DynamicResource NewPassword}" PlaceholderText="{DynamicResource NewPassword}" Text="{Binding NewPassword, Mode=TwoWay}" />
                                                <shared:RevealableSecretInput AccessibleName="{DynamicResource ConfirmPassword}" PlaceholderText="{DynamicResource ConfirmPassword}" Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                                <Button
                                                    x:Name="MasterPasswordChangeButton"
                                                    Classes="settings-action"
                                                    Command="{Binding ChangePasswordCommand}"
                                                    Content="{DynamicResource ChangeMasterPassword}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="panel">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="section-title" Text="{DynamicResource RecoveryAndCompatibility}" />
                                                <TextBlock Text="{DynamicResource PortableEnvelopeStatus}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource AutomaticRollbackStatus}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource LegacyMigrationStatus}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl x:Name="SecurityBehaviorSettingsHost" Content="{Binding SettingsPage}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                        <Border x:Name="SecurityBehaviorSettings" Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="settings-label" Text="{DynamicResource IdleTimeout}" />
                                                <ComboBox
                                                    x:Name="AutoLockSelector"
                                                    ItemsSource="{Binding AutoLockOptions}"
                                                    SelectedItem="{Binding SelectedAutoLock, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:SettingsPageViewModel+AutoLockOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <CheckBox Content="{DynamicResource LockWhenMinimized}" IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                                                <CheckBox Content="{DynamicResource LockOnSessionLock}" IsChecked="{Binding LockOnSessionLock, Mode=TwoWay}" />
                                                <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource ClipboardClearSeconds}" />
                                                <ComboBox
                                                    x:Name="ClipboardLifetimeSelector"
                                                    ItemsSource="{Binding ClipboardLifetimeOptions}"
                                                    SelectedItem="{Binding SelectedClipboardLifetime, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:SettingsPageViewModel+ClipboardLifetimeOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Backups}">
                    <ContentControl
                        x:Name="ImportExportSettingsHost"
                        Content="{Binding NativeFilePicker}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                                <Grid RowDefinitions="*,Auto">
                                    <ScrollViewer
                                        Grid.Row="0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="4,8,4,4" VerticalAlignment="Top" Spacing="12">
                                            <Border Classes="panel">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Classes="section-title" Text="{DynamicResource BackupAndRecovery}" />
                                                    <TextBlock
                                                        Classes="secondary"
                                                        Text="{DynamicResource BackupSecuritySummary}"
                                                        TextWrapping="Wrap" />
                                                    <Border
                                                        x:Name="EncryptedBackupExportPanel"
                                                        Background="{DynamicResource BrushSurfaceAlternate}"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="10">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Classes="settings-label" Text="{DynamicResource BackupSection}" />
                                                            <TextBlock
                                                                Classes="secondary"
                                                                Text="{DynamicResource EncryptedBackupHelp}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Classes="secondary"
                                                                Text="{Binding BackupLocationText}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                x:Name="EncryptedBackupExportButton"
                                                                Classes="primary wide settings-action"
                                                                Command="{Binding ExportCommand}"
                                                                Content="{DynamicResource ExportBackupAction}" />
                                                            <CheckBox
                                                                x:Name="OpenExportAfterCheckBox"
                                                                Content="{DynamicResource OpenExportAfter}"
                                                                IsChecked="{Binding DataContext.SettingsPage.OpenExportFileAfterExport, ElementName=SettingsRoot, Mode=TwoWay}" />
                                                            <Button
                                                                x:Name="OpenLastBackupFolderButton"
                                                                Classes="secondary wide settings-action"
                                                                Command="{Binding OpenLastBackupFolderCommand}"
                                                                Content="{DynamicResource OpenLastBackupFolder}"
                                                                IsVisible="{Binding HasLastBackupFolder}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border
                                                        x:Name="EncryptedBackupRestorePanel"
                                                        Background="{DynamicResource BrushSurfaceAlternate}"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="10">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Classes="settings-label" Text="{DynamicResource RestoreSection}" />
                                                            <TextBlock
                                                                Classes="secondary"
                                                                Text="{DynamicResource RestoreBackupHelp}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock Classes="settings-label" Text="{DynamicResource ImportConflictHandling}" />
                                                            <ComboBox
                                                                x:Name="RestoreConflictStrategyComboBox"
                                                                ItemsSource="{Binding ConflictStrategies}"
                                                                SelectedItem="{Binding SelectedConflictStrategyOption, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="presentation:NativeFilePickerViewModel+ImportStrategyOption">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button
                                                                x:Name="EncryptedBackupRestoreButton"
                                                                Classes="wide settings-action"
                                                                Command="{Binding RestoreBackupCommand}"
                                                                Content="{DynamicResource RestoreBackupAction}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem Header="{DynamicResource ImportExport}">
                    <ContentControl x:Name="AccountImportSettingsHost" Content="{Binding NativeFilePicker}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:NativeFilePickerViewModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,8,4,4" VerticalAlignment="Top" Spacing="12">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ImportOtherFormats}" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource OtherFormatsImportHelp}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource OtherFormatAegis}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource OtherFormatTwoFas}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource OtherFormatOtpAuth}" TextWrapping="Wrap" />
                                                <TextBlock Classes="settings-label" Text="{DynamicResource ImportConflictHandling}" />
                                                <ComboBox x:Name="OtherFormatsConflictStrategyComboBox" ItemsSource="{Binding ConflictStrategies}" SelectedItem="{Binding SelectedConflictStrategyOption, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:NativeFilePickerViewModel+ImportStrategyOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="OtherFormatsImportButton" Classes="wide settings-action" Command="{Binding ImportCommand}" Content="{DynamicResource ChooseImportFile}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ImportGoogleAuthenticator}" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource GoogleAuthenticatorImportHelp}" TextWrapping="Wrap" />
                                                <Button x:Name="GoogleAuthenticatorImportButton" Classes="wide settings-action" Command="{Binding ImportGoogleQrCommand}" Content="{DynamicResource ChooseGoogleAuthenticatorQrImage}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem Header="{DynamicResource Appearance}">
                    <ContentControl x:Name="AppearanceSettingsHost" Content="{Binding SettingsPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                <Grid RowDefinitions="*,Auto">
                                    <ScrollViewer
                                        x:Name="AppearanceSettingsScroll"
                                        Grid.Row="0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <Border
                                            x:Name="AppearanceSettingsPanel"
                                            Margin="4,8,4,4"
                                            VerticalAlignment="Top"
                                            Classes="panel">
                                            <StackPanel Spacing="8">
                                            <TextBlock Classes="settings-label" Text="{DynamicResource Language}" />
                                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="localization:LanguageOption">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Image Width="24" Height="18" Source="{Binding Icon}" Stretch="Uniform" />
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource Appearance}" />
                                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="presentation:SettingsPageViewModel+ThemeOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource QrPreviewScale}" />
                                            <NumericUpDown Increment="0.5" Maximum="6" Minimum="1" Value="{Binding QrPreviewScaleFactor, Mode=TwoWay}" />
                                            <StackPanel IsVisible="{Binding IsInterfaceScaleAvailable}" Spacing="8">
                                                <TextBlock Classes="settings-label settings-group-label" Text="{DynamicResource InterfaceScale}" />
                                                <ComboBox ItemsSource="{Binding InterfaceScales}" SelectedItem="{Binding SelectedInterfaceScale, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:SettingsPageViewModel+InterfaceScaleOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Classes="secondary" Text="{DynamicResource InterfaceScaleHelp}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem Header="{DynamicResource IconPacks}">
                    <ContentControl x:Name="BrandIconSettingsHost" Content="{Binding SettingsPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Border x:Name="BrandIconsPanel" Margin="4,8,4,4" Classes="panel">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="section-title" Text="{DynamicResource BrandIcons}" />
                                            <TextBlock Classes="secondary" Text="{DynamicResource BrandIconsHelp}" TextWrapping="Wrap" />
                                            <TextBlock Classes="secondary" Text="{DynamicResource BrandIconsFormatHelp}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Classes="settings-label"
                                                Text="{Binding DataContext.NativeFilePicker.BrandIconPackStatusText, ElementName=SettingsRoot}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                x:Name="BrandIconsImportButton"
                                                Classes="wide settings-action"
                                                Command="{Binding DataContext.NativeFilePicker.ImportBrandIconsCommand, ElementName=SettingsRoot}"
                                                Content="{DynamicResource ImportSimpleIconsPack}" />
                                            <Button
                                                x:Name="BrandIconsResetButton"
                                                Classes="secondary wide settings-action"
                                                Command="{Binding DataContext.NativeFilePicker.ResetBrandIconsCommand, ElementName=SettingsRoot}"
                                                Content="{DynamicResource ResetBrandIcons}"
                                                IsVisible="{Binding DataContext.NativeFilePicker.HasImportedBrandIcons, ElementName=SettingsRoot}" />
                                            <CheckBox Content="{DynamicResource ShowIssuerLogo}" IsChecked="{Binding ShowIssuerLogo, Mode=TwoWay}" />
                                            <TextBlock Classes="secondary" Text="{DynamicResource ShowIssuerLogoHelp}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem Header="{DynamicResource Miscellaneous}">
                    <ContentControl x:Name="MiscSettingsHost" Content="{Binding SettingsPage}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Border x:Name="MiscSettingsPanel" Margin="4,8,4,4" VerticalAlignment="Top" Classes="panel">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="settings-label" Text="{DynamicResource LoggingLevel}" />
                                            <ComboBox
                                                x:Name="MinimumLoggingLevelPicker"
                                                ItemsSource="{Binding LogLevels}"
                                                SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </TabItem>
                <TabItem Header="{DynamicResource Faq}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,4,4" Spacing="10">
                                <Border
                                    x:Name="FaqIconPacksCard"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource BrushFaqHeaderBackground}"
                                    BoxShadow="{DynamicResource ElevationCard}"
                                    CornerRadius="8">
                                    <Expander
                                        x:Name="FaqIconPacksExpander"
                                        Classes="faq-section"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="14,10" MinHeight="38" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <shared:SymbolIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderIcon}"
                                                    IconSize="22"
                                                    Kind="Folder" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderForeground}"
                                                    FontWeight="SemiBold"
                                                    Text="{DynamicResource FaqImportIconPacksQuestion}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border
                                            Background="{DynamicResource BrushFaqContentBackground}"
                                            CornerRadius="0,0,8,8"
                                            Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="secondary" Text="{DynamicResource FaqImportIconPacksAnswer}" TextWrapping="Wrap" />
                                                <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportIconPacksSources}" TextWrapping="Wrap" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{DynamicResource FaqSimpleIconsOfficialLink}"
                                                    NavigateUri="https://github.com/simple-icons/simple-icons"
                                                    Padding="0,3" />
                                                <HyperlinkButton
                                                    HorizontalAlignment="Left"
                                                    Content="{DynamicResource FaqAegisIconPackDocsLink}"
                                                    NavigateUri="https://github.com/beemdevelopment/Aegis/blob/master/docs/iconpacks.md"
                                                    Padding="0,3" />
                                                <TextBlock Classes="secondary" Text="{DynamicResource FaqImportIconPacksDisclaimer}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                                <Border
                                    x:Name="FaqImportFormatsCard"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource BrushFaqHeaderBackground}"
                                    BoxShadow="{DynamicResource ElevationCard}"
                                    CornerRadius="8">
                                    <Expander
                                        x:Name="FaqImportFormatsExpander"
                                        Classes="faq-section"
                                        Expanded="FaqSectionExpanded"
                                        HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="14,10" MinHeight="38" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <shared:SymbolIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderIcon}"
                                                    IconSize="22"
                                                    Kind="QrCode" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BrushFaqHeaderForeground}"
                                                    FontWeight="SemiBold"
                                                    Text="{DynamicResource FaqImportFormatsQuestion}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Expander.Header>
                                        <Border
                                            Background="{DynamicResource BrushFaqContentBackground}"
                                            CornerRadius="0,0,8,8"
                                            Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsIntro}" TextWrapping="Wrap" />
                                                <Expander
                                                    x:Name="FaqImportFormatsAegisExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsAegisTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsAegisDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsAegisExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsTwoFasExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsTwoFasTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsTwoFasDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsTwoFasExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander
                                                    x:Name="FaqImportFormatsOtpAuthExpander"
                                                    Classes="faq-subsection"
                                                    Expanded="FaqImportFormatSectionExpanded">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource FaqImportFormatsOtpAuthTitle}" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,2,8,10" Spacing="8">
                                                        <TextBlock Classes="secondary" Text="{DynamicResource FaqImportFormatsOtpAuthDescription}" TextWrapping="Wrap" />
                                                        <Border Background="{DynamicResource BrushSurfaceAlternate}" CornerRadius="6" Padding="8">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{DynamicResource FaqImportFormatsOtpAuthExample}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource About}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8" Spacing="12">
                            <ContentControl Content="{Binding SettingsPage}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:SettingsPageViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource About}" />
                                                <TextBlock Text="{Binding VersionText}" />
                                                <Button Classes="settings-action" Command="{Binding OpenLogFolderCommand}" Content="{DynamicResource OpenLogFolder}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Content="{Binding UpdateCheck}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:UpdateCheckViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="section-title" Text="{DynamicResource SoftwareUpdates}" />
                                                <ProgressBar
                                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                    IsVisible="{Binding IsDownloadInProgress}"
                                                    Maximum="100"
                                                    Value="{Binding ProgressPercentage}" />
                                                <Button
                                                    Classes="settings-action"
                                                    Command="{Binding CheckCommand}"
                                                    Content="{DynamicResource VerifyAppcast}"
                                                    IsVisible="{Binding ShowCheckAction}" />
                                                <Button
                                                    Classes="settings-action"
                                                    Command="{Binding DownloadCommand}"
                                                    Content="{DynamicResource DownloadUpdate}"
                                                    IsVisible="{Binding ShowDownloadAction}" />
                                                <Button
                                                    Classes="settings-action"
                                                    Command="{Binding InstallCommand}"
                                                    Content="{DynamicResource InstallUpdate}"
                                                    IsVisible="{Binding ShowInstallAction}" />
                                                <Button
                                                    Classes="settings-action"
                                                    Command="{Binding CancelCommand}"
                                                    Content="{DynamicResource Cancel}"
                                                    IsVisible="{Binding ShowCancelAction}" />
                                                <TextBlock IsVisible="{Binding HasReleaseNotes}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Content="{Binding Diagnostics}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:DiagnosticsViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource SupportDiagnostics}" />
                                                <Button Classes="settings-action" Command="{Binding RefreshCommand}" Content="{DynamicResource RefreshSupportInformation}" />
                                                <TextBox AcceptsReturn="True" IsReadOnly="True" MinHeight="100" Text="{Binding SupportInformation}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <shared:NotificationBanner
            x:Name="SettingsNotificationToast"
            ZIndex="50"
            Margin="16,16,16,18"
            Classes="toast"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Severity="{Binding SettingsNotification.Severity}"
            Text="{Binding SettingsNotification.Text}" />
        <Border
            x:Name="SettingsImportProgressOverlay"
            ZIndex="100"
            Background="{DynamicResource BrushOverlayLight}"
            IsVisible="{Binding NativeFilePicker.IsImportProgressVisible}">
            <Border
                Width="300"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BrushSurface}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <ProgressBar IsIndeterminate="{Binding NativeFilePicker.IsImportProgressVisible}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding NativeFilePicker.ImportProgressText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
