<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource AppTitle}"
    Width="380"
    Height="540"
    MinWidth="360"
    MinHeight="200"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    Icon="avares://TOTP.UI.Avalonia.Desktop/Assets/Icons/app.ico">

    <Grid RowDefinitions="Auto,*">
        <controls:ProductTitleBar
            LockCommand="{Binding LockCommand}"
            ShowLockButton="{Binding IsShellVisible}"
            ShowMinimizeButton="True"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
        <shared:BusyOverlay
            Grid.Row="1"
            BusyMessage="{DynamicResource StartingSafely}"
            IsBusy="{Binding IsBusy}">
        <Grid Background="{DynamicResource BrushWindowBackground}">

            <!-- Locked and first-run presentation uses the compact authorization gate. -->
            <ScrollViewer
                Margin="20"
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding !IsShellVisible}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Image
                        Width="54"
                        Height="54"
                        HorizontalAlignment="Center"
                        Source="/Assets/Icons/app.ico" />
                    <TextBlock
                        automation:AutomationProperties.HeadingLevel="1"
                        Classes="app-title"
                        HorizontalAlignment="Center"
                        Text="{DynamicResource AppHeading}" />
                    <shared:NotificationBanner
                        Severity="{Binding Notification.Severity}"
                        Text="{Binding Notification.Text}" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding InitializeCommand}"
                        Content="{DynamicResource Retry}"
                        IsVisible="{Binding CanRetry}" />

                    <Border Classes="unlock-card" IsVisible="{Binding IsQuickUnlockVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="{DynamicResource QuickUnlock}" />
                            <TextBlock
                                Classes="secondary"
                                Text="{DynamicResource QuickUnlockRecoveryNotice}"
                                TextWrapping="Wrap" />
                            <shared:ValidationMessage
                                Severity="Error"
                                Text="{Binding QuickUnlockMessage}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsQuickUnlockBusy}" />
                            <Button
                                x:Name="BiometricUnlockButton"
                                Width="56"
                                Height="56"
                                MinHeight="56"
                                HorizontalAlignment="Center"
                                Padding="10"
                                automation:AutomationProperties.Name="{DynamicResource UnlockWithQuickUnlock}"
                                Classes="primary"
                                Command="{Binding QuickUnlockCommand}"
                                ToolTip.Tip="{DynamicResource UnlockWithQuickUnlock}">
                                <Viewbox Width="30" Height="30" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Canvas.Styles>
                                            <Style Selector="Path">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{DynamicResource BrushOnAccent}" />
                                                <Setter Property="StrokeThickness" Value="1.8" />
                                                <Setter Property="StrokeLineCap" Value="Round" />
                                            </Style>
                                        </Canvas.Styles>
                                        <Path Data="M4,11 C4,6.6 7.6,3 12,3 C16.4,3 20,6.6 20,11" />
                                        <Path Data="M7,12 C7,9.2 9.2,7 12,7 C14.8,7 17,9.2 17,12 C17,17 15.2,20.4 13,22" />
                                        <Path Data="M10,13 C10,11.9 10.9,11 12,11 C13.1,11 14,11.9 14,13 C14,16.5 12.7,19 11,21" />
                                        <Path Data="M4,14 C4.3,17.8 5.6,20.4 7.4,22" />
                                        <Path Data="M7,14 C7.2,17.1 8.2,19.1 9.4,20.5" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                Classes="link wide"
                                Command="{Binding UsePasswordFallbackCommand}"
                                Content="{DynamicResource UseMasterPassword}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordUnlockVisible}">
                        <StackPanel Spacing="10">
                            <ContentControl Content="{Binding PasswordUnlock}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Classes="section-title"
                                                Text="{DynamicResource MasterPassword}" />
                                            <shared:ValidationMessage
                                                Severity="Error"
                                                Text="{Binding Message}" />
                                            <shared:RevealableSecretInput
                                                x:Name="PasswordUnlockInput"
                                                AccessibleName="{DynamicResource MasterPassword}"
                                                HelpText="{DynamicResource MasterPasswordHelp}"
                                                IsRequired="True"
                                                PlaceholderText="{DynamicResource MasterPassword}"
                                                Text="{Binding Password, Mode=TwoWay}" />
                                            <Button
                                                Classes="primary wide"
                                                Command="{Binding UnlockCommand}"
                                                Content="{DynamicResource Unlock}"
                                                IsDefault="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <Button
                                Classes="link wide"
                                Command="{Binding ReturnToQuickUnlockCommand}"
                                Content="{DynamicResource UnlockWithQuickUnlock}"
                                IsVisible="{Binding IsReturnToQuickUnlockVisible}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordSetupVisible}">
                        <ContentControl Content="{Binding PasswordSetup}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:PasswordSetupViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Classes="section-title"
                                            Text="{DynamicResource CreatePasswordHeading}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Classes="secondary"
                                            Text="{DynamicResource PasswordSetupHelp}"
                                            TextWrapping="Wrap" />
                                        <shared:RevealableSecretInput
                                            x:Name="PasswordSetupInput"
                                            AccessibleName="{DynamicResource NewPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource NewPassword}"
                                            Text="{Binding Password, Mode=TwoWay}" />
                                        <shared:RevealableSecretInput
                                            AccessibleName="{DynamicResource ConfirmPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource ConfirmPassword}"
                                            Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                        <shared:ValidationMessage Severity="Error" Text="{Binding Message}" />
                                        <Button
                                            Classes="primary wide"
                                            Command="{Binding ConfigureCommand}"
                                            Content="{DynamicResource CreateVault}"
                                            IsDefault="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Authorized shell uses the compact toolbar/list/code hierarchy. -->
            <Grid
                x:Name="AuthorizedShell"
                RowDefinitions="Auto,*"
                IsVisible="{Binding IsShellVisible}">
                <Border
                    x:Name="MainToolbar"
                    Grid.Row="0"
                    Classes="toolbar"
                    IsEnabled="{Binding !IsSettingsVisible}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                        <Button
                            x:Name="ScanQrButton"
                            Grid.Column="0"
                            automation:AutomationProperties.Name="{DynamicResource QrScannerSupportedFormats}"
                            Classes="icon"
                            Command="{Binding ScanQrCommand}"
                            ToolTip.Tip="{DynamicResource QrScannerSupportedFormats}">
                            <shared:SymbolIcon Foreground="#E16C6C" IconSize="16" Kind="Camera" />
                        </Button>
                        <Button
                            x:Name="AddAccountButton"
                            Grid.Column="1"
                            automation:AutomationProperties.Name="{DynamicResource AddAccount}"
                            Classes="icon"
                            Command="{Binding BeginAddAccountCommand}"
                            ToolTip.Tip="{DynamicResource AddAccountShortcut}">
                            <shared:SymbolIcon Foreground="#87CE3E" IconSize="16" Kind="Add" />
                        </Button>
                        <Button
                            x:Name="ManageGroupsButton"
                            Grid.Column="2"
                            automation:AutomationProperties.Name="{DynamicResource CreateGroup}"
                            Classes="icon"
                            Command="{Binding AccountList.BeginAddGroupCommand}"
                            ToolTip.Tip="{DynamicResource ManageGroups}">
                            <shared:SymbolIcon Foreground="#4F6BED" IconSize="16" Kind="FolderAdd" />
                        </Button>
                        <Button
                            x:Name="ToggleSearchButton"
                            Grid.Column="3"
                            automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                            Classes="icon"
                            Click="FocusAccountSearch"
                            Command="{Binding ToggleSearchCommand}"
                            ToolTip.Tip="{DynamicResource SearchAccountsShortcut}">
                            <shared:SymbolIcon Foreground="#87CE3E" IconSize="16" Kind="Search" />
                        </Button>
                        <Grid
                            x:Name="AccountSearchHost"
                            Grid.Column="4"
                            Margin="4,0"
                            ColumnDefinitions="*,Auto"
                            IsVisible="{Binding IsSearchVisible}">
                            <TextBox
                                x:Name="AccountSearchBox"
                                Grid.ColumnSpan="2"
                                MinWidth="72"
                                MinHeight="28"
                                Padding="7,2,22,2"
                                automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                Classes="search"
                                PlaceholderText="{DynamicResource SearchAccounts}"
                                Text="{Binding AccountList.SearchText, Mode=TwoWay}" />
                            <Button
                                x:Name="ClearSearchButton"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                Margin="0,0,2,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{DynamicResource ClearSearch}"
                                Classes="link"
                                Click="RefocusAccountSearchAfterClear"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                IsVisible="{Binding AccountList.HasSearchText}" />
                        </Grid>
                        <StackPanel
                            x:Name="ToolbarTrailingActions"
                            Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="4">
                            <ComboBox
                                x:Name="LanguageSelector"
                                Width="64"
                                MinHeight="28"
                                Margin="0"
                                Padding="2"
                                HorizontalContentAlignment="Center"
                                automation:AutomationProperties.Name="{DynamicResource Language}"
                                ItemsSource="{Binding SettingsPage.Languages}"
                                SelectedItem="{Binding SettingsPage.SelectedLanguage, Mode=TwoWay}"
                                ToolTip.Tip="{DynamicResource Language}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="localization:LanguageOption">
                                        <Image
                                            Width="24"
                                            Height="18"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Center"
                                            Source="{Binding Icon}"
                                            Stretch="Uniform"
                                            ToolTip.Tip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                x:Name="OpenSettingsButton"
                                Margin="0"
                                automation:AutomationProperties.Name="{DynamicResource Settings}"
                                Classes="icon"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip.Tip="{DynamicResource Settings}">
                                <shared:SymbolIcon Foreground="#787373" IconSize="16" Kind="Settings" />
                            </Button>
                            <Button
                                x:Name="AccountSortButton"
                                Margin="0"
                                automation:AutomationProperties.Name="{DynamicResource SortAccounts}"
                                Classes="icon"
                                Click="ToggleAccountSortMenu"
                                IsVisible="{Binding AccountList.HasMultipleAccounts}"
                                ToolTip.Tip="{DynamicResource SortAccounts}">
                                <shared:SymbolIcon IconSize="20" Kind="Sort" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl
                        x:Name="AccountListPage"
                        Content="{Binding AccountList}"
                        IsVisible="{Binding IsAccountListVisible}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:AccountListViewModel">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="AccountPageScrollViewer"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel
                                            x:Name="AccountPageContent"
                                            Margin="10,8,10,12"
                                            VerticalAlignment="Top"
                                            Spacing="8">
                                            <StackPanel IsVisible="{Binding HasAccountNavigationCards}" Spacing="6">
                                                <Grid ColumnDefinitions="10,*">
                                                    <Button
                                                        x:Name="GroupBackButton"
                                                        Grid.Column="0"
                                                        Height="50"
                                                        HorizontalAlignment="Left"
                                                        Margin="-7,2,1,2"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        Width="16"
                                                        automation:AutomationProperties.Name="{Binding AccountNavigationBackLabel}"
                                                        Classes="icon"
                                                        Command="{Binding ClearGroupFilterCommand}"
                                                        IsVisible="{Binding HasSelectedAccountNavigationCard}"
                                                        ToolTip.Tip="{Binding AccountNavigationBackLabel}">
                                                        <shared:SymbolIcon IconSize="12" Kind="ArrowLeft" />
                                                    </Button>
                                                    <ScrollViewer
                                                        x:Name="GroupCardsScrollViewer"
                                                        Grid.Column="1"
                                                        MaxHeight="72"
                                                        HorizontalScrollBarVisibility="Hidden"
                                                        PointerWheelChanged="ScrollGroupsHorizontally"
                                                        VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border
                                                                x:Name="FavoritesGroupCard"
                                                                Width="150"
                                                                MinHeight="54"
                                                                Margin="2"
                                                                Background="{Binding FavoriteGroupBackground}"
                                                                Classes="group-card"
                                                                Classes.selected="{Binding IsFavoritesFilterSelected}"
                                                                CornerRadius="7">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Classes="account-context-menu">
                                                                        <MenuItem Command="{Binding BeginEditFavoritesCommand}" Header="{DynamicResource EditFavorites}">
                                                                            <MenuItem.Icon>
                                                                                <shared:SymbolIcon IconSize="15" Kind="Edit" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Button
                                                                    automation:AutomationProperties.Name="{DynamicResource FavoriteAccounts}"
                                                                    Classes="group-card-hit-target"
                                                                    Command="{Binding ToggleFavoritesFilterCommand}"
                                                                    Foreground="{DynamicResource BrushTextPrimary}"
                                                                    ToolTip.Tip="{DynamicResource FavoriteAccounts}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <shared:SymbolIcon Foreground="{Binding FavoriteGroupForeground}" IconSize="20" Kind="Favorite" />
                                                                        <StackPanel>
                                                                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource FavoriteAccounts}" />
                                                                            <TextBlock FontSize="11" Text="{Binding FavoriteCount}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="presentation:AccountGroupListItemViewModel">
                                                                    <Border
                                                                        Width="150"
                                                                        MinHeight="54"
                                                                        Margin="2"
                                                                        Background="{Binding Background}"
                                                                        Classes="group-card"
                                                                        Classes.selected="{Binding IsSelected}"
                                                                        CornerRadius="7">
                                                                        <Border.ContextMenu>
                                                                            <ContextMenu Classes="account-context-menu">
                                                                                <MenuItem Command="{Binding EditCommand}" Header="{DynamicResource EditGroup}">
                                                                                    <MenuItem.Icon>
                                                                                        <shared:SymbolIcon IconSize="15" Kind="Edit" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Classes="danger-context-item"
                                                                                    Command="{Binding DeleteCommand}"
                                                                                    Header="{DynamicResource DeleteGroup}">
                                                                                    <MenuItem.Icon>
                                                                                        <shared:SymbolIcon IconSize="15" Kind="Delete" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                                                        <Button
                                                                            Classes="group-card-hit-target"
                                                                            Command="{Binding SelectCommand}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                                <shared:SymbolIcon
                                                                                    Foreground="{Binding Foreground}"
                                                                                    IconSize="20"
                                                                                    Kind="Folder" />
                                                                                <StackPanel>
                                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                                    <TextBlock FontSize="11" Text="{Binding AccountCount}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>
                                            </StackPanel>
                                            <Grid>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    FontSize="11"
                                                    IsVisible="{Binding HasActiveAccountFilter}"
                                                    Text="{Binding SearchResultSummary}" />
                                            </Grid>
                                            <Grid x:Name="AccountListRegion">
                                                <controls:ContextPreservingAccountListBox
                                                    x:Name="AccountsListBox"
                                                    automation:AutomationProperties.Name="{DynamicResource AccountsList}"
                                                    Classes="accounts desktop-accounts"
                                                    ContextAccount="{Binding ContextAccount, Mode=TwoWay}"
                                                    ItemsSource="{Binding Accounts}"
                                                    SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ContextMenu>
                                                        <ContextMenu Classes="account-context-menu">
                                                            <MenuItem Command="{Binding BeginContextEditCommand}" Header="{DynamicResource EditAccountShortcut}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="Edit" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Command="{Binding GenerateContextQrCommand}" Header="{DynamicResource ShowQrCode}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="QrCode" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Margin="6,4" />
                                                            <MenuItem
                                                                Classes="danger-context-item"
                                                                Command="{Binding DeleteContextAccountCommand}"
                                                                Header="{DynamicResource DeleteAccountShortcut}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="Delete" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </ListBox.ContextMenu>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:AccountListItemViewModel">
                                                            <Border
                                                                Classes="account-row-container"
                                                                Classes.recently-added="{Binding IsRecentlyAdded}">
                                                                    <Grid
                                                                        ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                                        RowDefinitions="Auto,Auto"
                                                                        ColumnSpacing="6">
                                                                    <shared:BrandTile
                                                                        Grid.Row="0"
                                                                        Grid.RowSpan="2"
                                                                        Grid.Column="0"
                                                                        IsVisible="{Binding ShowIssuerLogo}"
                                                                        Margin="0,0,6,0"
                                                                        IconData="{Binding Brand.IconData}"
                                                                        Initials="{Binding Brand.Initials}"
                                                                        TileBackground="{Binding Brand.BackgroundBrush}" />
                                                                    <shared:AccountRow
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        AccountName="{Binding AccountName}"
                                                                        Issuer="{Binding Issuer}" />
                                                                    <Button
                                                                        automation:AutomationProperties.Name="{DynamicResource CopyTimedClear}"
                                                                        Grid.Row="0"
                                                                        Grid.Column="4"
                                                                        Classes="row-code"
                                                                        Command="{Binding CopyCodeCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding HasCode}"
                                                                        ToolTip.Tip="{DynamicResource CopyTimedClearShortcut}">
                                                                        <StackPanel HorizontalAlignment="Right" Spacing="1">
                                                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                                                                <shared:SymbolIcon IconSize="10" Kind="Copy" />
                                                                                <TextBlock Text="{Binding DisplayCode}" />
                                                                            </StackPanel>
                                                                            <TextBlock
                                                                                MinHeight="12"
                                                                                HorizontalAlignment="Right"
                                                                                FontSize="9"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource BrushCopyConfirmation}"
                                                                                Text="{Binding CopyConfirmation}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock
                                                                        Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Classes="secondary"
                                                                        IsVisible="{Binding HasCustomPeriod}"
                                                                        Text="{Binding CustomPeriodLabel}" />
                                                                    <Button
                                                                        Grid.Row="0"
                                                                        Grid.Column="3"
                                                                        Width="28"
                                                                        Height="28"
                                                                        MinHeight="28"
                                                                        Padding="5"
                                                                        VerticalAlignment="Center"
                                                                        automation:AutomationProperties.Name="{DynamicResource RemoveFromFavorites}"
                                                                        Classes="icon account-favorite-selected"
                                                                        Command="{Binding ToggleFavoriteCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding IsFavorite}"
                                                                        ToolTip.Tip="{DynamicResource RemoveFromFavorites}">
                                                                        <Viewbox
                                                                            Width="15"
                                                                            Height="15"
                                                                            Stretch="Uniform">
                                                                            <Path
                                                                                Width="24"
                                                                                Height="24"
                                                                                Data="M12,2 L15.1,8.3 L22,9.3 L17,14.2 L18.2,21 L12,17.8 L5.8,21 L7,14.2 L2,9.3 L8.9,8.3 Z"
                                                                                Fill="{DynamicResource BrushFavoriteStarFill}"
                                                                                Stroke="{DynamicResource BrushFavoriteStarOutline}"
                                                                                StrokeThickness="1.6" />
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <Button
                                                                        Grid.Row="0"
                                                                        Grid.Column="3"
                                                                        Width="28"
                                                                        Height="28"
                                                                        MinHeight="28"
                                                                        Padding="5"
                                                                        VerticalAlignment="Center"
                                                                        automation:AutomationProperties.Name="{DynamicResource AddToFavorites}"
                                                                        Classes="icon"
                                                                        Command="{Binding ToggleFavoriteCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding !IsFavorite}"
                                                                        Opacity="0.55"
                                                                        ToolTip.Tip="{DynamicResource AddToFavorites}">
                                                                        <shared:SymbolIcon IconSize="15" Kind="Favorite" />
                                                                    </Button>
                                                                    <ProgressBar
                                                                        Grid.Row="1"
                                                                        Grid.Column="1"
                                                                        Grid.ColumnSpan="4"
                                                                        Classes="account-countdown"
                                                                        Classes.expiring="{Binding IsExpiring}"
                                                                        IsHitTestVisible="False"
                                                                        IsVisible="{Binding HasCode}"
                                                                        Margin="0,3,0,0"
                                                                        Maximum="{Binding PeriodSeconds}"
                                                                        Minimum="0"
                                                                        Value="{Binding RemainingSeconds}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </controls:ContextPreservingAccountListBox>
                                                <Border
                                                    x:Name="FirstAccountOnboardingCard"
                                                    MaxWidth="320"
                                                    Margin="8,20"
                                                    Padding="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Classes="panel"
                                                    IsVisible="{Binding HasNoAccounts}">
                                                    <StackPanel Spacing="9">
                                                        <shared:SymbolIcon
                                                            HorizontalAlignment="Center"
                                                            Foreground="#87CE3E"
                                                            IconSize="28"
                                                            Kind="Add" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Classes="section-title"
                                                            Text="{DynamicResource SetUpFirstAccount}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Classes="secondary"
                                                            Text="{DynamicResource NoEntriesYet}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            x:Name="AddFirstAccountButton"
                                                            automation:AutomationProperties.Name="{DynamicResource AddAccount}"
                                                            Classes="primary wide"
                                                            Command="{Binding BeginAddCommand}"
                                                            Content="{DynamicResource AddAccount}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock
                                                    Margin="0,28"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    IsHitTestVisible="False"
                                                    IsVisible="{Binding HasNoSearchResults}"
                                                    Text="{DynamicResource NoMatchingEntries}" />
                                            </Grid>

                                            <TextBlock
                                                Classes="inline-message"
                                                IsVisible="{Binding HasCodeMessage}"
                                                Text="{Binding CodeMessage}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <shared:NotificationBanner
                                        x:Name="AccountMessageToast"
                                        ZIndex="10"
                                        Margin="16,16,16,18"
                                        Classes="toast"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        Severity="{Binding Notification.Severity}"
                                        Text="{Binding Notification.Text}" />

                                    <Border
                                        x:Name="AccountEditorFlyout"
                                        ZIndex="20"
                                        Margin="0"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Classes="flyout"
                                        IsEnabled="False"
                                        IsHitTestVisible="False"
                                        IsVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="380" />
                                        </Border.RenderTransform>
                                        <ScrollViewer
                                            x:Name="AccountEditorScrollViewer"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel
                                                x:Name="AccountEditorContent"
                                                Margin="0,10,20,10"
                                                Spacing="0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingExistingAccount}"
                                                        Text="{DynamicResource EditAccount}" />
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding !IsEditingExistingAccount}"
                                                        Text="{DynamicResource AddAccount}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        MinHeight="26"
                                                        Classes="icon"
                                                        Command="{Binding CancelEditCommand}"
                                                        Content="✕" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,6,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource Issuer}" />
                                                <TextBox
                                                    x:Name="AccountIssuerBox"
                                                    automation:AutomationProperties.Name="{DynamicResource Issuer}"
                                                    Text="{Binding EditorIssuer, Mode=TwoWay}" />
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorIssuerMessage}" />
                                                <TextBlock
                                                    Margin="0,10,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource Secret}" />
                                                <shared:RevealableSecretInput
                                                    AccessibleName="{DynamicResource Secret}"
                                                    HelpText="{DynamicResource AccountSecretInvalid}"
                                                    IsRequired="True"
                                                    Text="{Binding EditorSecret, Mode=TwoWay}" />
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorSecretMessage}" />
                                                <TextBlock
                                                    Margin="0,10,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource AccountName}" />
                                                <TextBox
                                                    automation:AutomationProperties.Name="{DynamicResource AccountName}"
                                                    Text="{Binding EditorAccountName, Mode=TwoWay}" />
                                                <CheckBox
                                                    Margin="0,12,0,0"
                                                    automation:AutomationProperties.Name="{DynamicResource FavoriteAccount}"
                                                    Content="{DynamicResource FavoriteAccount}"
                                                    IsChecked="{Binding EditorIsFavorite, Mode=TwoWay}" />
                                                <StackPanel
                                                    Margin="0,10,0,0"
                                                    Spacing="6">
                                                    <TextBlock
                                                        Classes="field-label"
                                                        Text="{DynamicResource BrandIcon}" />
                                                    <controls:TypeAheadComboBox
                                                        x:Name="AccountBrandIconComboBox"
                                                        automation:AutomationProperties.Name="{DynamicResource BrandIcon}"
                                                        IsEnabled="{Binding HasBrandIconChoices}"
                                                        ItemsSource="{Binding EditorBrandIconOptions}"
                                                        SelectedItem="{Binding SelectedEditorBrandIconOption, Mode=TwoWay}">
                                                        <controls:TypeAheadComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="presentation:BrandIconOption">
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </controls:TypeAheadComboBox.ItemTemplate>
                                                    </controls:TypeAheadComboBox>
                                                    <TextBlock
                                                        Classes="secondary"
                                                        Text="{DynamicResource BrandIconHelp}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Expander
                                                    x:Name="AccountAdvancedOptions"
                                                    Margin="0,10,0,0"
                                                    Header="{DynamicResource AdvancedOptions}"
                                                    IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock
                                                            Classes="field-label"
                                                            Text="{DynamicResource TotpPeriod}" />
                                                        <NumericUpDown
                                                            automation:AutomationProperties.Name="{DynamicResource TotpPeriod}"
                                                            Increment="5"
                                                            Maximum="3600"
                                                            Minimum="5"
                                                            Value="{Binding EditorPeriodSeconds, Mode=TwoWay}">
                                                            <NumericUpDown.InnerRightContent>
                                                                <Button
                                                                    automation:AutomationProperties.Name="{DynamicResource ClearPeriod}"
                                                                    Classes="numeric-clear"
                                                                    Click="RefocusAccountPeriodAfterClear"
                                                                    Command="{Binding ClearEditorPeriodCommand}"
                                                                    Content="×"
                                                                    IsVisible="{Binding HasEditorPeriodSeconds}"
                                                                    ToolTip.Tip="{DynamicResource ClearPeriod}" />
                                                            </NumericUpDown.InnerRightContent>
                                                        </NumericUpDown>
                                                        <shared:ValidationMessage Severity="Error" Text="{Binding EditorPeriodMessage}" />
                                                        <TextBlock
                                                            Classes="secondary"
                                                            Text="{DynamicResource TotpPeriodHelp}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Expander>
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorMessage}" />
                                                <StackPanel
                                                    Margin="0,16,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button Padding="14,6" Classes="primary" Command="{Binding SaveAccountCommand}" Content="{DynamicResource SaveAccount}" />
                                                    <Button Padding="14,6" Command="{Binding CancelEditCommand}" Content="{DynamicResource CancelEdit}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <Border
                                        x:Name="GroupEditorFlyout"
                                        ZIndex="21"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Classes="flyout"
                                        IsVisible="{Binding IsGroupEditorVisible}">
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,10,20,10" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingExistingGroup}"
                                                        Text="{DynamicResource EditGroup}" />
                                                    <TextBlock
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsCreatingGroup}"
                                                        Text="{DynamicResource CreateGroup}" />
                                                    <TextBlock
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingFavorites}"
                                                        Text="{DynamicResource EditFavorites}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        MinHeight="26"
                                                        Classes="icon"
                                                        Command="{Binding CancelGroupEditCommand}"
                                                        Content="✕" />
                                                </Grid>
                                                <StackPanel IsVisible="{Binding !IsEditingFavorites}" Orientation="Horizontal" Spacing="6">
                                                    <shared:SymbolIcon
                                                        Foreground="{Binding SelectedGroupColor.Brush}"
                                                        IconSize="27"
                                                        Kind="Folder" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="field-label"
                                                        Text="{DynamicResource GroupName}" />
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding IsEditingFavorites}" Orientation="Horizontal" Spacing="6">
                                                    <shared:SymbolIcon
                                                        Foreground="{Binding SelectedGroupColor.Brush}"
                                                        IconSize="27"
                                                        Kind="Favorite" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="field-label"
                                                        Text="{DynamicResource FavoriteAccounts}" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="GroupNameBox"
                                                    MaxLength="64"
                                                    automation:AutomationProperties.Name="{DynamicResource GroupName}"
                                                    IsVisible="{Binding !IsEditingFavorites}"
                                                    Text="{Binding GroupEditorName, Mode=TwoWay}" />
                                                <TextBlock Classes="field-label" Text="{DynamicResource GroupColor}" />
                                                <ListBox
                                                    Classes="group-color-picker"
                                                    MaxHeight="58"
                                                    Padding="4,0"
                                                    automation:AutomationProperties.Name="{DynamicResource GroupColor}"
                                                    ItemsSource="{Binding GroupColorOptions}"
                                                    SelectedItem="{Binding SelectedGroupColor, Mode=TwoWay}"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                    SelectionMode="Single">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="6" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:GroupColorOption">
                                                            <Border
                                                                Width="30"
                                                                Height="30"
                                                                Background="{Binding Brush}"
                                                                CornerRadius="15"
                                                                ToolTip.Tip="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Classes="field-label" Text="{DynamicResource GroupAccounts}" />
                                                <TextBox
                                                    x:Name="GroupAccountSearchBox"
                                                    automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                                    PlaceholderText="{DynamicResource SearchAccounts}"
                                                    Text="{Binding GroupEditorSearchText, Mode=TwoWay}" />
                                                <Border Classes="panel" Padding="4">
                                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Hidden">
                                                        <ItemsControl ItemsSource="{Binding GroupEditorAccounts}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="presentation:GroupAccountSelectionViewModel">
                                                                    <Grid
                                                                        Margin="4,3"
                                                                        ColumnDefinitions="Auto,Auto,*"
                                                                        ColumnSpacing="8">
                                                                        <CheckBox
                                                                            Grid.Column="0"
                                                                            VerticalAlignment="Center"
                                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                        <shared:BrandTile
                                                                            Grid.Column="1"
                                                                            IsVisible="{Binding ShowIssuerLogo}"
                                                                            IconData="{Binding Brand.IconData}"
                                                                            Initials="{Binding Brand.Initials}"
                                                                            TileBackground="{Binding Brand.BackgroundBrush}" />
                                                                        <StackPanel
                                                                            Grid.Column="2"
                                                                            VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Issuer}" />
                                                                            <TextBlock Classes="secondary" FontSize="11" Text="{Binding AccountName}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                                <shared:ValidationMessage Severity="Error" Text="{Binding GroupEditorMessage}" />
                                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="14,6"
                                                        Classes="primary"
                                                        Command="{Binding SaveGroupCommand}"
                                                        Content="{DynamicResource Save}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Padding="14,6"
                                                        Command="{Binding CancelGroupEditCommand}"
                                                        Content="{DynamicResource Cancel}" />
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <ScrollViewer
                        IsVisible="{Binding IsToolsVisible}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="14">
                            <TextBlock Classes="page-title" Text="{DynamicResource Tools}" />
                            <ContentControl Content="{Binding CameraScanner}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:CameraScannerViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ScanQrCamera}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="primary" Command="{Binding StartCommand}" Content="{DynamicResource ScanQrCamera}" />
                                                    <Button Command="{Binding CancelCommand}" Content="{DynamicResource CancelScan}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <Image
                                                    Width="280"
                                                    Height="210"
                                                    IsVisible="{Binding HasPreview}"
                                                    Source="{Binding PreviewImage}"
                                                    Stretch="Uniform" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <Border
                x:Name="AccountSortMenuDismissLayer"
                ZIndex="90"
                Background="Transparent"
                IsVisible="False"
                PointerPressed="CloseAccountSortMenu" />
            <Border
                x:Name="AccountSortMenu"
                ZIndex="91"
                Width="176"
                Margin="0,48,8,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushControlBorder}"
                BorderThickness="1"
                BoxShadow="{DynamicResource ElevationToast}"
                Classes="sort-menu"
                ClipToBounds="True"
                CornerRadius="8"
                IsVisible="False">
                <Border.Styles>
                    <Style Selector="Border.sort-menu">
                        <Style.Animations>
                            <Animation
                                Duration="0:0:0.16"
                                Easing="CubicEaseOut"
                                FillMode="Forward"
                                PlaybackBehavior="OnlyIfVisible">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="TranslateTransform.Y" Value="-6" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="TranslateTransform.Y" Value="0" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="Button.sort-option">
                        <Setter Property="MinHeight" Value="50" />
                        <Setter Property="Padding" Value="14,0,10,0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                    <Style Selector="Button.sort-option:pointerover">
                        <Setter Property="Background" Value="{DynamicResource BrushDesktopAccountItemBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlBorder}" />
                    </Style>
                    <Style Selector="Button.sort-option:pressed">
                        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
                    </Style>
                    <Style Selector="Button.sort-option.last">
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </Border.Styles>
                <StackPanel Spacing="0">
                    <Button
                        Classes="sort-option"
                        automation:AutomationProperties.Name="{DynamicResource SortByIssuer}"
                        Click="SelectIssuerSort">
                        <Grid ColumnDefinitions="*,28">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="{DynamicResource SortByIssuer}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                IsVisible="{Binding AccountList.IsIssuerSortSelected}"
                                Text="✓" />
                        </Grid>
                    </Button>
                    <Button
                        Classes="sort-option"
                        automation:AutomationProperties.Name="{DynamicResource SortByIssuerDescending}"
                        Click="SelectIssuerDescendingSort">
                        <Grid ColumnDefinitions="*,28">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="{DynamicResource SortByIssuerDescending}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                IsVisible="{Binding AccountList.IsIssuerDescendingSortSelected}"
                                Text="✓" />
                        </Grid>
                    </Button>
                    <Button
                        Classes="sort-option"
                        automation:AutomationProperties.Name="{DynamicResource SortByAccountName}"
                        Click="SelectAccountNameSort">
                        <Grid ColumnDefinitions="*,28">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="{DynamicResource SortByAccountName}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                IsVisible="{Binding AccountList.IsAccountNameSortSelected}"
                                Text="✓" />
                        </Grid>
                    </Button>
                    <Button
                        Classes="sort-option last"
                        automation:AutomationProperties.Name="{DynamicResource SortByAccountNameDescending}"
                        Click="SelectAccountNameDescendingSort">
                        <Grid ColumnDefinitions="*,28">
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="{DynamicResource SortByAccountNameDescending}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                IsVisible="{Binding AccountList.IsAccountNameDescendingSortSelected}"
                                Text="✓" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </shared:BusyOverlay>
    </Grid>
</Window>
