<Window
    x:Class="TOTP.Avalonia.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:localization="using:TOTP.Avalonia.Desktop.Localization"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="presentation:MainWindowViewModel"
    Title="{DynamicResource AppTitle}"
    Width="380"
    Height="540"
    MinWidth="360"
    MinHeight="200"
    CornerRadius="2"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    Icon="avares://TOTP.UI.Avalonia.Desktop/Assets/Icons/app.ico">

    <Border
        Background="{DynamicResource BrushWindowBackground}"
        ClipToBounds="True"
        CornerRadius="2">
        <Grid RowDefinitions="Auto,*">
            <controls:ProductTitleBar
                ShowMinimizeButton="True"
                Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            <shared:BusyOverlay
                Grid.Row="1"
                BusyMessage="{DynamicResource StartingSafely}"
                IsBusy="{Binding IsBusy}">
            <Grid Background="{DynamicResource BrushWindowBackground}">

            <!-- Locked and first-run presentation uses the compact authorization gate. -->
            <ScrollViewer
                Margin="20"
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding !IsShellVisible}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Image
                        Width="54"
                        Height="54"
                        HorizontalAlignment="Center"
                        Source="/Assets/Icons/app.ico" />
                    <TextBlock
                        automation:AutomationProperties.HeadingLevel="1"
                        Classes="app-title"
                        HorizontalAlignment="Center"
                        Text="{DynamicResource AppHeading}" />
                    <shared:NotificationBanner
                        Severity="{Binding Notification.Severity}"
                        Text="{Binding Notification.Text}" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding InitializeCommand}"
                        Content="{DynamicResource Retry}"
                        IsVisible="{Binding CanRetry}" />

                    <Border Classes="unlock-card" IsVisible="{Binding IsQuickUnlockVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="{DynamicResource QuickUnlock}" />
                            <TextBlock
                                Classes="secondary"
                                Text="{DynamicResource QuickUnlockRecoveryNotice}"
                                TextWrapping="Wrap" />
                            <shared:ValidationMessage
                                Severity="Error"
                                Text="{Binding QuickUnlockMessage}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsQuickUnlockBusy}" />
                            <Button
                                Classes="primary wide"
                                Command="{Binding QuickUnlockCommand}"
                                Content="{DynamicResource UnlockWithQuickUnlock}" />
                            <Button
                                Classes="link wide"
                                Command="{Binding UsePasswordFallbackCommand}"
                                Content="{DynamicResource UseMasterPassword}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordUnlockVisible}">
                        <ContentControl Content="{Binding PasswordUnlock}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:PasswordUnlockViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Classes="section-title"
                                            Text="{DynamicResource MasterPassword}" />
                                        <shared:ValidationMessage
                                            Severity="Error"
                                            Text="{Binding Message}" />
                                        <shared:RevealableSecretInput
                                            x:Name="PasswordUnlockInput"
                                            AccessibleName="{DynamicResource MasterPassword}"
                                            HelpText="{DynamicResource MasterPasswordHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource MasterPassword}"
                                            Text="{Binding Password, Mode=TwoWay}" />
                                        <Button
                                            Classes="primary wide"
                                            Command="{Binding UnlockCommand}"
                                            Content="{DynamicResource Unlock}"
                                            IsDefault="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>

                    <Border Classes="unlock-card" IsVisible="{Binding IsPasswordSetupVisible}">
                        <ContentControl Content="{Binding PasswordSetup}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="presentation:PasswordSetupViewModel">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Classes="section-title"
                                            Text="{DynamicResource CreatePasswordHeading}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Classes="secondary"
                                            Text="{DynamicResource PasswordSetupHelp}"
                                            TextWrapping="Wrap" />
                                        <shared:RevealableSecretInput
                                            x:Name="PasswordSetupInput"
                                            AccessibleName="{DynamicResource NewPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource NewPassword}"
                                            Text="{Binding Password, Mode=TwoWay}" />
                                        <shared:RevealableSecretInput
                                            AccessibleName="{DynamicResource ConfirmPassword}"
                                            HelpText="{DynamicResource PasswordSetupHelp}"
                                            IsRequired="True"
                                            PlaceholderText="{DynamicResource ConfirmPassword}"
                                            Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                                        <shared:ValidationMessage Severity="Error" Text="{Binding Message}" />
                                        <Button
                                            Classes="primary wide"
                                            Command="{Binding ConfigureCommand}"
                                            Content="{DynamicResource CreateVault}"
                                            IsDefault="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Authorized shell uses the compact toolbar/list/code hierarchy. -->
            <Grid
                x:Name="AuthorizedShell"
                RowDefinitions="Auto,*"
                IsVisible="{Binding IsShellVisible}">
                <Border
                    x:Name="MainToolbar"
                    Grid.Row="0"
                    Classes="toolbar"
                    IsEnabled="{Binding !IsSettingsVisible}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,64,Auto,Auto">
                        <Button
                            x:Name="ScanQrButton"
                            Grid.Column="0"
                            automation:AutomationProperties.Name="{DynamicResource QrScannerSupportedFormats}"
                            Classes="icon"
                            Command="{Binding ScanQrCommand}"
                            ToolTip.Tip="{DynamicResource QrScannerSupportedFormats}">
                            <shared:SymbolIcon Foreground="#E16C6C" IconSize="16" Kind="Camera" />
                        </Button>
                        <Button
                            x:Name="AddAccountButton"
                            Grid.Column="1"
                            automation:AutomationProperties.Name="{DynamicResource AddAccount}"
                            Classes="icon"
                            Command="{Binding BeginAddAccountCommand}"
                            ToolTip.Tip="{DynamicResource AddAccountShortcut}">
                            <shared:SymbolIcon Foreground="#87CE3E" IconSize="16" Kind="Add" />
                        </Button>
                        <Button
                            x:Name="ManageGroupsButton"
                            Grid.Column="2"
                            automation:AutomationProperties.Name="{DynamicResource CreateGroup}"
                            Classes="icon"
                            Command="{Binding AccountList.BeginAddGroupCommand}"
                            ToolTip.Tip="{DynamicResource ManageGroups}">
                            <shared:SymbolIcon Foreground="#4F6BED" IconSize="16" Kind="FolderAdd" />
                        </Button>
                        <Button
                            x:Name="ToggleSearchButton"
                            Grid.Column="3"
                            automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                            Classes="icon"
                            Click="FocusAccountSearch"
                            Command="{Binding ToggleSearchCommand}"
                            ToolTip.Tip="{DynamicResource SearchAccountsShortcut}">
                            <shared:SymbolIcon Foreground="#87CE3E" IconSize="16" Kind="Search" />
                        </Button>
                        <Grid
                            x:Name="AccountSearchHost"
                            Grid.Column="4"
                            Margin="4,0"
                            ColumnDefinitions="*,Auto"
                            IsVisible="{Binding IsSearchVisible}">
                            <TextBox
                                x:Name="AccountSearchBox"
                                Grid.ColumnSpan="2"
                                MinWidth="72"
                                MinHeight="28"
                                Padding="7,2,22,2"
                                automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                Classes="search"
                                PlaceholderText="{DynamicResource SearchAccounts}"
                                Text="{Binding AccountList.SearchText, Mode=TwoWay}" />
                            <Button
                                x:Name="ClearSearchButton"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                Margin="0,0,2,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{DynamicResource ClearSearch}"
                                Classes="link"
                                Click="RefocusAccountSearchAfterClear"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                IsVisible="{Binding AccountList.HasSearchText}" />
                        </Grid>
                        <ComboBox
                            x:Name="LanguageSelector"
                            Grid.Column="5"
                            Width="64"
                            MinHeight="28"
                            Padding="2"
                            HorizontalContentAlignment="Center"
                            automation:AutomationProperties.Name="{DynamicResource Language}"
                            ItemsSource="{Binding SettingsPage.Languages}"
                            SelectedItem="{Binding SettingsPage.SelectedLanguage, Mode=TwoWay}"
                            ToolTip.Tip="{DynamicResource Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="localization:LanguageOption">
                                    <Image
                                        Width="24"
                                        Height="18"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Center"
                                        Source="{Binding Icon}"
                                        Stretch="Uniform"
                                        ToolTip.Tip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            x:Name="OpenSettingsButton"
                            Grid.Column="6"
                            automation:AutomationProperties.Name="{DynamicResource Settings}"
                            Classes="icon"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="{DynamicResource Settings}">
                            <shared:SymbolIcon Foreground="#787373" IconSize="16" Kind="Settings" />
                        </Button>
                        <Button
                            x:Name="LockButton"
                            Grid.Column="7"
                            automation:AutomationProperties.Name="{DynamicResource Lock}"
                            Classes="icon"
                            Command="{Binding LockCommand}"
                            ToolTip.Tip="{DynamicResource LockShortcut}">
                            <shared:SymbolIcon IconSize="16" Kind="Lock" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl
                        x:Name="AccountListPage"
                        Content="{Binding AccountList}"
                        IsVisible="{Binding IsAccountListVisible}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="presentation:AccountListViewModel">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="AccountPageScrollViewer"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel
                                            x:Name="AccountPageContent"
                                            Margin="10,8,10,12"
                                            VerticalAlignment="Top"
                                            Spacing="8">
                                            <StackPanel IsVisible="{Binding HasGroups}" Spacing="6">
                                                <Grid ColumnDefinitions="10,*">
                                                    <Button
                                                        x:Name="GroupBackButton"
                                                        Grid.Column="0"
                                                        Height="54"
                                                        HorizontalAlignment="Left"
                                                        Margin="-10,0,0,0"
                                                        Padding="3,5"
                                                        VerticalAlignment="Center"
                                                        Width="20"
                                                        automation:AutomationProperties.Name="{DynamicResource AllAccounts}"
                                                        Classes="icon"
                                                        Command="{Binding ClearGroupFilterCommand}"
                                                        IsVisible="{Binding HasSelectedGroup}"
                                                        ToolTip.Tip="{DynamicResource AllAccounts}">
                                                        <shared:SymbolIcon IconSize="14" Kind="ArrowLeft" />
                                                    </Button>
                                                    <ScrollViewer
                                                        x:Name="GroupCardsScrollViewer"
                                                        Grid.Column="1"
                                                        MaxHeight="72"
                                                        HorizontalScrollBarVisibility="Hidden"
                                                        PointerWheelChanged="ScrollGroupsHorizontally"
                                                        VerticalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Groups}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="presentation:AccountGroupListItemViewModel">
                                                                    <Border
                                                                        Width="150"
                                                                        MinHeight="54"
                                                                        Margin="2"
                                                                        Background="{Binding Background}"
                                                                        Classes="group-card"
                                                                        Classes.selected="{Binding IsSelected}"
                                                                        CornerRadius="7">
                                                                        <Border.ContextMenu>
                                                                            <ContextMenu Classes="account-context-menu">
                                                                                <MenuItem Command="{Binding EditCommand}" Header="{DynamicResource EditGroup}">
                                                                                    <MenuItem.Icon>
                                                                                        <shared:SymbolIcon IconSize="15" Kind="Edit" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Classes="danger-context-item"
                                                                                    Command="{Binding DeleteCommand}"
                                                                                    Header="{DynamicResource DeleteGroup}">
                                                                                    <MenuItem.Icon>
                                                                                        <shared:SymbolIcon IconSize="15" Kind="Delete" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                                                        <Button
                                                                            Classes="group-card-hit-target"
                                                                            Command="{Binding SelectCommand}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                                <shared:SymbolIcon
                                                                                    Foreground="{Binding Foreground}"
                                                                                    IconSize="20"
                                                                                    Kind="Folder" />
                                                                                <StackPanel>
                                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                                    <TextBlock FontSize="11" Text="{Binding AccountCount}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Classes="secondary"
                                                FontSize="11"
                                                IsVisible="{Binding HasActiveAccountFilter}"
                                                Text="{Binding SearchResultSummary}" />
                                            <Grid x:Name="AccountListRegion">
                                                <controls:ContextPreservingAccountListBox
                                                    x:Name="AccountsListBox"
                                                    automation:AutomationProperties.Name="{DynamicResource AccountsList}"
                                                    Classes="accounts desktop-accounts"
                                                    ContextAccount="{Binding ContextAccount, Mode=TwoWay}"
                                                    ItemsSource="{Binding Accounts}"
                                                    SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ContextMenu>
                                                        <ContextMenu Classes="account-context-menu">
                                                            <MenuItem Command="{Binding BeginContextEditCommand}" Header="{DynamicResource EditAccountShortcut}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="Edit" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Command="{Binding GenerateContextQrCommand}" Header="{DynamicResource ShowQrCode}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="QrCode" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Margin="6,4" />
                                                            <MenuItem
                                                                Classes="danger-context-item"
                                                                Command="{Binding DeleteContextAccountCommand}"
                                                                Header="{DynamicResource DeleteAccountShortcut}">
                                                                <MenuItem.Icon>
                                                                    <shared:SymbolIcon IconSize="15" Kind="Delete" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </ListBox.ContextMenu>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:AccountListItemViewModel">
                                                            <Border
                                                                Classes="account-row-container"
                                                                Classes.recently-added="{Binding IsRecentlyAdded}">
                                                                    <Grid
                                                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                                                        RowDefinitions="Auto,Auto"
                                                                        ColumnSpacing="6">
                                                                    <shared:BrandTile
                                                                        Grid.Row="0"
                                                                        Grid.RowSpan="2"
                                                                        Grid.Column="0"
                                                                        IsVisible="{Binding ShowIssuerLogo}"
                                                                        Margin="0,0,6,0"
                                                                        IconData="{Binding Brand.IconData}"
                                                                        Initials="{Binding Brand.Initials}"
                                                                        TileBackground="{Binding Brand.BackgroundBrush}" />
                                                                    <shared:AccountRow
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        AccountName="{Binding AccountName}"
                                                                        Issuer="{Binding Issuer}" />
                                                                    <Button
                                                                        automation:AutomationProperties.Name="{DynamicResource CopyTimedClear}"
                                                                        Grid.Row="0"
                                                                        Grid.Column="3"
                                                                        Classes="row-code"
                                                                        Command="{Binding CopyCodeCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding HasCode}"
                                                                        ToolTip.Tip="{DynamicResource CopyTimedClearShortcut}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <shared:SymbolIcon IconSize="10" Kind="Copy" />
                                                                            <TextBlock Text="{Binding DisplayCode}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock
                                                                        Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource BrushSuccess}"
                                                                        IsVisible="{Binding HasCopyConfirmation}"
                                                                        Text="{Binding CopyConfirmation}" />
                                                                    <TextBlock
                                                                        Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Classes="secondary"
                                                                        IsVisible="{Binding !HasCopyConfirmation}"
                                                                        Text="{Binding CustomPeriodLabel}" />
                                                                    <ProgressBar
                                                                        Grid.Row="1"
                                                                        Grid.Column="1"
                                                                        Grid.ColumnSpan="3"
                                                                        Classes="account-countdown"
                                                                        Classes.expiring="{Binding IsExpiring}"
                                                                        IsHitTestVisible="False"
                                                                        IsVisible="{Binding HasCode}"
                                                                        Margin="0,3,0,0"
                                                                        Maximum="{Binding PeriodSeconds}"
                                                                        Minimum="0"
                                                                        Value="{Binding RemainingSeconds}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </controls:ContextPreservingAccountListBox>
                                                <TextBlock
                                                    Margin="0,28"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    IsHitTestVisible="False"
                                                    IsVisible="{Binding HasNoAccounts}"
                                                    Text="{DynamicResource NoEntriesYet}" />
                                                <TextBlock
                                                    Margin="0,28"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    IsHitTestVisible="False"
                                                    IsVisible="{Binding HasNoSearchResults}"
                                                    Text="{DynamicResource NoMatchingEntries}" />
                                            </Grid>

                                            <TextBlock
                                                Classes="inline-message"
                                                IsVisible="{Binding HasCodeMessage}"
                                                Text="{Binding CodeMessage}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <shared:NotificationBanner
                                        x:Name="AccountMessageToast"
                                        ZIndex="10"
                                        Margin="20"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        Severity="{Binding Notification.Severity}"
                                        Text="{Binding Notification.Text}" />

                                    <Border
                                        x:Name="AccountEditorFlyout"
                                        ZIndex="20"
                                        Margin="0"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Classes="flyout"
                                        IsEnabled="False"
                                        IsHitTestVisible="False"
                                        IsVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="380" />
                                        </Border.RenderTransform>
                                        <ScrollViewer
                                            x:Name="AccountEditorScrollViewer"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel
                                                x:Name="AccountEditorContent"
                                                Margin="0,10,20,10"
                                                Spacing="0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingExistingAccount}"
                                                        Text="{DynamicResource EditAccount}" />
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Classes="section-title"
                                                        IsVisible="{Binding !IsEditingExistingAccount}"
                                                        Text="{DynamicResource AddAccount}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        MinHeight="26"
                                                        Classes="icon"
                                                        Command="{Binding CancelEditCommand}"
                                                        Content="✕" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,6,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource Issuer}" />
                                                <TextBox
                                                    x:Name="AccountIssuerBox"
                                                    automation:AutomationProperties.Name="{DynamicResource Issuer}"
                                                    Text="{Binding EditorIssuer, Mode=TwoWay}" />
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorIssuerMessage}" />
                                                <TextBlock
                                                    Margin="0,10,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource Secret}" />
                                                <shared:RevealableSecretInput
                                                    AccessibleName="{DynamicResource Secret}"
                                                    HelpText="{DynamicResource AccountSecretInvalid}"
                                                    IsRequired="True"
                                                    Text="{Binding EditorSecret, Mode=TwoWay}" />
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorSecretMessage}" />
                                                <TextBlock
                                                    Margin="0,10,0,6"
                                                    Classes="field-label"
                                                    Text="{DynamicResource AccountName}" />
                                                <TextBox
                                                    automation:AutomationProperties.Name="{DynamicResource AccountName}"
                                                    Text="{Binding EditorAccountName, Mode=TwoWay}" />
                                                <StackPanel
                                                    Margin="0,10,0,0"
                                                    Spacing="6">
                                                    <TextBlock
                                                        Classes="field-label"
                                                        Text="{DynamicResource BrandIcon}" />
                                                    <controls:TypeAheadComboBox
                                                        x:Name="AccountBrandIconComboBox"
                                                        automation:AutomationProperties.Name="{DynamicResource BrandIcon}"
                                                        IsEnabled="{Binding HasBrandIconChoices}"
                                                        ItemsSource="{Binding EditorBrandIconOptions}"
                                                        SelectedItem="{Binding SelectedEditorBrandIconOption, Mode=TwoWay}">
                                                        <controls:TypeAheadComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="presentation:BrandIconOption">
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </controls:TypeAheadComboBox.ItemTemplate>
                                                    </controls:TypeAheadComboBox>
                                                    <TextBlock
                                                        Classes="secondary"
                                                        Text="{DynamicResource BrandIconHelp}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Expander
                                                    x:Name="AccountAdvancedOptions"
                                                    Margin="0,10,0,0"
                                                    Header="{DynamicResource AdvancedOptions}"
                                                    IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock
                                                            Classes="field-label"
                                                            Text="{DynamicResource TotpPeriod}" />
                                                        <NumericUpDown
                                                            automation:AutomationProperties.Name="{DynamicResource TotpPeriod}"
                                                            Increment="5"
                                                            Maximum="3600"
                                                            Minimum="5"
                                                            Value="{Binding EditorPeriodSeconds, Mode=TwoWay}">
                                                            <NumericUpDown.InnerRightContent>
                                                                <Button
                                                                    automation:AutomationProperties.Name="{DynamicResource ClearPeriod}"
                                                                    Classes="numeric-clear"
                                                                    Click="RefocusAccountPeriodAfterClear"
                                                                    Command="{Binding ClearEditorPeriodCommand}"
                                                                    Content="×"
                                                                    IsVisible="{Binding HasEditorPeriodSeconds}"
                                                                    ToolTip.Tip="{DynamicResource ClearPeriod}" />
                                                            </NumericUpDown.InnerRightContent>
                                                        </NumericUpDown>
                                                        <shared:ValidationMessage Severity="Error" Text="{Binding EditorPeriodMessage}" />
                                                        <TextBlock
                                                            Classes="secondary"
                                                            Text="{DynamicResource TotpPeriodHelp}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Expander>
                                                <shared:ValidationMessage Severity="Error" Text="{Binding EditorMessage}" />
                                                <StackPanel
                                                    Margin="0,16,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button Padding="14,6" Classes="primary" Command="{Binding SaveAccountCommand}" Content="{DynamicResource SaveAccount}" />
                                                    <Button Padding="14,6" Command="{Binding CancelEditCommand}" Content="{DynamicResource CancelEdit}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <Border
                                        x:Name="GroupEditorFlyout"
                                        ZIndex="21"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Classes="flyout"
                                        IsVisible="{Binding IsGroupEditorVisible}">
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,10,20,10" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Classes="section-title"
                                                        IsVisible="{Binding IsEditingExistingGroup}"
                                                        Text="{DynamicResource EditGroup}" />
                                                    <TextBlock
                                                        Classes="section-title"
                                                        IsVisible="{Binding !IsEditingExistingGroup}"
                                                        Text="{DynamicResource CreateGroup}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        MinHeight="26"
                                                        Classes="icon"
                                                        Command="{Binding CancelGroupEditCommand}"
                                                        Content="✕" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <shared:SymbolIcon
                                                        Foreground="{Binding SelectedGroupColor.Brush}"
                                                        IconSize="27"
                                                        Kind="Folder" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="field-label"
                                                        Text="{DynamicResource GroupName}" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="GroupNameBox"
                                                    MaxLength="64"
                                                    automation:AutomationProperties.Name="{DynamicResource GroupName}"
                                                    Text="{Binding GroupEditorName, Mode=TwoWay}" />
                                                <TextBlock Classes="field-label" Text="{DynamicResource GroupColor}" />
                                                <ListBox
                                                    Classes="group-color-picker"
                                                    MaxHeight="58"
                                                    Padding="4,0"
                                                    automation:AutomationProperties.Name="{DynamicResource GroupColor}"
                                                    ItemsSource="{Binding GroupColorOptions}"
                                                    SelectedItem="{Binding SelectedGroupColor, Mode=TwoWay}"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                    SelectionMode="Single">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="6" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:GroupColorOption">
                                                            <Border
                                                                Width="30"
                                                                Height="30"
                                                                Background="{Binding Brush}"
                                                                CornerRadius="15"
                                                                ToolTip.Tip="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Classes="field-label" Text="{DynamicResource GroupAccounts}" />
                                                <TextBox
                                                    x:Name="GroupAccountSearchBox"
                                                    automation:AutomationProperties.Name="{DynamicResource SearchAccounts}"
                                                    PlaceholderText="{DynamicResource SearchAccounts}"
                                                    Text="{Binding GroupEditorSearchText, Mode=TwoWay}" />
                                                <Border Classes="panel" Padding="4">
                                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Hidden">
                                                        <ItemsControl ItemsSource="{Binding GroupEditorAccounts}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="presentation:GroupAccountSelectionViewModel">
                                                                    <Grid
                                                                        Margin="4,3"
                                                                        ColumnDefinitions="Auto,Auto,*"
                                                                        ColumnSpacing="8">
                                                                        <CheckBox
                                                                            Grid.Column="0"
                                                                            VerticalAlignment="Center"
                                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                        <shared:BrandTile
                                                                            Grid.Column="1"
                                                                            IsVisible="{Binding ShowIssuerLogo}"
                                                                            IconData="{Binding Brand.IconData}"
                                                                            Initials="{Binding Brand.Initials}"
                                                                            TileBackground="{Binding Brand.BackgroundBrush}" />
                                                                        <StackPanel
                                                                            Grid.Column="2"
                                                                            VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Issuer}" />
                                                                            <TextBlock Classes="secondary" FontSize="11" Text="{Binding AccountName}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                                <shared:ValidationMessage Severity="Error" Text="{Binding GroupEditorMessage}" />
                                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="14,6"
                                                        Classes="primary"
                                                        Command="{Binding SaveGroupCommand}"
                                                        Content="{DynamicResource Save}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Padding="14,6"
                                                        Command="{Binding CancelGroupEditCommand}"
                                                        Content="{DynamicResource Cancel}" />
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <ScrollViewer
                        IsVisible="{Binding IsToolsVisible}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="14">
                            <TextBlock Classes="page-title" Text="{DynamicResource Tools}" />
                            <ContentControl Content="{Binding CameraScanner}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="presentation:CameraScannerViewModel">
                                        <Border Classes="panel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="section-title" Text="{DynamicResource ScanQrCamera}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="primary" Command="{Binding StartCommand}" Content="{DynamicResource ScanQrCamera}" />
                                                    <Button Command="{Binding CancelCommand}" Content="{DynamicResource CancelScan}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <Image
                                                    Width="280"
                                                    Height="210"
                                                    IsVisible="{Binding HasPreview}"
                                                    Source="{Binding PreviewImage}"
                                                    Stretch="Uniform" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
            </Grid>
            </shared:BusyOverlay>
        </Grid>
    </Border>
</Window>
