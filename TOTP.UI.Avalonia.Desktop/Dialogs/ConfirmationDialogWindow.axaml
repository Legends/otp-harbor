<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.ConfirmationDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    x:DataType="dialogs:ConfirmationDialogViewModel"
    Background="{DynamicResource BrushDialogSurface}"
    CanResize="False"
    Classes="dialog"
    Classes.destructive="{Binding IsDestructive}"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="520"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource AppTitle}">
    <StackPanel Classes="dialog-content" Spacing="16">
        <TextBlock
            Classes="heading"
            Text="{Binding Title}"
            TextWrapping="Wrap" />
        <Border
            x:Name="DialogMessageCard"
            Classes="dialog-message-card">
            <TextBlock Text="{Binding Message}" />
        </Border>
        <StackPanel
            Classes="dialog-actions">
            <Button
                Classes="secondary"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}"
                IsCancel="True"
                IsVisible="{Binding ShowCancel}" />
            <Button
                Classes.danger="{Binding IsDestructive}"
                Classes.primary="{Binding !IsDestructive}"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
