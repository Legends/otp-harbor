<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.ConfirmationDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:TOTP.Avalonia.Desktop.Presentation.Dialogs"
    xmlns:shared="using:TOTP.Avalonia.Shared.Controls"
    x:DataType="dialogs:ConfirmationDialogViewModel"
    Background="{DynamicResource BrushDialogSurface}"
    CanResize="False"
    Classes="dialog"
    Classes.destructive="{Binding IsDestructive}"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource AppTitle}">
    <Window.Styles>
        <Style Selector="Window.dialog.destructive">
            <Setter Property="Width" Value="320" />
            <Setter Property="MinWidth" Value="300" />
        </Style>
    </Window.Styles>
    <StackPanel Classes="dialog-content" Spacing="16">
        <TextBlock
            Classes="heading"
            Text="{Binding Title}"
            TextWrapping="Wrap" />
        <shared:NotificationBanner
            Severity="{Binding Severity}"
            Text="{Binding Message}" />
        <StackPanel
            Classes="dialog-actions">
                <Button
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    Content="{Binding CancelText}"
                    IsCancel="True"
                    IsVisible="{Binding ShowCancel}" />
            <Button
                Classes.danger="{Binding IsDestructive}"
                Classes.primary="{Binding !IsDestructive}"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
