<Window
    x:Class="TOTP.Avalonia.Desktop.Dialogs.CameraScannerDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TOTP.Avalonia.Desktop.Controls"
    xmlns:presentation="using:TOTP.Avalonia.Desktop.Presentation"
    x:DataType="presentation:CameraScannerViewModel"
    Width="560"
    Height="420"
    MinWidth="420"
    MinHeight="320"
    CanResize="True"
    ShowInTaskbar="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource ImportQrCode}">
    <Grid RowDefinitions="Auto,*">
        <controls:ProductTitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Grid Grid.Row="1" Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock
                Classes="page-title"
                Text="{DynamicResource ImportQrCode}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,4,0,0"
                Classes="secondary"
                Text="{DynamicResource QrScannerSupportedFormats}"
                TextWrapping="Wrap" />
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image
                    automation:AutomationProperties.Name="{DynamicResource CameraPreview}"
                    IsVisible="{Binding HasPreview}"
                    Source="{Binding PreviewImage}"
                    Stretch="Uniform" />
                <ProgressBar
                    Width="180"
                    Height="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsWaitingForPreview}" />
            </Grid>
        </Border>
            <StackPanel
                Grid.Row="3"
                Margin="0,8,0,0"
                Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="secondary"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Row="4"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="100"
                    Command="{Binding StartCommand}"
                    Content="{DynamicResource Retry}"
                    IsVisible="{Binding !IsScanning}" />
                <Button
                    MinWidth="120"
                    Command="{Binding OpenImageCommand}"
                    Content="{DynamicResource OpenQrImage}" />
                <Button
                    MinWidth="100"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource CancelScan}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
